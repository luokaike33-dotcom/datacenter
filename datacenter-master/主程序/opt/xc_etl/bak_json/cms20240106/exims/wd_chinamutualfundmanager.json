									"ann_date",
									"f_info_fundmanager",
									"f_info_manager_gender",
									"f_info_manager_birthyear",
									"f_info_manager_education",
									"f_info_manager_nationality",
									"f_info_manager_startdate",
									"f_info_manager_leavedate",
									"f_info_manager_resume",
									"f_info_fundmanager_id",
									"s_info_manager_post",
									"f_info_escrow_fundmanager",
									"f_info_escrow_startdate",
									"f_info_escrow_leavedate",
									"f_info_dis_serial_number",
									"opdate",
									"opmode"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_chinamutualfundmanager"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from wd_chinamutualfundmanager"]
