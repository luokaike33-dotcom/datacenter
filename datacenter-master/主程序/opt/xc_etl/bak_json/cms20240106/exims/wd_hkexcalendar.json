{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/w_hkexcalendar",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"trade_days",
									"s_info_exchmarket"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_hkexcalendar"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from wd_hkexcalendar"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


