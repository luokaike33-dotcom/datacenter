									"modedatacreatertype",
									"modedatacreatedate",
									"modedatacreatetime",
									"insert_date",
									"bath_dt",
									"data_ins_time",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["oa_uf_one2one_deposit"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
