{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/rpt_rm_holding_depo/p_dt=${p_dt}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"long"},
									{"index":7,"type":"long"},
									{"index":8,"type":"double"},
									{"index":9,"type":"double"},
									{"index":10,"type":"double"},
									{"index":11,"type":"string"},
									{"index":12,"type":"string"},
									{"index":13,"type":"double"},
									{"index":14,"type":"long"},
									{"index":15,"type":"double"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"long"},
									{"index":19,"type":"string"},
									{"index":20,"type":"string"},
									{"index":21,"type":"string"},
									{"index":22,"type":"double"},
									{"index":23,"type":"date"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"sk_date",
									"sk_portfolio",
									"portfolio_name",
									"dk_iss_type",
									"vc_bank_name",
									"status",
									"l_begin_date",
									"due_date",
									"en_balance",
									"port_nav_assets",
									"val_pct",
									"is_kzq",
									"is_ltsx",
									"weight",
									"residual_maturity",
									"total_assets",
									"is_commercialbank",
									"org_property",
									"l_issuer_id",
									"zt_inside_appraise",
									"zt_outer_appraise",
									"zt_outer_appraise1",
									"en_issuer_asset",
									"etl_date"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["rpt_rm_holding_depo"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from rpt_rm_holding_depo where sk_date ='${p_dt}'"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


