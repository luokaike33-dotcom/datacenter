{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/rx_tbankinfo",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"long"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"long"},
									{"index":5,"type":"long"},
									{"index":6,"type":"long"},
									{"index":7,"type":"double"},
									{"index":8,"type":"double"},
									{"index":9,"type":"string"},
									{"index":10,"type":"double"},
									{"index":11,"type":"long"},
									{"index":12,"type":"long"},
									{"index":13,"type":"long"},
									{"index":14,"type":"string"},
									{"index":15,"type":"string"},
									{"index":16,"type":"double"},
									{"index":17,"type":"string"},
									{"index":18,"type":"date"},
									{"index":19,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"bank_id",
									"issuer_id",
									"bank_code",
									"bank_name",
									"country_code",
									"fund_trust_right",
									"bank_type",
									"pre_year_capital",
									"capital_adequacy",
									"zzd_bank_code",
									"core_capital_adequacy",
									"bank_type_2",
									"bank_grade",
									"external_bank_id",
									"remark",
									"quarter_advise",
									"last_year_total_value",
									"bath_dt",
									"data_ins_time",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["rx_tbankinfo"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from ${tgroradbname}.rx_tbankinfo"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


