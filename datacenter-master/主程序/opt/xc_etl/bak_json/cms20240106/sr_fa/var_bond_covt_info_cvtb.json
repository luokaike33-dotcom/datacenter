{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_bond_covt_info_cvtb",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"long"},
									{"index":5,"type":"long"},
									{"index":6,"type":"double"},
									{"index":7,"type":"long"},
									{"index":8,"type":"string"},
									{"index":9,"type":"long"},
									{"index":10,"type":"double"},
									{"index":11,"type":"double"},
									{"index":12,"type":"string"},
									{"index":13,"type":"string"},
									{"index":14,"type":"long"},
									{"index":15,"type":"string"},
									{"name":"dm_created_time","type":"string","value":"${kerberosPrincipal}"}
									{"value":"","type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "starrockswriter",
                    "parameter": {
                        "column": [
									"secu_id",
									"cnv_code",
									"cnv_secu_id",
									"cnv_sht",
									"cnv_bgn_dt",
									"cnv_end_dt",
									"tran_stk_prc",
									"cnv_stop_dt",
									"curr_code",
									"forc_cnv_dt",
									"forc_cnv_prc",
									"rel_cnv_m",
									"is_forc",
									"forc_cnv_rsn",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:mysql://${tgrurl}/",
                                "selectedDatabase": "${selectedDatabase}", 
                                "table": ["var_bond_covt_info_cvtb"]
                                    }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "loadUrl": [${loadUrl}],
						"loadProps": {"column_separator": "\\x01","row_delimiter":"\\x02"},
                        "preSql":["truncate table data_mart.var_bond_covt_info_cvtb"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


