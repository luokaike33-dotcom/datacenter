{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_sale_prd_nav_info/p_dt=${p_dt}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"long"},
									{"index":2,"type":"double"},
									{"index":3,"type":"double"},
									{"index":4,"type":"double"},
									{"index":5,"type":"double"},
									{"index":6,"type":"double"},
									{"index":7,"type":"double"},
									{"index":8,"type":"double"},
									{"index":9,"type":"double"},
									{"index":10,"type":"double"},
									{"index":11,"type":"double"},
									{"index":12,"type":"double"},
									{"index":13,"type":"double"},
									{"index":14,"type":"double"},
									{"index":15,"type":"double"},
									{"index":16,"type":"double"},
									{"index":17,"type":"long"},
									{"index":18,"type":"string"},
									{"name":"dm_created_time","type":"string","value":"${kerberosPrincipal}"},
									{"index":20,"type":"string"},
					                {"name":"p_dt","type":"long","value":"${p_dt}"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "starrockswriter",
                    "parameter": {
                        "column": [
									"sale_prd_code",
									"nav_dt",
									"ttl_navl",
									"ttl_shr",
									"unit_nval",
									"aggr_unit_nval",
									"nav_add_rat",
									"aggr_nav_add_rat",
									"unit_yld",
									"ann_yld_rat",
									"ttl_ast",
									"ttl_liab",
									"paid_capi",
									"f_savc",
									"f_maty",
									"f_eval_dvat_val",
									"f_eval_dvat_rat",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"dm_src_info",
									"p_dt"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:mysql://${tgrurl}/",
                                "selectedDatabase": "${selectedDatabase}", 
                                "table": ["var_sale_prd_nav_info"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "loadUrl":[${loadUrl}],
                        "preSql":["delete from  data_mart.var_sale_prd_nav_info where p_dt=${p_dt}"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


