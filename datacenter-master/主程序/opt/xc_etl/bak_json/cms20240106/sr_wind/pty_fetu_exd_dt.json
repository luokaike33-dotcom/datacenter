{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/pty_fetu_exd_dt",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"string"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"string"},
                                    {"index":5,"type":"string"},
                                    {"index":6,"type":"DOUBLE"},
                                    {"index":7,"type":"DOUBLE"},
                                    {"index":8,"type":"DOUBLE"},
                                    {"index":9,"type":"DOUBLE"},
                                    {"index":10,"type":"string"},
									{"name":"dm_created_time","type":"string","value":"${kerberosPrincipal}"}
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "starrockswriter",
                    "parameter": {
                        "column": [
                                    "com_id",
                                    "clas_code",
                                    "last_dim_code",
                                    "last_dim_name",
                                    "curr_dimcode",
                                    "curr_dimname",
                                    "curr_grad",
                                    "bgn_dt",
                                    "invl_dt",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:mysql://${tgrurl}",
                              "selectedDatabase": "${selectedDatabase}",
                              "table": ["pty_fetu_exd_dt"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "loadUrl": [${loadUrl}],
                        "loadProps": {"column_separator": "\\x01","row_separator":"\\x02"},
                        "preSql":["truncate table data_mart.pty_fetu_exd_dt "]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
