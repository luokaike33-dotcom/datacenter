{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/pty_info",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"long"},
									{"index":8,"type":"double"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"string"},
									{"index":12,"type":"string"},
									{"index":13,"type":"string"},
									{"index":14,"type":"string"},
									{"index":15,"type":"string"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"string"},
									{"index":19,"type":"string"},
									{"index":20,"type":"string"},
									{"index":21,"type":"string"},
									{"index":22,"type":"string"},
									{"index":23,"type":"string"},
									{"index":24,"type":"date"},
									{"index":25,"type":"string"},
									{"index":26,"type":"string"},
									{"index":27,"type":"string"},
									{"index":28,"type":"string"},
									{"index":29,"type":"string"},
									{"index":30,"type":"string"},
									{"index":31,"type":"string"},
									{"index":32,"type":"long"},
									{"index":33,"type":"string"},
									{"name":"dm_created_time","type":"string","value":"${kerberosPrincipal}"},
									{"index":35,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}"
                    }
                },
                "writer": {
                    "name": "starrockswriter",
                    "parameter": {
                        "column": [
									"com_id",
									"com_name",
									"chi_sht",
									"eng_name",
									"eng_sht",
									"natr_biz",
									"natr_econ",
									"found_dt",
									"reg_cptl",
									"lgl_repr",
									"reg_addr",
									"ctry_code",
									"ctry_name",
									"reg_prov",
									"reg_city",
									"reg_cnty",
									"ofs_addr",
									"posc",
									"tel",
									"fax",
									"email",
									"web_site",
									"reg_num_biz",
									"is_exist",
									"canl_dt",
									"org_code",
									"is_inno_com",
									"biz_sco",
									"is_list",
									"bk_desc",
									"gen_mngr",
									"is_bach_ins",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:mysql://${tgrurl}/",
                                "selectedDatabase": "${selectedDatabase}", 
                                "table": ["pty_info"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "loadUrl":[${loadUrl}],
                        "preSql":["truncate table data_mart.pty_info"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


