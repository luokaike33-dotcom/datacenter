{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_bond_intp_pay",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"DOUBLE"},
                                    {"index":2,"type":"DOUBLE"},
                                    {"index":3,"type":"long"},
                                    {"index":4,"type":"DOUBLE"},
                                    {"index":5,"type":"DOUBLE"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"string"},
                                    {"index":8,"type":"double"},
                                    {"index":9,"type":"double"},
                                    {"index":10,"type":"double"},
                                    {"index":11,"type":"double"},
                                    {"index":12,"type":"string"},
                                    {"index":13,"type":"double"},
                                    {"index":14,"type":"DOUBLE"},
                                    {"index":15,"type":"string"},
									{"name":"dm_created_time","type":"string","value":"${kerberosPrincipal}"}
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "starrockswriter",
                    "parameter": {
                        "column": [
                                    "secu_id",
                                    "pub_dt",
                                    "reg_dt",
                                    "ex_dvd_dt",
                                    "pay_bgn_dt",
                                    "cfps_dt",
                                    "redem_meth",
                                    "repayp_type",
                                    "prin_per",
                                    "int_per",
                                    "prin_int_per",
                                    "pnp_repymt_rat",
                                    "curr_code",
                                    "pre_value",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:mysql://${tgrurl}",
                              "selectedDatabase": "${selectedDatabase}",
                              "table": ["var_bond_intp_pay"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "loadUrl": [${loadUrl}],
                        "loadProps": {"column_separator": "\\x01","row_separator":"\\x02"},
                        "preSql":["truncate table data_mart.var_bond_intp_pay "]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
