{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_fund_ivsm_dtl",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"long"},
									{"index":4,"type":"long"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"double"},
									{"index":8,"type":"string"},
									{"index":9,"type":"double"},
									{"index":10,"type":"double"},
									{"index":11,"type":"double"},
									{"index":12,"type":"long"},
									{"index":13,"type":"string"},
									{"name":"dm_created_time","type":"string","value":"${kerberosPrincipal}"},
									{"index":15,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}"
                    }
                },
                "writer": {
                    "name": "starrockswriter",
                    "parameter": {
                        "column": [
									"inv_secu_id",
									"main_secu_id",
									"typ_code",
									"rel_dt",
									"end_dt",
									"rpt_typ",
									"rpt_typ_desc",
									"hld_vol",
									"curr_code",
									"hld_val",
									"hld_nav_rat",
									"hld_ttl_ast_rat",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:mysql://${tgrurl}/",
                                "selectedDatabase": "${selectedDatabase}", 
                                "table": ["var_fund_ivsm_dtl"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "loadUrl":[${loadUrl}],
                        "preSql":["truncate table data_mart.var_fund_ivsm_dtl"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


