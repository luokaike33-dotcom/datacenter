{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_fund_nval_info/p_dt=${p_dt}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"long"},
									{"index":2,"type":"double"},
									{"index":3,"type":"double"},
									{"index":4,"type":"double"},
									{"index":5,"type":"double"},
									{"index":6,"type":"double"},
									{"index":7,"type":"string"},
									{"index":8,"type":"double"},
									{"index":9,"type":"double"},
									{"index":10,"type":"long"},
									{"index":11,"type":"string"},
									{"name":"dm_created_time","type":"string","value":"${kerberosPrincipal}"},
                                    {"name":"p_dt","type":"string","value":"${p_dt}"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "starrockswriter",
                    "parameter": {
                        "column": [
									"secu_id",
									"trd_dt",
									"shr_nval",
									"tot_nval",
									"shr_aggr_nval",
									"unit_yld",
									"ann_yld_rat",
									"curr_code",
									"aft_chk_unit_nval",
									"chk_ftor",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"p_dt"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:mysql://${tgrurl}/",
                                "selectedDatabase": "${selectedDatabase}", 
                                "table": ["var_fund_nval_info"]
                                    }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "loadUrl": [${loadUrl}],
                        "loadProps": {"column_separator": "\\x01","row_separator":"\\x02"},
                        "preSql":["delete from data_mart.var_fund_nval_info where p_dt ='${p_dt}'"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


