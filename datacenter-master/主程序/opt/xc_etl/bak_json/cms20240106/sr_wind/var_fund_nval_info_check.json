{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_fund_nval_info_check/p_dt=${p_dt}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"DOUBLE"},
                                    {"index":2,"type":"DOUBLE"},
                                    {"index":3,"type":"double"},
                                    {"index":4,"type":"double"},
                                    {"index":5,"type":"double"},
                                    {"index":6,"type":"double"},
                                    {"index":7,"type":"double"},
                                    {"index":8,"type":"double"},
                                    {"index":9,"type":"double"},
                                    {"index":10,"type":"double"},
                                    {"index":11,"type":"string"},
                                    {"index":12,"type":"DOUBLE"},
                                    {"index":13,"type":"string"},
									{"name":"dm_created_time","type":"string","value":"${kerberosPrincipal}"},
                                    {"name":"p_dt","type":"DOUBLE","value":"${p_dt}"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "starrockswriter",
                    "parameter": {
                        "column": [
                                    "secu_id",
                                    "rel_dt",
                                    "trd_dt",
                                    "shr_nval",
                                    "shr_aggr_nval",
                                    "unit_yld",
                                    "ann_yld_rat",
                                    "aft_chk_unit_nval",
                                    "chk_aggr_unit_nav",
                                    "chk_ftor",
                                    "ttl_ast",
                                    "curr_code",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    "p_dt",
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:mysql://${tgrurl}",
                              "selectedDatabase": "${selectedDatabase}",
                              "table": ["var_fund_nval_info_check"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "loadUrl": [${loadUrl}],
                        "loadProps": {"column_separator": "\\x01","row_separator":"\\x02"},
                        "preSql":["delete from data_mart.var_fund_nval_info_check where p_dt ='${p_dt}' "]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
