{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_hstk_sh_meet",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"long"},
									{"index":2,"type":"long"},
									{"index":3,"type":"string"},
									{"index":4,"type":"long"},
									{"index":5,"type":"long"},
									{"index":6,"type":"long"},
									{"index":7,"type":"long"},
									{"index":8,"type":"long"},
									{"index":9,"type":"string"},
									{"index":10,"type":"long"},
									{"index":11,"type":"string"},
									{"index":12,"type":"string"},
									{"index":13,"type":"long"},
									{"index":14,"type":"long"},
									{"index":15,"type":"long"},
									{"index":16,"type":"long"},
									{"index":17,"type":"string"},
									{"index":18,"type":"string"},
									{"index":19,"type":"long"},
									{"index":20,"type":"string"},
									{"name":"dm_created_time","type":"string","value":"${kerberosPrincipal}"},
									{"index":22,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}"
                    }
                },
                "writer": {
                    "name": "starrockswriter",
                    "parameter": {
                        "column": [
									"com_id",
									"affi_date",
									"meet_date",
									"meet_typ",
									"vote_chnl_code",
									"astk_stor_reg_day",
									"meet_reg_begn_day",
									"meet_reg_end_day",
									"is_poss_web_vote",
									"meet_evt_id",
									"lst_flag",
									"meet_name",
									"vote_typ",
									"is_ntry",
									"tran_begn_day",
									"tran_end_day",
									"h_shr_stor_reg_day",
									"meet_cotr_site",
									"meet_cont",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:mysql://${tgrurl}/",
                                "selectedDatabase": "${selectedDatabase}", 
                                "table": ["var_hstk_sh_meet"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "loadUrl":[${loadUrl}],
                        "preSql":["truncate table data_mart.var_hstk_sh_meet"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


