{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_idx_dquot/p_dt=${p_dt}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"long"},
									{"index":2,"type":"double"},
									{"index":3,"type":"double"},
									{"index":4,"type":"double"},
									{"index":5,"type":"double"},
									{"index":6,"type":"double"},
									{"index":7,"type":"double"},
									{"index":8,"type":"double"},
									{"index":9,"type":"double"},
									{"index":10,"type":"double"},
									{"index":11,"type":"double"},
									{"index":12,"type":"string"},
									{"index":13,"type":"long"},
									{"index":14,"type":"string"},
									{"name":"dm_created_time","type":"string","value":"${kerberosPrincipal}"},
									{"value":"","type":"string"},
									{"name":"p_dt","type":"DOUBLE","value":"${p_dt}"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}"
                    }
                },
                "writer": {
                    "name": "starrockswriter",
                    "parameter": {
                        "column": [
									"secu_id",
									"trd_dt",
									"prev_cls_prc",
									"open_prc",
									"high_prc",
									"low_prc",
									"cls_prc",
									"tnv_vol",
									"tnv_val",
									"tnv_deal",
									"day_chg",
									"day_chg_rat",
									"curr_code",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"sys_rs_id",
									"p_dt"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:mysql://${tgrurl}/",
                                "selectedDatabase": "${selectedDatabase}", 
                                "table": ["var_idx_dquot"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "loadUrl":[${loadUrl}],
                        "preSql":["delete from data_mart.var_idx_dquot where p_dt='${p_dt}'"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


