{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_idx_elem_wght/p_dt=${p_dt}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"string"},
                                    {"index":2,"type":"DOUBLE"},
                                    {"index":3,"type":"double"},
                                    {"index":4,"type":"DOUBLE"},
                                    {"index":5,"type":"string"},
									{"name":"dm_created_time","type":"string","value":"${kerberosPrincipal}"},
                                    {"name":"p_dt","type":"DOUBLE","value":"${p_dt}"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "starrockswriter",
                    "parameter": {
                        "column": [
                                    "idx_secu_id",
                                    "secu_id",
                                    "trd_dt",
                                    "wt_val",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    "p_dt",
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:mysql://${tgrurl}",
                              "selectedDatabase": "${selectedDatabase}",
                              "table": ["var_idx_elem_wght"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "loadUrl": [${loadUrl}],
                        "loadProps": {"column_separator": "\\x01","row_separator":"\\x02"},
                        "preSql":["delete from data_mart.var_idx_elem_wght where p_dt ='${p_dt}' "]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
