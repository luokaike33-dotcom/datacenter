{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_stk_perf_fcst/busi_month=${busi_month}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"long"},
									{"index":4,"type":"string"},
									{"index":5,"type":"double"},
									{"index":6,"type":"double"},
									{"index":7,"type":"double"},
									{"index":8,"type":"double"},
									{"index":9,"type":"double"},
									{"index":10,"type":"string"},
									{"index":11,"type":"string"},
									{"index":12,"type":"string"},
									{"index":13,"type":"double"},
									{"index":14,"type":"string"},
									{"index":15,"type":"long"},
									{"index":16,"type":"string"},
									{"name":"dm_created_time","type":"string","value":"${kerberosPrincipal}"}
									{"index":18,"type":"string"},
									{"name":"busi_month","type":"long","value":"${busi_month}"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}"
                    }
                },
                "writer": {
                    "name": "starrockswriter",
                    "parameter": {
                        "column": [
									"secu_id",
									"affi_date",
									"rept_pd",
									"expe_perf_typ_code",
									"is_chng",
									"expe_net_prof_chg_rang_lowl",
									"expe_net_prof_chg_rang_topl",
									"expe_net_prof_lowl",
									"expe_net_prof_topl",
									"pub_tims",
									"fst_affi_day",
									"perf_expe_abs",
									"perf_chg_resn",
									"prn_corp_net_prof",
									"com_id",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"sys_rs_id",
									"busi_month"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:mysql://${tgrurl}/",
                                "selectedDatabase": "${selectedDatabase}", 
                                "table": ["var_stk_perf_fcst"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "loadUrl":[${loadUrl}],
                        "preSql":["delete from data_mart.var_stk_perf_fcst where busi_month=${busi_month}"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


