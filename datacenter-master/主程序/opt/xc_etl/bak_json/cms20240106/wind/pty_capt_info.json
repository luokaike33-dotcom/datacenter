{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/pty_capt_info",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"long"},
                                    {"index":2,"type":"long"},
                                    {"index":3,"type":"double"},
                                    {"index":4,"type":"double"},
                                    {"index":5,"type":"double"},
                                    {"index":6,"type":"double"},
                                    {"index":7,"type":"double"},
                                    {"index":8,"type":"double"},
                                    {"index":9,"type":"double"},
                                    {"index":10,"type":"double"},
                                    {"index":11,"type":"double"},
                                    {"index":12,"type":"double"},
                                    {"index":13,"type":"double"},
                                    {"index":14,"type":"double"},
                                    {"index":15,"type":"double"},
                                    {"index":16,"type":"long"},
                                    {"index":17,"type":"string"},
                                    {"index":18,"type":"date"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "com_id",
                                    "end_dt",
                                    "lst_chg_dt",
                                    "ttl_shr",
                                    "a_shr",
                                    "a_shr_circ",
                                    "a_shr_tcl",
                                    "b_shr",
                                    "b_shr_circ",
                                    "b_shr_circ_n",
                                    "h_shr",
                                    "h_shr_circ_n",
                                    "h_shr_tcl",
                                    "ttl_shr_lf",
                                    "ttl_shr_tlc",
                                    "ttl_shr_nlf",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["pty_capt_info"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from pty_capt_info where 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
