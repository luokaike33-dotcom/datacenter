{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/pty_norm_incm_fin/busi_month=${busi_month}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"long"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"long"},
                                    {"index":4,"type":"double"},
                                    {"index":5,"type":"long"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"string"},
                                    {"name":"busi_month","type":"long","value":"${busi_month}"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "com_id",
                                    "pub_dt",
                                    "rept_merg_type",
                                    "acc_crse_no",
                                    "acc_crse_val",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    "busi_month",
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["pty_norm_incm_fin"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from pty_norm_incm_fin where busi_month ='${busi_month}' and 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {
              "record": "0",
              "percentage": "0"
            }
        }
    }
}
