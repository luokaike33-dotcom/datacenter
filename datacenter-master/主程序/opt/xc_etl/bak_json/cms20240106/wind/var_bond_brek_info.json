                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "dflt_info_id",
                                    "pub_dt",
                                    "secu_id",
                                    "trd_code",
                                    "exch_code",
                                    "chi_name",
                                    "pay_dt",
                                    "cash_typ",
                                    "cash_typ_desc",
                                    "is_bd_dflt",
                                    "bd_amt",
                                    "whdw_brek_dt",
                                    "break_reason",
                                    "payable_principal",
                                    "payable_interest",
                                    "payment_principal",
                                    "payment_interest",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_bond_brek_info"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_bond_brek_info where 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {
              "record": "0",
              "percentage": "0"
            }
        }
    }
}
