{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_bond_flta_intr",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"string"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"double"},
                                    {"index":5,"type":"long"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"double"},
                                    {"index":8,"type":"string"},
                                    {"index":9,"type":"string"},
                                    {"index":10,"type":"double"},
                                    {"index":11,"type":"string"},
                                    {"index":12,"type":"long"},
                                    {"index":13,"type":"string"},
                                    {"index":14,"type":"date"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "secu_id",
                                    "ref_rat_code",
                                    "is_mkt_rat",
                                    "mkt_rat_code",
                                    "int_flr_rat",
                                    "f_prc_cfm_dt",
                                    "pay_dt_typ",
                                    "ref_rat_pcs",
                                    "ref_rat_dt_desc",
                                    "cp_rat_desc",
                                    "ref_rat_prd",
                                    "curr_code",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_bond_flta_intr"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_bond_flta_intr where 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
