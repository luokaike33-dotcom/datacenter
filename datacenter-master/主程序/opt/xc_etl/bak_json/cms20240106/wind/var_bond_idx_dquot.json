{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_bond_idx_dquot/p_dt=${p_dt}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"long"},
                                    {"index":2,"type":"double"},
                                    {"index":3,"type":"double"},
                                    {"index":4,"type":"double"},
                                    {"index":5,"type":"double"},
                                    {"index":6,"type":"double"},
                                    {"index":7,"type":"double"},
                                    {"index":8,"type":"double"},
                                    {"index":9,"type":"double"},
                                    {"index":10,"type":"double"},
                                    {"index":11,"type":"double"},
                                    {"index":12,"type":"double"},
                                    {"index":13,"type":"double"},
                                    {"index":14,"type":"double"},
                                    {"index":15,"type":"double"},
                                    {"index":16,"type":"double"},
                                    {"index":17,"type":"double"},
                                    {"index":18,"type":"double"},
                                    {"index":19,"type":"double"},
                                    {"index":20,"type":"double"},
                                    {"index":21,"type":"double"},
                                    {"index":22,"type":"long"},
                                    {"index":23,"type":"string"},
                                    {"index":24,"type":"date"},
                                    {"name":"p_dt","type":"long","value":"${p_dt}"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "secu_id",
                                    "trd_dt",
                                    "cls_prc",
                                    "full_idx_prc",
                                    "net_prc",
                                    "avg_val_dur",
                                    "avg_cash_dur",
                                    "idx_conv",
                                    "avg_cash_conv",
                                    "avg_rat",
                                    "ytm_mk_val",
                                    "avg_bsp_val",
                                    "ttm",
                                    "avg_pay_rat",
                                    "idx_mk_val",
                                    "spot_vol",
                                    "pre_cls_prc",
                                    "idx_pre_prc",
                                    "idx_net_prc",
                                    "chg_pct",
                                    "idx_full_pct",
                                    "idx_net_pct",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time",
                                    "p_dt"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_bond_idx_dquot"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_bond_idx_dquot where p_dt ='${p_dt}' and 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
