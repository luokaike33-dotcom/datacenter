{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_bond_iss",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"double"},
                                    {"index":2,"type":"double"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"double"},
                                    {"index":5,"type":"string"},
                                    {"index":6,"type":"double"},
                                    {"index":7,"type":"double"},
                                    {"index":8,"type":"double"},
                                    {"index":9,"type":"double"},
                                    {"index":10,"type":"double"},
                                    {"index":11,"type":"double"},
                                    {"index":12,"type":"double"},
                                    {"index":13,"type":"double"},
                                    {"index":14,"type":"string"},
                                    {"index":15,"type":"string"},
                                    {"index":16,"type":"date"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                              "secu_id",
                              "iss_bgn_dt",
                              "iss_end_dt",
                              "com_id",
                              "iss_prc",
                              "is_addi",
                              "iss_tims",
                              "pay_end_dt",
                              "lst_dt",
                              "plan_iss_amt",
                              "actl_iss_amt",
                              "plan_iss_amt_topl",
                              "plan_iss_amt_lowl",
                              "busi_date",
                              "task_rs_id",
                              "dm_src_info",
                              "dm_created_time"
                              
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_bond_iss"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_bond_iss where 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
