{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_crv_rat/busi_month=${busi_month}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"string"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"string"},
                                    {"index":5,"type":"string"},
                                    {"index":6,"type":"long"},
                                    {"index":7,"type":"double"},
                                    {"index":8,"type":"double"},
                                    {"index":9,"type":"double"},
                                    {"index":10,"type":"double"},
                                    {"index":11,"type":"long"},
                                    {"index":12,"type":"string"},
                                    {"index":13,"type":"date"},
                                    {"index":14,"type":"long"},
                                    {"name":"busi_month","type":"long","value":"${busi_month}"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "secu_id",
                                    "secu_name",
                                    "crv_typ_code",
                                    "crv_typ_name",
                                    "pd_inval_code",
                                    "pd_inval_name",
                                    "trd_dt",
                                    "fwd_maty_n",
                                    "fwd_maty_k",
                                    "maty_year",
                                    "yld_rat",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time",
                                    "p_dt"
                                    "busi_month",
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_crv_rat"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_crv_rat where busi_month ='${busi_month}' and 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
