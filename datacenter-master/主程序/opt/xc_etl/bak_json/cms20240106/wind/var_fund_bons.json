{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_fund_bons",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"long"},
                                    {"index":2,"type":"long"},
                                    {"index":3,"type":"long"},
                                    {"index":4,"type":"long"},
                                    {"index":5,"type":"long"},
                                    {"index":6,"type":"long"},
                                    {"index":7,"type":"long"},
                                    {"index":8,"type":"long"},
                                    {"index":9,"type":"long"},
                                    {"index":10,"type":"long"},
                                    {"index":11,"type":"double"},
                                    {"index":12,"type":"double"},
                                    {"index":13,"type":"double"},
                                    {"index":14,"type":"long"},
                                    {"index":15,"type":"long"},
                                    {"index":16,"type":"string"},
                                    {"index":17,"type":"date"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "secu_id",
                                    "rt_reg_dt",
                                    "plan_ntc_dt",
                                    "impl_ntc_dt",
                                    "ex_rd_dt_exch",
                                    "dvd_pay_dt_exch",
                                    "ex_rd_dt_otc",
                                    "dvd_pay_dt",
                                    "nav_cfm_dt",
                                    "shr_acct_dt",
                                    "div_redem_bgn_dt",
                                    "cash_bfr_tax_rmb",
                                    "cash_aft_tax_rmb",
                                    "ttl_cash_rmb",
                                    "dvd_ben_dt",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_fund_bons"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_fund_bons where 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
