{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_fund_info_pte",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"string"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"string"},
                                    {"index":5,"type":"string"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"string"},
                                    {"index":8,"type":"long"},
                                    {"index":9,"type":"string"},
                                    {"index":10,"type":"string"},
                                    {"index":11,"type":"long"},
                                    {"index":12,"type":"long"},
                                    {"index":13,"type":"string"},
                                    {"index":14,"type":"string"},
                                    {"index":15,"type":"string"},
                                    {"index":16,"type":"string"},
                                    {"index":17,"type":"string"},
                                    {"index":18,"type":"string"},
                                    {"index":19,"type":"long"},
                                    {"index":20,"type":"string"},
                                    {"index":21,"type":"string"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
