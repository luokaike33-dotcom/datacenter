                                    "cust_com_name",
                                    "inv_advr",
                                    "reg_num",
                                    "fund_reg_num",
                                    "trus_fund_reg_num",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_fund_info_pte"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_fund_info_pte where 1=1"]
