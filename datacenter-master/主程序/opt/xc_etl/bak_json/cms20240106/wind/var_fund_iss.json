{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_fund_iss",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"long"},
                                    {"index":2,"type":"long"},
                                    {"index":3,"type":"long"},
                                    {"index":4,"type":"long"},
                                    {"index":5,"type":"long"},
                                    {"index":6,"type":"long"},
                                    {"index":7,"type":"long"},
                                    {"index":8,"type":"long"},
                                    {"index":9,"type":"string"},
                                    {"index":10,"type":"string"},
                                    {"index":11,"type":"double"},
                                    {"index":12,"type":"double"},
                                    {"index":13,"type":"string"},
                                    {"index":14,"type":"double"},
                                    {"index":15,"type":"double"},
                                    {"index":16,"type":"double"},
                                    {"index":17,"type":"string"},
                                    {"index":18,"type":"string"},
                                    {"index":19,"type":"double"},
                                    {"index":20,"type":"long"},
                                    {"index":21,"type":"string"},
                                    {"index":22,"type":"date"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "secu_id",
                                    "pros_dt",
                                    "aprv_dt",
                                    "iss_dt",
                                    "contr_bgn_affi_dt",
                                    "contr_bgn_dt",
                                    "lst_ntc_dt",
                                    "lst_dt",
                                    "iss_typ_code",
                                    "iss_typ_desc",
                                    "iss_area",
                                    "iss_prc",
                                    "raise_vol",
                                    "curr_code",
                                    "par_val",
                                    "par_fee",
                                    "int_shr",
                                    "iss_pro_code",
                                    "iss_pro_desc",
                                    "pla_rat",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_fund_iss"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_fund_iss where 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
