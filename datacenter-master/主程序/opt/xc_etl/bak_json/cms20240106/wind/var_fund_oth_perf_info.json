{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_fund_oth_perf_info/p_dt=${p_dt}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"long"},
									{"index":2,"type":"string"},
									{"index":3,"type":"double"},
									{"index":4,"type":"double"},
									{"index":5,"type":"double"},
									{"index":6,"type":"double"},
									{"index":7,"type":"long"},
									{"index":8,"type":"string"},
									{"index":9,"type":"date"},
									{"index":10,"type":"double"},
                                    {"name":"p_dt","type":"long","value":"${p_dt}"},
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"secu_id",
									"end_dt",
									"indx_pd",
									"max_retr",
									"info_rati",
									"shrp_rati",
									"beta_rati",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"stdev",
									"p_dt"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["var_fund_oth_perf_info"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from var_fund_oth_perf_info where p_dt ='${p_dt}' and 1=1"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


