{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_fund_raise",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"long"},
                                    {"index":2,"type":"long"},
                                    {"index":3,"type":"long"},
                                    {"index":4,"type":"long"},
                                    {"index":5,"type":"long"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"string"},
                                    {"index":8,"type":"string"},
                                    {"index":9,"type":"double"},
                                    {"index":10,"type":"double"},
                                    {"index":11,"type":"double"},
                                    {"index":12,"type":"double"},
                                    {"index":13,"type":"long"},
                                    {"index":14,"type":"string"},
                                    {"index":15,"type":"date"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "secu_id",
                                    "raise_aprv_dt",
                                    "pros_dt",
                                    "raise_bgn_dt",
                                    "raise_end_dt",
                                    "raise_trd_cust_dt",
                                    "raise_mode_code",
                                    "raise_mode_desc",
                                    "raise_obj",
                                    "raise_shr_min",
                                    "raise_shr_max",
                                    "raise_shr",
                                    "raise_vol",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_fund_raise"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_fund_raise where 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
