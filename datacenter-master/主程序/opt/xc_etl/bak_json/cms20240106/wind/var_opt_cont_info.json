{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_opt_cont_info",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"string"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"string"},
                                    {"index":5,"type":"string"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"string"},
                                    {"index":8,"type":"string"},
                                    {"index":9,"type":"long"},
                                    {"index":10,"type":"long"},
                                    {"index":11,"type":"double"},
                                    {"index":12,"type":"long"},
                                    {"index":13,"type":"long"},
                                    {"index":14,"type":"long"},
                                    {"index":15,"type":"long"},
                                    {"index":16,"type":"long"},
                                    {"index":17,"type":"double"},
                                    {"index":18,"type":"double"},
                                    {"index":19,"type":"double"},
                                    {"index":20,"type":"long"},
                                    {"index":21,"type":"string"},
                                    {"index":22,"type":"date"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "secu_id",
                                    "secu_code",
                                    "trd_code",
                                    "secu_sht",
                                    "subj_secu_code",
                                    "subj_trd_code",
                                    "subj_secu_sht",
                                    "subj_secu_name",
                                    "subj_secu_typ",
                                    "secu_typ",
                                    "secu_unit",
                                    "exer_val",
                                    "end_dt",
                                    "last_trd_dt",
                                    "exer_dely_dt",
                                    "secu_lstg_dt",
                                    "secu_dlst_dt",
                                    "open_ref_prc",
                                    "lstg_lu_prc",
                                    "lstg_ld_prc",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_opt_cont_info"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_opt_cont_info where 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
