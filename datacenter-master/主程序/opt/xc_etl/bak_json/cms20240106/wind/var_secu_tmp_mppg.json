{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_secu_tmp_mppg",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"string"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"string"},
                                    {"index":5,"type":"string"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"string"},
                                    {"index":8,"type":"string"},
                                    {"index":9,"type":"string"},
                                    {"index":10,"type":"string"},
                                    {"index":11,"type":"long"},
                                    {"index":12,"type":"string"},
                                    {"index":13,"type":"date"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "tmp_secu_id",
                                    "tmp_trd_code",
                                    "tmp_exch_code",
                                    "tmp_typ_code",
                                    "tmp_chi_name",
                                    "secu_id",
                                    "trd_code",
                                    "exch_code",
                                    "typ_code",
                                    "chi_name",
                                    "flag",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_secu_tmp_mppg"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_secu_tmp_mppg where 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
