{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_stk_bons_cn",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"long"},
                                    {"index":1,"type":"string"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"string"},
                                    {"index":5,"type":"long"},
                                    {"index":6,"type":"long"},
                                    {"index":7,"type":"long"},
                                    {"index":8,"type":"long"},
                                    {"index":9,"type":"long"},
                                    {"index":10,"type":"long"},
                                    {"index":11,"type":"long"},
                                    {"index":12,"type":"long"},
                                    {"index":13,"type":"long"},
                                    {"index":14,"type":"double"},
                                    {"index":15,"type":"double"},
                                    {"index":16,"type":"double"},
                                    {"index":17,"type":"double"},
                                    {"index":18,"type":"long"},
                                    {"index":19,"type":"string"},
                                    {"index":20,"type":"long"},
                                    {"index":21,"type":"long"},
                                    {"index":22,"type":"long"},
                                    {"index":23,"type":"string"},
                                    {"index":24,"type":"string"},
