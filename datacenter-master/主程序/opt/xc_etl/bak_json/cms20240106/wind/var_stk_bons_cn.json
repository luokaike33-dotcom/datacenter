                                    "bt_trd_dt",
                                    "end_dt",
                                    "ex_rd_dt",
                                    "rt_reg_dt",
                                    "cash_bfr_tax",
                                    "cash_aft_tax",
                                    "bonus_rat",
                                    "trs_rat",
                                    "shr_bas",
                                    "rd_obj",
                                    "ttl_amt",
