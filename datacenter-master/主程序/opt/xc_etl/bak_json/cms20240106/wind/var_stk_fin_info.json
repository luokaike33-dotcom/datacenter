{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_stk_fin_info",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"long"},
                                    {"index":2,"type":"double"},
                                    {"index":3,"type":"double"},
                                    {"index":4,"type":"double"},
                                    {"index":5,"type":"double"},
                                    {"index":6,"type":"double"},
                                    {"index":7,"type":"double"},
                                    {"index":8,"type":"double"},
                                    {"index":9,"type":"double"},
                                    {"index":10,"type":"string"},
                                    {"index":11,"type":"double"},
                                    {"index":12,"type":"double"},
                                    {"index":13,"type":"double"},
                                    {"index":14,"type":"double"},
                                    {"index":15,"type":"double"},
                                    {"index":16,"type":"long"},
                                    {"index":17,"type":"string"},
                                    {"index":18,"type":"date"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "secu_id",
                                    "pub_dt",
                                    "roe",
                                    "eps",
                                    "naps",
                                    "sale_gpm",
                                    "prn_corp_net_prof",
                                    "no_assm_prft",
                                    "net_prof",
                                    "nast",
                                    "rpt_typ",
                                    "ps_oper_cf",
                                    "dvd_ps",
                                    "cash_eq_inc",
                                    "busi_incm",
                                    "busi_prft",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_stk_fin_info"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_stk_fin_info where 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
