{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_stk_inct_adj_fin",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"double"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"long"},
									{"index":11,"type":"string"},
									{"index":12,"type":"date"},
									{"value":"","type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"com_id",
									"rept_pd",
									"affi_date",
									"rept_typ",
									"data_cont",
									"proj_clas_code",
									"proj_pub_name",
									"proj_amt",
									"proj_tolr_name",
									"proj_clas_name",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["var_stk_inct_adj_fin"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from var_stk_inct_adj_fin"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


