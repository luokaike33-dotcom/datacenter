{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_stk_lmt_bal_hk",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"long"},
                                    {"index":1,"type":"string"},
                                    {"index":2,"type":"double"},
                                    {"index":3,"type":"long"},
                                    {"index":4,"type":"long"},
                                    {"index":5,"type":"long"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"long"},
                                    {"index":8,"type":"double"},
                                    {"index":9,"type":"double"},
                                    {"index":10,"type":"date"},
                                    {"index":11,"type":"long"},
                                    {"index":12,"type":"string"},
                                    {"index":13,"type":"date"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "trd_dt",
                                    "exch_code",
                                    "daily_amt",
                                    "amt_unit",
                                    "day_unused",
                                    "unused_unit",
                                    "typ_code",
                                    "buy_sell_val",
                                    "buy_val",
                                    "sell_val",
                                    "pub_time",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_stk_lmt_bal_hk"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from var_stk_lmt_bal_hk where 1=1"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
