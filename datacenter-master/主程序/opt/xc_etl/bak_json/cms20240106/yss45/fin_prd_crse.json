{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/fin_prd_crse",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"string"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"string"},
                                    {"index":5,"type":"string"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"string"},
                                    {"index":8,"type":"string"},
                                    {"index":9,"type":"string"},
                                    {"index":10,"type":"string"},
                                    {"index":11,"type":"string"},
                                    {"index":12,"type":"long"},
                                    {"index":13,"type":"string"},
                                    {"index":14,"type":"date"},
                                    {"index":15,"type":"string"},
                                    {"index":16,"type":"string"},
                                    {"index":17,"type":"string"},
                                    {"index":18,"type":"string"},
                                    {"index":19,"type":"string"},
                                    {"index":20,"type":"string"},
                                    {"index":21,"type":"string"},
                                    {"index":22,"type":"string"},
                                    {"index":23,"type":"string"},
                                    {"index":24,"type":"string"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "prd_code",
                                    "acc_sob_no",
                                    "crse_code",
                                    "crse_name",
                                    "crse_debc_dir",
                                    "crse_grade",
                                    "bml_crse_flag",
                                    "sett_crrc",
                                    "supr_crse",
                                    "inv_typ",
                                    "hedg_flag",
                                    "crse_dim",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time",
                                    "exch_code",
                                    "acg_proj",
                                    "secu_var",
                                    "secu_var_dtl",
                                    "trd_dim",
                                    "ast_stat",
                                    "acct_typ",
                                    "pay_proj",
                                    "pos_id",
                                    "dm_src_info"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["fin_prd_crse"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from fin_prd_crse where 1 =1 "]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
