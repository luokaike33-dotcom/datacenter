{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/fin_prd_new_stk_hld",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"long"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"string"},
                                    {"index":5,"type":"string"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"double"},
                                    {"index":8,"type":"double"},
                                    {"index":9,"type":"double"},
                                    {"index":10,"type":"double"},
                                    {"index":11,"type":"double"},
                                    {"index":12,"type":"double"},
                                    {"index":13,"type":"string"},
                                    {"index":14,"type":"long"},
                                    {"index":15,"type":"string"},
                                    {"index":16,"type":"date"},
                                    {"index":17,"type":"string"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "prd_code",
                                    "hld_dt",
                                    "secu_id",
                                    "inv_typ",
                                    "cir_id",
                                    "ast_stat",
                                    "pos_id",
                                    "hld_vol",
                                    "hld_val",
                                    "buy_val",
                                    "sell_val",
                                    "buy_vol",
                                    "sell_vol",
                                    "trd_typ",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time",
                                    "dm_src_info"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["fin_prd_new_stk_hld"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from fin_prd_new_stk_hld where 1 =1 "]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
