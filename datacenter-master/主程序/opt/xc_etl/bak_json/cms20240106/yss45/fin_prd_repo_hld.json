{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/fin_prd_repo_hld/p_dt=${p_dt}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"long"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"string"},
                                    {"index":5,"type":"string"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"string"},
                                    {"index":8,"type":"string"},
                                    {"index":9,"type":"string"},
                                    {"index":10,"type":"string"},
                                    {"index":11,"type":"double"},
                                    {"index":12,"type":"double"},
                                    {"index":13,"type":"double"},
                                    {"index":14,"type":"double"},
                                    {"index":15,"type":"double"},
                                    {"index":16,"type":"double"},
                                    {"index":17,"type":"double"},
                                    {"index":18,"type":"double"},
                                    {"index":19,"type":"double"},
                                    {"index":20,"type":"double"},
                                    {"index":21,"type":"string"},
                                    {"index":22,"type":"long"},
                                    {"index":23,"type":"string"},
                                    {"index":24,"type":"date"},
                                    {"index":25,"type":"string"},
                                    {"name":"p_dt""type":"long","value":"${p_dt}"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "prd_code",
                                    "hld_dt",
                                    "valuation_dimension",
                                    "secu_id",
                                    "var_secu_id",
                                    "typ_code",
                                    "typ_codei",
                                    "typ_codeii",
                                    "exch_code",
                                    "chi_name",
                                    "curr_code",
                                    "hld_vol",
                                    "hld_cost",
                                    "hld_mval",
                                    "accr_int",
                                    "ipmt_pvsn",
                                    "ipmt_pvsn_i",
                                    "ipmt_pvsn_ii",
                                    "ipmt_pvsn_iii",
                                    "buy_val",
                                    "sell_val",
                                    "pos_id",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time",
                                    "dm_src_info"
                                    "p_dt"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["fin_prd_repo_hld"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from fin_prd_repo_hld where p_dt ='${p_dt}' and 1 =1 "]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
