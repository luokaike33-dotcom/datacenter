{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/fin_prd_sale_fwd_days",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"string"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"string"},
                                    {"index":5,"type":"long"},
                                    {"index":6,"type":"long"},
                                    {"index":7,"type":"string"},
                                    {"index":8,"type":"string"},
                                    {"index":9,"type":"double"},
                                    {"index":10,"type":"string"},
                                    {"index":11,"type":"double"},
                                    {"index":12,"type":"long"},
                                    {"index":13,"type":"string"},
                                    {"index":14,"type":"date"},
                                    {"index":15,"type":"string"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "prd_code",
                                    "cifd_prd_code",
                                    "sale_meth",
                                    "oths_fund",
                                    "sale_net",
                                    "bgn_dt",
                                    "invl_dt",
                                    "curr_code",
                                    "cald_typ",
                                    "clea_days",
                                    "clea_cash_acc",
                                    "cnfm_days",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time",
                                    "dm_src_info"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["fin_prd_sale_fwd_days"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from fin_prd_sale_fwd_days where 1 =1 "]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
