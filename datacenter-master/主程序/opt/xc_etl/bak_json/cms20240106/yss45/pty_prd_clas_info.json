{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/pty_prd_clas_info",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"long"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"string"},
                                    {"index":5,"type":"string"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"string"},
                                    {"index":8,"type":"string"},
                                    {"index":9,"type":"string"},
                                    {"index":10,"type":"string"},
                                    {"index":11,"type":"string"},
                                    {"index":12,"type":"string"},
                                    {"index":13,"type":"long"},
                                    {"index":14,"type":"string"},
                                    {"index":15,"type":"date"},
                                    {"index":16,"type":"string"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "prd_code",
                                    "bgn_dt",
                                    "prd_invt",
                                    "prd_invtii",
                                    "csrc_spcl_typ",
                                    "prd_typ",
                                    "prd_styl",
                                    "ivsm_char",
                                    "oper_mode",
                                    "raise_mode",
                                    "assm_typ",
                                    "cifd_mdl",
                                    "is_prsr",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time",
                                    "dm_src_info"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["pty_prd_clas_info"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["delete from pty_prd_clas_info where 1 =1 "]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
