{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/t_sp_seller",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"long"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"long"},
									{"index":5,"type":"double"},
									{"index":6,"type":"double"},
									{"index":7,"type":"double"},
									{"index":8,"type":"double"},
									{"index":9,"type":"double"},
									{"index":10,"type":"double"},
									{"index":11,"type":"long"},
									{"index":12,"type":"long"},
									{"index":13,"type":"string"},
									{"index":14,"type":"long"},
									{"index":15,"type":"long"},
									{"index":16,"type":"long"},
									{"index":17,"type":"string"},
									{"index":18,"type":"string"},
									{"value":"","type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"bk_product",
									"agency_type",
									"agencyno",
									"agency_cname",
									"start_date",
									"purc_orgn",
									"fxiv_orgn",
									"min_redp_share",
									"scrp_orgn",
									"min_covt",
									"min_retn",
									"min_hold_days",
									"max_hold_days",
									"agency_dsnt",
									"elec_agmt_mode",
									"elec_agmt_chk_lvl",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["t_sp_seller"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from t_sp_seller"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


