{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select n_id,c_sec_code,c_secmkt_code,c_dv_plat,d_mkt,c_mkt_cls,c_mkt_time,n_price_new,n_price_buy,n_price_sell,n_price_high,n_price_low,n_price_close,n_price_open,n_price_avg,n_price_trans,n_ratio_trans,n_td_amount,n_td_money,d_pub,c_update_time,c_timestamp,to_char(sysdate,'yyyyMMdd') as bath_dt,sysdate as data_ins_time,'fa45_is_mktprice.json' as task_rs_id from ${srcoradbname}.is_mktprice"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/fa45_is_mktprice",
                        "fileName": "fa45_is_mktprice",
                        "column": [
                            {"name":"n_id","type":"string"},
                            {"name":"c_sec_code","type":"string"},
                            {"name":"c_secmkt_code","type":"string"},
                            {"name":"c_dv_plat","type":"string"},
                            {"name":"d_mkt","type":"date"},
                            {"name":"c_mkt_cls","type":"string"},
                            {"name":"c_mkt_time","type":"string"},
                            {"name":"n_price_new","type":"double"},
                            {"name":"n_price_buy","type":"double"},
                            {"name":"n_price_sell","type":"double"},
                            {"name":"n_price_high","type":"double"},
                            {"name":"n_price_low","type":"double"},
                            {"name":"n_price_close","type":"double"},
                            {"name":"n_price_open","type":"double"},
                            {"name":"n_price_avg","type":"double"},
                            {"name":"n_price_trans","type":"double"},
                            {"name":"n_ratio_trans","type":"double"},
                            {"name":"n_td_amount","type":"double"},
                            {"name":"n_td_money","type":"double"},
                            {"name":"d_pub","type":"date"},
                            {"name":"c_update_time","type":"string"},
                            {"name":"c_timestamp","type":"string"},
                            {"name":"bath_dt","type":"string"},
                            {"name":"data_ins_time","type":"timestamp"},
                            {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
