                        "column": [
                            {"name":"c_year_month","type":"string"},
                            {"name":"c_port_code","type":"string"},
                            {"name":"d_stock","type":"date"},
                            {"name":"c_dta_code","type":"string"},
                            {"name":"c_dv_issue_mode","type":"string"},
                            {"name":"c_dv_var_dur","type":"string"},
                            {"name":"c_dv_invest_cls","type":"string"},
                            {"name":"c_port_cls_code","type":"string"},
                            {"name":"c_dai_code","type":"string"},
                            {"name":"c_ca_code","type":"string"},
                            {"name":"c_sec_code","type":"string"},
                            {"name":"c_fee_code","type":"string"},
                            {"name":"c_net_code","type":"string"},
                            {"name":"c_mkt_code","type":"string"},
                            {"name":"c_sec_var_code","type":"string"},
                            {"name":"c_dv_acc_type","type":"string"},
                            {"name":"c_dv_fee_type","type":"string"},
                            {"name":"c_ds_code","type":"string"},
