{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select c_pa_code,c_pa_name,c_dv_km_cls,n_fund_way,c_dv_bool_type_am,c_stock_cls,c_dai_type,c_timestamp,to_char(sysdate,'yyyyMMdd') as bath_dt,sysdate as data_ins_time,'fa45_vb_dai_item.json' as task_rs_id from ${srcoradbname}.vb_dai_item"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/fa45_vb_dai_item",
                        "fileName": "fa45_vb_dai_item",
                        "column": [
                            {"name":"c_pa_code","type":"string"},
                            {"name":"c_pa_name","type":"string"},
                            {"name":"c_dv_km_cls","type":"string"},
                            {"name":"n_fund_way","type":"int"},
                            {"name":"c_dv_bool_type_am","type":"int"},
                            {"name":"c_stock_cls","type":"string"},
                            {"name":"c_dai_type","type":"string"},
                            {"name":"c_timestamp","type":"string"},
                            {"name":"bath_dt","type":"string"},
                            {"name":"data_ins_time","type":"timestamp"},
                            {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
