{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select c_port_code,c_asset_code,c_port_name,c_port_name_st,c_port_name_en,c_port_type,c_port_level,c_port_kind,c_port_subkind,c_invt_qus,c_invt_mkt,c_port_style,c_port_style_xbrl,c_port_cury,n_sales_factor,c_dv_prod_state,c_capl_source,n_initamt,n_initshare,c_hday_code,d_establish,d_tolist,d_due,d_establish_fact,c_port_code_p,d_clear,c_timestamp,to_char(sysdate,'yyyyMMdd') as bath_dt,sysdate as data_ins_time,'fa45_vb_port_baseinfo.json' as task_rs_id from ${srcoradbname}.vb_port_baseinfo"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/fa45_vb_port_baseinfo",
                        "fileName": "fa45_vb_port_baseinfo",
                        "column": [
                            {"name":"c_port_code","type":"string"},
                            {"name":"c_asset_code","type":"string"},
                            {"name":"c_port_name","type":"string"},
                            {"name":"c_port_name_st","type":"string"},
                            {"name":"c_port_name_en","type":"string"},
                            {"name":"c_port_type","type":"string"},
                            {"name":"c_port_level","type":"string"},
                            {"name":"c_port_kind","type":"string"},
                            {"name":"c_port_subkind","type":"string"},
                            {"name":"c_invt_qus","type":"string"},
                            {"name":"c_invt_mkt","type":"string"},
                            {"name":"c_port_style","type":"string"},
                            {"name":"c_port_style_xbrl","type":"string"},
                            {"name":"c_port_cury","type":"string"},
                            {"name":"n_sales_factor","type":"double"},
                            {"name":"c_dv_prod_state","type":"string"},
                            {"name":"c_capl_source","type":"string"},
                            {"name":"n_initamt","type":"double"},
                            {"name":"n_initshare","type":"double"},
                            {"name":"c_hday_code","type":"string"},
                            {"name":"d_establish","type":"date"},
                            {"name":"d_tolist","type":"date"},
                            {"name":"d_due","type":"date"},
                            {"name":"d_establish_fact","type":"date"},
                            {"name":"c_port_code_p","type":"string"},
                            {"name":"d_clear","type":"date"},
                            {"name":"c_timestamp","type":"string"},
                            {"name":"bath_dt","type":"string"},
                            {"name":"data_ins_time","type":"timestamp"},
                            {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
