{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select n_id,c_port_code,c_asset_code,c_port_class,c_ds_code,c_port_code_os,c_sell_net_code,d_begin,d_end,c_cury_code,c_hday_code,n_sett,n_confirm,c_ca_code,c_desc,c_update_time,c_timestamp,to_char(sysdate,'yyyyMMdd') as bath_dt,sysdate as data_ins_time,'fa45_vb_port_co_sett.json' as task_rs_id from ${srcoradbname}.vb_port_co_sett"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/fa45_vb_port_co_sett",
                        "fileName": "fa45_vb_port_co_sett",
                        "column": [
                            {"name":"n_id","type":"string"},
                            {"name":"c_port_code","type":"string"},
                            {"name":"c_asset_code","type":"string"},
                            {"name":"c_port_class","type":"string"},
                            {"name":"c_ds_code","type":"string"},
                            {"name":"c_port_code_os","type":"string"},
                            {"name":"c_sell_net_code","type":"string"},
                            {"name":"d_begin","type":"date"},
                            {"name":"d_end","type":"date"},
                            {"name":"c_cury_code","type":"string"},
                            {"name":"c_hday_code","type":"string"},
                            {"name":"n_sett","type":"int"},
                            {"name":"n_confirm","type":"int"},
                            {"name":"c_ca_code","type":"string"},
                            {"name":"c_desc","type":"string"},
                            {"name":"c_update_time","type":"string"},
                            {"name":"c_timestamp","type":"string"},
                            {"name":"bath_dt","type":"string"},
                            {"name":"data_ins_time","type":"timestamp"},
                            {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
