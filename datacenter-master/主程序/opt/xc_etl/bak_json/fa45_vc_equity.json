{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select n_id,c_port_code,c_asset_code,c_port_class,d_biz,c_ds_code,n_td_amount,n_td_money,n_unit_money_pt,n_unit_money_at,c_desc,c_data_idf,c_update_time,c_timestamp,to_char(sysdate,'yyyyMMdd') as bath_dt,sysdate as data_ins_time,'fa45_vc_equity.json' as task_rs_id from ${srcoradbname}.vc_equity"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/fa45_vc_equity",
                        "fileName": "fa45_vc_equity",
                        "column": [
                            {"name":"n_id","type":"string"},
                            {"name":"c_port_code","type":"string"},
                            {"name":"c_asset_code","type":"string"},
                            {"name":"c_port_class","type":"string"},
                            {"name":"d_biz","type":"date"},
                            {"name":"c_ds_code","type":"string"},
                            {"name":"n_td_amount","type":"double"},
                            {"name":"n_td_money","type":"double"},
                            {"name":"n_unit_money_pt","type":"double"},
                            {"name":"n_unit_money_at","type":"double"},
                            {"name":"c_desc","type":"string"},
                            {"name":"c_data_idf","type":"string"},
                            {"name":"c_update_time","type":"string"},
                            {"name":"c_timestamp","type":"string"},
                            {"name":"bath_dt","type":"string"},
                            {"name":"data_ins_time","type":"timestamp"},
                            {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
