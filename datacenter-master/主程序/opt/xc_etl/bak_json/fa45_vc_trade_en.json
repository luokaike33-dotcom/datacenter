{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select n_id,n_id_sub,c_port_code,c_asset_code,c_dt_code,c_sec_code,c_td_type,c_td_plat,c_td_attr,c_ml_attr,c_tdchan_code,c_ivt_clss,c_td_code,d_trade_date,n_td_money,n_sett_money_due,d_sett_due,c_dc_code,c_dc_code_sett,c_ca_code_sett_due,d_sett_fact,c_cury_code_equ,c_td_number,d_biz,c_dv_state,d_trade_back,n_sett_money_fact,n_td_amount,d_reg,n_td_income,n_rate,c_mkt_code,c_desc,c_update_time,c_timestamp,to_char(sysdate,'yyyyMMdd') as bath_dt,sysdate as data_ins_time,'fa45_vc_trade_en.json' as task_rs_id from ${srcoradbname}.vc_trade_en"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/fa45_vc_trade_en",
                        "fileName": "fa45_vc_trade_en",
                        "column": [
                            {"name":"n_id","type":"string"},
                            {"name":"n_id_sub","type":"string"},
                            {"name":"c_port_code","type":"string"},
                            {"name":"c_asset_code","type":"string"},
                            {"name":"c_dt_code","type":"string"},
                            {"name":"c_sec_code","type":"string"},
                            {"name":"c_td_type","type":"string"},
                            {"name":"c_td_plat","type":"string"},
                            {"name":"c_td_attr","type":"string"},
                            {"name":"c_ml_attr","type":"string"},
                            {"name":"c_tdchan_code","type":"string"},
                            {"name":"c_ivt_clss","type":"string"},
                            {"name":"c_td_code","type":"string"},
                            {"name":"d_trade_date","type":"date"},
                            {"name":"n_td_money","type":"double"},
                            {"name":"n_sett_money_due","type":"double"},
                            {"name":"d_sett_due","type":"date"},
                            {"name":"c_dc_code","type":"string"},
                            {"name":"c_dc_code_sett","type":"string"},
                            {"name":"c_ca_code_sett_due","type":"string"},
                            {"name":"d_sett_fact","type":"date"},
                            {"name":"c_cury_code_equ","type":"string"},
                            {"name":"c_td_number","type":"string"},
                            {"name":"d_biz","type":"date"},
                            {"name":"c_dv_state","type":"string"},
                            {"name":"d_trade_back","type":"date"},
                            {"name":"n_sett_money_fact","type":"double"},
                            {"name":"n_td_amount","type":"double"},
                            {"name":"d_reg","type":"date"},
                            {"name":"n_td_income","type":"double"},
                            {"name":"n_rate","type":"double"},
                            {"name":"c_mkt_code","type":"string"},
                            {"name":"c_desc","type":"string"},
                            {"name":"c_update_time","type":"string"},
                            {"name":"c_timestamp","type":"string"},
                            {"name":"bath_dt","type":"string"},
                            {"name":"data_ins_time","type":"timestamp"},
                            {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
