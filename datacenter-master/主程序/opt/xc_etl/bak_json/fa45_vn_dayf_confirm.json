{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select n_id,d_biz,c_port_code,c_asset_code,n_check_state,c_confirm_time,c_biz_cls,c_biz_item,c_execute,c_timestamp,to_char(sysdate,'yyyyMMdd') as bath_dt,sysdate as data_ins_time,'fa45_vn_dayf_confirm.json' as task_rs_id from ${srcoradbname}.vn_dayf_confirm"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/fa45_vn_dayf_confirm",
                        "fileName": "fa45_vn_dayf_confirm",
                        "column": [
                            {"name":"n_id","type":"string"},
                            {"name":"d_biz","type":"date"},
                            {"name":"c_port_code","type":"string"},
                            {"name":"c_asset_code","type":"string"},
                            {"name":"n_check_state","type":"double"},
                            {"name":"c_confirm_time","type":"string"},
                            {"name":"c_biz_cls","type":"string"},
                            {"name":"c_biz_item","type":"string"},
                            {"name":"c_execute","type":"string"},
                            {"name":"c_timestamp","type":"string"},
                            {"name":"bath_dt","type":"string"},
                            {"name":"data_ins_time","type":"timestamp"},
                            {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
