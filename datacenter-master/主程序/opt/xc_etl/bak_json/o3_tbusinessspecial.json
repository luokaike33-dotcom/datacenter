{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": ["select c_busin_class, c_market_no, c_stock_type, c_control_type, en_uplimit, en_downlimit, c_entrust_direction, vc_mixed_type, vc_timestamp, l_virtual_key, c_stock_property from ${srcoradbname}.tbusinessspecial"],
                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://${tgrhdfsurl}",
            "fileType": "orc",
            "haveKerberos":"${haveKerberos}",
            "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
            "kerberosPrincipal":"${kerberosPrincipal}",
            "path": "${tgrhivedbpath}/o3_tbusinessspecial",
            "fileName": "o3_tbusinessspecial",
            "column": [
              {"name":"c_busin_class","type":"string"},
              {"name":"c_market_no","type":"string"},
              {"name":"c_stock_type","type":"string"},
              {"name":"c_control_type","type":"string"},
              {"name":"en_uplimit","type":"double"},
              {"name":"en_downlimit","type":"double"},
              {"name":"c_entrust_direction","type":"string"},
              {"name":"vc_mixed_type","type":"string"},
              {"name":"vc_timestamp","type":"string"},
              {"name":"l_virtual_key","type":"bigint"},
              {"name":"c_stock_property","type":"string"}
            ],
            "writeMode": "append",
            "fieldDelimiter": "\t"
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
      }
    }
  }
}
