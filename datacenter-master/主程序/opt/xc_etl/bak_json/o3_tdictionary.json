{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select l_dictionary_no,c_lemma_item,vc_item_name,c_allow_edit,l_code_length,c_lemma_type,l_opposite_no,vc_opposite_item,l_virtual_key,vc_timestamp,l_code_min_length from ${srcoradbname}.tdictionary"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/o3_tdictionary", 
                        "fileName": "o3_tdictionary",
                        "column": [
     {"name":"l_dictionary_no","type":"int"},
     {"name":"c_lemma_item","type":"string"},
     {"name":"vc_item_name","type":"string"},
     {"name":"c_allow_edit","type":"string"},
     {"name":"l_code_length","type":"int"},
     {"name":"c_lemma_type","type":"string"},
     {"name":"l_opposite_no","type":"int"},
     {"name":"vc_opposite_item","type":"string"},
     {"name":"l_virtual_key","type":"bigint"},
     {"name":"vc_timestamp","type":"string"},
     {"name":"l_code_min_length","type":"int"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
