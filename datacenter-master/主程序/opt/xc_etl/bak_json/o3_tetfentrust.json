{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": ["select l_date, l_etfentrust_serial_no, l_entrust_serial_no, l_fund_id, l_basecombi_id, c_market_no, vc_stockholder_id, vc_report_seat, vc_report_code, vc_realdeal_code, c_stock_type, c_entrust_direction, l_report_id, l_entrust_time, l_entrust_amount, en_entrust_price, en_price_ratio, l_total_amount, en_total_balance, en_fare, l_operator_no, c_entrust_status, l_org_id, l_dept_id, en_discount_price_ratio from ${srcoradbname}.tetfentrust "],
                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://${tgrhdfsurl}",
            "fileType": "orc",
            "haveKerberos":"${haveKerberos}",
            "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
            "kerberosPrincipal":"${kerberosPrincipal}",
            "path": "${tgrhivedbpath}/o3_tetfentrust",
            "fileName": "o3_tetfentrust",
            "column": [
              {"name":"l_date","type":"bigint"},
              {"name":"l_etfentrust_serial_no","type":"bigint"},
              {"name":"l_entrust_serial_no","type":"bigint"},
              {"name":"l_fund_id","type":"bigint"},
              {"name":"l_basecombi_id","type":"bigint"},
              {"name":"c_market_no","type":"string"},
              {"name":"vc_stockholder_id","type":"string"},
              {"name":"vc_report_seat","type":"string"},
              {"name":"vc_report_code","type":"string"},
              {"name":"vc_realdeal_code","type":"string"},
              {"name":"c_stock_type","type":"string"},
              {"name":"c_entrust_direction","type":"string"},
              {"name":"l_report_id","type":"bigint"},
              {"name":"l_entrust_time","type":"bigint"},
              {"name":"l_entrust_amount","type":"bigint"},
              {"name":"en_entrust_price","type":"double"},
              {"name":"en_price_ratio","type":"double"},
              {"name":"l_total_amount","type":"bigint"},
              {"name":"en_total_balance","type":"double"},
              {"name":"en_fare","type":"double"},
              {"name":"l_operator_no","type":"bigint"},
              {"name":"c_entrust_status","type":"string"},
              {"name":"l_org_id","type":"bigint"},
              {"name":"l_dept_id","type":"bigint"},
              {"name":"en_discount_price_ratio","type":"double"}
            ],
            "writeMode": "append",
            "fieldDelimiter": "\t",
            "encoding":"utf-8"
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
      }
    }
  }
}