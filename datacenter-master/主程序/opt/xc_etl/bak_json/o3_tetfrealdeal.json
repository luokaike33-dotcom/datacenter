{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": ["select l_date,l_realdeal_serial_no,l_entrust_serial_no,l_fund_id,l_basecombi_id,c_market_no,vc_stockholder_id,vc_report_seat,vc_report_code,vc_realdeal_code,c_stock_type,c_entrust_direction,l_report_id,l_business_time,l_deal_amount,en_deal_price,c_match_status,c_type,en_deal_balance,en_fee,vc_report_direction,vc_deal_no,c_exec_type,c_invest_type from ${srcoradbname}.thisetfrealdeal"],
                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://${tgrhdfsurl}",
            "fileType": "orc",
            "haveKerberos":"${haveKerberos}",
            "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
            "kerberosPrincipal":"${kerberosPrincipal}",
            "path": "${tgrhivedbpath}/o3_tetfrealdeal",
            "fileName": "o3_tetfrealdeal",
            "column": [
              {"name":"l_date","type":"bigint"},
              {"name":"l_realdeal_serial_no","type":"bigint"},
              {"name":"l_entrust_serial_no","type":"bigint"},
              {"name":"l_fund_id","type":"bigint"},
              {"name":"l_basecombi_id","type":"bigint"},
              {"name":"c_market_no","type":"string"},
              {"name":"vc_stockholder_id","type":"string"},
              {"name":"vc_report_seat","type":"string"},
              {"name":"vc_report_code","type":"string"},
              {"name":"vc_realdeal_code","type":"string"},
              {"name":"c_stock_type","type":"string"},
              {"name":"c_entrust_direction","type":"string"},
              {"name":"l_report_id","type":"bigint"},
              {"name":"l_business_time","type":"bigint"},
              {"name":"l_deal_amount","type":"bigint"},
              {"name":"en_deal_price","type":"double"},
              {"name":"c_match_status","type":"string"},
              {"name":"c_type","type":"string"},
              {"name":"en_deal_balance","type":"double"},
              {"name":"en_fee","type":"double"},
              {"name":"vc_report_direction","type":"string"},
              {"name":"vc_deal_no","type":"string"},
              {"name":"c_exec_type","type":"string"},
              {"name":"c_invest_type","type":"string"}
            ],
            "writeMode": "append",
            "fieldDelimiter": "\t"
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
      }
    }
  }
}