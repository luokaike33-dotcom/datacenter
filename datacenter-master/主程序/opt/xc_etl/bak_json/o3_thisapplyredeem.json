{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": ["select l_date, vc_busin_flag, l_trade_date, l_complete_date, l_fund_id, l_serial_no, en_shares, en_balance, c_subject_flag, c_forzen_flag, en_frozen_balance, c_deal_flag, vc_currency_no, en_unit_dividends, vc_original_busin_flag, vc_agency, en_fee, en_fee_jy, en_fee_gh, en_fee_yh, en_fee_hs, en_fee_qt, en_fee_gjjzc, vc_asset_no from ${srcoradbname}.thisapplyredeem where l_date = ${p_dt}"],
                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://${tgrhdfsurl}",
            "fileType": "orc",
            "haveKerberos":"${haveKerberos}",
            "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
            "kerberosPrincipal":"${kerberosPrincipal}",
            "path": "${tgrhivedbpath}/o3_thisapplyredeem/p_dt=${p_dt}",
            "fileName": "o3_thisapplyredeem",
            "column": [
              {"name":"l_date","type":"bigint"},
              {"name":"vc_busin_flag","type":"string"},
              {"name":"l_trade_date","type":"bigint"},
              {"name":"l_complete_date","type":"bigint"},
              {"name":"l_fund_id","type":"bigint"},
              {"name":"l_serial_no","type":"bigint"},
              {"name":"en_shares","type":"double"},
              {"name":"en_balance","type":"double"},
              {"name":"c_subject_flag","type":"string"},
              {"name":"c_forzen_flag","type":"string"},
              {"name":"en_frozen_balance","type":"double"},
              {"name":"c_deal_flag","type":"string"},
              {"name":"vc_currency_no","type":"string"},
              {"name":"en_unit_dividends","type":"double"},
              {"name":"vc_original_busin_flag","type":"string"},
              {"name":"vc_agency","type":"string"},
              {"name":"en_fee","type":"double"},
              {"name":"en_fee_jy","type":"double"},
              {"name":"en_fee_gh","type":"double"},
              {"name":"en_fee_yh","type":"double"},
              {"name":"en_fee_hs","type":"double"},
              {"name":"en_fee_qt","type":"double"},
              {"name":"en_fee_gjjzc","type":"double"},
              {"name":"vc_asset_no","type":"string"}
            ],
            "writeMode": "append",
            "fieldDelimiter": "\t"
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
      }
    }
  }
}
