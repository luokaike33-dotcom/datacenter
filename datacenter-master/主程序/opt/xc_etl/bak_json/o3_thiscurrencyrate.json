{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select l_date,vc_currency_source,vc_currency_target,en_bid_price,en_ask_price,en_mid_price,l_unit_amount,l_priority_level,vc_origin,en_direct_price,l_set_no,null as bath_dt,sysdate as data_ins_time,null as task_rs_id from ${srcoradbname}.thiscurrencyrate where l_date = ${p_dt}"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/o3_thiscurrencyrate/p_dt=${p_dt}",
                        "fileName": "o3_thiscurrencyrate",
                        "column": [
     {"name":"l_date","type":"bigint"},
     {"name":"vc_currency_source","type":"string"},
     {"name":"vc_currency_target","type":"string"},
     {"name":"en_bid_price","type":"double"},
     {"name":"en_ask_price","type":"double"},
     {"name":"en_mid_price","type":"double"},
     {"name":"l_unit_amount","type":"bigint"},
     {"name":"l_priority_level","type":"bigint"},
     {"name":"vc_origin","type":"string"},
     {"name":"en_direct_price","type":"double"},
     {"name":"l_set_no","type":"bigint"},
     {"name":"bath_dt","type":"string"},
     {"name":"data_ins_time","type":"timestamp"},
     {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
