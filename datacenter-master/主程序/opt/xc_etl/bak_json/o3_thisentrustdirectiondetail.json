{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": ["SELECT C_MARKET_NO, C_ENTRUST_DIRECTION, C_PRICE_TYPE, VC_PRICE_NAME, VC_REPORT_DIRECTION, VC_REPORT_FLAG, EN_REPORT_PRICE, C_BRANCH_PRICE_TYPE, C_LIMIT_PRICE, VC_VALID_TYPE, VC_MSGTYPE, C_TIMEINFORCE, C_ORDTYPE, L_MAXPRICELEVELS, VC_APPLID, C_PLATFORM_TYPE, VC_BINARY_MSGTYPE, VC_STOCK_TYPE from ${srcoradbname}.thisentrustdirectiondetail"],
                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://${tgrhdfsurl}",
            "fileType": "orc",
            "haveKerberos":"${haveKerberos}",
            "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
            "kerberosPrincipal":"${kerberosPrincipal}",
            "path": "${tgrhivedbpath}/o3_thisentrustdirectiondetail",
            "fileName": "o3_thisentrustdirectiondetail",
            "column": [
					{"name":"c_market_no","type":"string"}
                    {"name":"c_entrust_direction","type":"string"}
                    {"name":"c_price_type","type":"string"}
                    {"name":"vc_price_name","type":"string"}
                    {"name":"vc_report_direction","type":"string"}
                    {"name":"vc_report_flag","type":"string"}
                    {"name":"en_report_price","type":"double"}
                    {"name":"c_branch_price_type","type":"string"}
                    {"name":"c_limit_price","type":"string"}
                    {"name":"vc_valid_type","type":"string"}
                    {"name":"vc_msgtype","type":"string"}
                    {"name":"c_timeinforce","type":"string"}
                    {"name":"c_ordtype","type":"string"}
                    {"name":"l_maxpricelevels","type":"double"}
                    {"name":"vc_applid","type":"string"}
                    {"name":"c_platform_type","type":"string"}
                    {"name":"vc_binary_msgtype","type":"string"}
                    {"name":"vc_stock_type","type":"string"}
            ],
            "writeMode": "append",
            "fieldDelimiter": "\t",
            "encoding":"utf-8"
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
      }
    }
  }
}