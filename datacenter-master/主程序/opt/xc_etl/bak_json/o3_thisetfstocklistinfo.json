{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": ["select l_date, c_market_no, vc_report_code, vc_stock_code, l_stock_amount, c_cash_type, en_price_ratio, en_purchase_balance, en_redeem_balance, vc_stock_name, c_exec_type, vc_timestamp, l_virtual_key, en_discount_price_ratio, l_redeem_stock_amount, c_redeem_cash_type, en_face_balance, en_full_price, en_redeem_face_balance, en_redeem_full_price from ${srcoradbname}.thisetfstocklistinfo where l_date = ${p_dt}"],
                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://${tgrhdfsurl}",
            "fileType": "orc",
            "haveKerberos":"${haveKerberos}",
            "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
            "kerberosPrincipal":"${kerberosPrincipal}",
            "path": "${tgrhivedbpath}/o3_thisetfstocklistinfo/p_dt=${p_dt}",
            "fileName": "o3_thisetfstocklistinfo",
            "column": [
                   {"name":"l_date","type":"bigint"},
                   {"name":"c_market_no","type":"string"},
                   {"name":"vc_report_code","type":"string"},
                   {"name":"vc_stock_code","type":"string"},
                   {"name":"l_stock_amount","type":"bigint"},
                   {"name":"c_cash_type","type":"string"},
                   {"name":"en_price_ratio","type":"double"},
                   {"name":"en_purchase_balance","type":"double"},
                   {"name":"en_redeem_balance","type":"double"},
                   {"name":"vc_stock_name","type":"string"},
                   {"name":"c_exec_type","type":"string"},
                   {"name":"vc_timestamp","type":"string"},
                   {"name":"l_virtual_key","type":"bigint"},
                   {"name":"en_discount_price_ratio","type":"double"},
                   {"name":"l_redeem_stock_amount","type":"double"},
                   {"name":"c_redeem_cash_type","type":"string"},
                   {"name":"en_face_balance","type":"double"},
                   {"name":"en_full_price","type":"double"},
                   {"name":"en_redeem_face_balance","type":"double"},
                   {"name":"en_redeem_full_price","type":"double"}
            ],
            "writeMode": "append",
            "fieldDelimiter": "\t",
            "encoding":"utf-8"
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
      }
    }
  }
}