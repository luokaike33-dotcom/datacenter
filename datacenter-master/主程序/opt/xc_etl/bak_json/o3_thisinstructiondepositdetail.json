{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["SELECT l_date, l_daily_instruction_no, l_index_daily_modify, vc_inter_no, vc_account_no, vc_account_name, vc_place, l_bank, vc_minor_bank, vc_deposit_owner, en_rate, l_limit_time, vc_remark, l_fund_id, l_notify_days, l_draw_date, c_draw_type, l_notify_date, l_deposit_confirm_no, l_confirm_no, l_interest_start_date, c_auto_redeposit, c_interest_deposit, vc_receipt_no, c_interest_pay_type, c_deposit_type, vc_provincecode, vc_cityno, l_basecombi_id, c_advance_limit_flag, en_advance_rate, c_limit_unit, l_payback_count, l_interest_received_date, en_supposed_interest, en_punitive_balance, l_first_clear_date, l_account_id, vc_bank_branch_code from ${srcoradbname}.thisinstructiondepositdetail where l_date = ${p_dt}"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/o3_thisinstructiondepositdetail/p_dt=${p_dt}",
                        "fileName": "o3_thisinstructiondepositdetail",
                        "column": [
            {"name":"l_date","type":"bigint"},
            {"name":"l_daily_instruction_no","type":"bigint"},
            {"name":"l_index_daily_modify","type":"bigint"},
            {"name":"vc_inter_no","type":"string"},
            {"name":"vc_account_no","type":"string"},
            {"name":"vc_account_name","type":"string"},
            {"name":"vc_place","type":"string"},
            {"name":"l_bank","type":"bigint"},
            {"name":"vc_minor_bank","type":"string"},
            {"name":"vc_deposit_owner","type":"string"},
            {"name":"en_rate","type":"double"},
            {"name":"l_limit_time","type":"bigint"},
            {"name":"vc_remark","type":"string"},
            {"name":"l_fund_id","type":"bigint"},
            {"name":"l_notify_days","type":"bigint"},
            {"name":"l_draw_date","type":"bigint"},
            {"name":"c_draw_type","type":"string"},
            {"name":"l_notify_date","type":"bigint"},
            {"name":"l_deposit_confirm_no","type":"bigint"},
            {"name":"l_confirm_no","type":"bigint"},
            {"name":"l_interest_start_date","type":"bigint"},
            {"name":"c_auto_redeposit","type":"string"},
            {"name":"c_interest_deposit","type":"string"},
            {"name":"vc_receipt_no","type":"string"},
            {"name":"c_interest_pay_type","type":"string"},
            {"name":"c_deposit_type","type":"string"},
            {"name":"vc_provincecode","type":"string"},
            {"name":"vc_cityno","type":"string"},
            {"name":"l_basecombi_id","type":"bigint"},
            {"name":"c_advance_limit_flag","type":"string"},
            {"name":"en_advance_rate","type":"double"},
            {"name":"c_limit_unit","type":"string"},
            {"name":"l_payback_count","type":"bigint"},
            {"name":"l_interest_received_date","type":"bigint"},
            {"name":"en_supposed_interest","type":"double"},
            {"name":"en_punitive_balance","type":"double"},
            {"name":"l_first_clear_date","type":"bigint"},
            {"name":"l_account_id","type":"bigint"},
            {"name":"vc_bank_branch_code","type":"string"}

                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}

