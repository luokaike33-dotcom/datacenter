{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": ["select l_date, l_daily_instruction_no, l_index_daily_modify, l_fund_id, l_basecombi_id, c_invest_type, vc_inter_code, en_ratio, l_mortagage_amount, l_deal_mortagage_amount, c_mortagage_side, c_bail_type, l_asset_id, c_multi_ins_relate_flag, l_entr_mortagage_amount, en_hg_balance, c_effect_status, c_judge_available, l_old_mortagage_amount from ${srcoradbname}.thisinstructionhgmortagage where l_date = ${p_dt}"],
                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://${tgrhdfsurl}",
            "fileType": "orc",
            "haveKerberos":"${haveKerberos}",
            "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
            "kerberosPrincipal":"${kerberosPrincipal}",
            "path": "${tgrhivedbpath}/o3_thisinstructionhgmortagage/p_dt=${p_dt}",
            "fileName": "o3_thisinstructionhgmortagage",
            "column": [
                {"name":"l_date","type":"bigint"},
                {"name":"l_daily_instruction_no","type":"bigint"},
                {"name":"l_index_daily_modify","type":"bigint"},
                {"name":"l_fund_id","type":"bigint"},
                {"name":"l_basecombi_id","type":"bigint"},
                {"name":"c_invest_type","type":"string"},
                {"name":"vc_inter_code","type":"string"},
                {"name":"en_ratio","type":"double"},
                {"name":"l_mortagage_amount","type":"double"},
                {"name":"l_deal_mortagage_amount","type":"bigint"},
                {"name":"c_mortagage_side","type":"string"},
                {"name":"c_bail_type","type":"string"},
                {"name":"l_asset_id","type":"bigint"},
                {"name":"c_multi_ins_relate_flag","type":"string"},
                {"name":"l_entr_mortagage_amount","type":"bigint"},
                {"name":"en_hg_balance","type":"double"},
                {"name":"c_effect_status","type":"string"},
                {"name":"c_judge_available","type":"string"},
                {"name":"l_old_mortagage_amount","type":"double"}
            ],
            "writeMode": "append",
            "fieldDelimiter": "\t",
            "encoding":"utf-8"
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
      }
    }
  }
}