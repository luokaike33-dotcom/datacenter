{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": [
                  "select l_date, l_unit_id, l_basecombi_id, l_fund_id, c_invest_type, vc_bind_seat, vc_stockholder_id, vc_inter_code, c_market_no, l_begin_amount, l_current_amount, l_frozen_amount, l_unfrozen_amount, l_buy_amount, l_sale_amount, l_prebuy_amount, l_presale_amount, l_temp_frozen_amount, l_temp_unfrozen_amount, l_t1_temp_frozen_amount, l_t1_frozen_amount, en_buy_balance, en_sale_balance, en_buy_fee, en_sale_fee, en_untransfered_invest, en_interest_invest, en_accumulate_profit, en_turn_invest, en_turn_interest_invest, en_turn_profit, l_asset_id, l_buy_unsettle_amount, l_sale_unsettle_amount, en_buy_unsettle_balance, en_sale_unsettle_balance, en_today_profit, en_current_cost, c_position_flag, en_trade_balance, en_real_buy_fee, en_real_sale_fee, en_real_cost, en_uncarryover_real_cost, en_net_gain, en_uncarryover_net_gain, en_uncarryover_dividend, en_dividend, en_trading_fee, en_uncarryover_trading_fee, en_interest_profit, en_turn_interest_profit, en_beginyear_turn_profit, en_beginyear_unturn_profit, to_char(sysdate-1,'yyyymmdd') as bath_dt, cast(sysdate as timestamp) as data_ins_time, 'o3_thissubjectstock.json' AS task_rs_id from ${srcoradbname}.thissubjectstock where l_date = ${p_dt}"
                ],
                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://${tgrhdfsurl}",
            "fileType": "orc",
            "haveKerberos": "${haveKerberos}",
            "kerberosKeytabFilePath": "${kbsfilepath}",
            "kerberosPrincipal": "${kbsprincipal}",
            "path": "${tgrhivedbpath}/o3_thissubjectstock/p_dt=${p_dt}",
            "fileName": "o3_thissubjectstock",
            "column": [
              {"name": "l_date","type": "bigint"},
              {"name": "l_unit_id","type": "bigint"},
              {"name": "l_basecombi_id","type": "bigint"},
              {"name": "l_fund_id","type": "bigint"},
              {"name": "c_invest_type","type": "string"},
              {"name": "vc_bind_seat","type": "string"},
              {"name": "vc_stockholder_id","type": "string"},
              {"name": "vc_inter_code","type": "string"},
              {"name": "c_market_no","type": "string"},
              {"name": "l_begin_amount","type": "double"},
              {"name": "l_current_amount","type": "double"},
              {"name": "l_frozen_amount","type": "double"},
              {"name": "l_unfrozen_amount","type": "double"},
              {"name": "l_buy_amount","type": "double"},
              {"name": "l_sale_amount","type": "double"},
              {"name": "l_prebuy_amount","type": "double"},
              {"name": "l_presale_amount","type": "double"},
              {"name": "l_temp_frozen_amount","type": "double"},
              {"name": "l_temp_unfrozen_amount","type": "double"},
              {"name": "l_t1_temp_frozen_amount","type": "double"},
              {"name": "l_t1_frozen_amount","type": "double"},
              {"name": "en_buy_balance","type": "double"},
              {"name": "en_sale_balance","type": "double"},
              {"name": "en_buy_fee","type": "double"},
              {"name": "en_sale_fee","type": "double"},
              {"name": "en_untransfered_invest","type": "double"},
              {"name": "en_interest_invest","type": "double"},
              {"name": "en_accumulate_profit","type": "double"},
              {"name": "en_turn_invest","type": "double"},
              {"name": "en_turn_interest_invest","type": "double"},
              {"name": "en_turn_profit","type": "double"},
              {"name": "l_asset_id","type": "bigint"},
              {"name": "l_buy_unsettle_amount","type": "double"},
              {"name": "l_sale_unsettle_amount","type": "double"},
              {"name": "en_buy_unsettle_balance","type": "double"},
              {"name": "en_sale_unsettle_balance","type": "double"},
              {"name": "en_today_profit","type": "double"},
              {"name": "en_current_cost","type": "double"},
              {"name": "c_position_flag","type": "string"},
              {"name": "en_trade_balance","type": "double"},
              {"name": "en_real_buy_fee","type": "double"},
              {"name": "en_real_sale_fee","type": "double"},
              {"name": "en_real_cost","type": "double"},
              {"name": "en_uncarryover_real_cost","type": "double"},
              {"name": "en_net_gain","type": "double"},
              {"name": "en_uncarryover_net_gain","type": "double"},
              {"name": "en_uncarryover_dividend","type": "double"},
              {"name": "en_dividend","type": "double"},
              {"name": "en_trading_fee","type": "double"},
              {"name": "en_uncarryover_trading_fee","type": "double"},
              {"name": "en_interest_profit","type": "double"},
              {"name": "en_turn_interest_profit","type": "double"},
              {"name": "en_beginyear_turn_profit","type": "double"},
              {"name": "en_beginyear_unturn_profit","type": "double"}
              {"name": "bath_dt","type": "string"},
              {"name": "data_ins_time","type": "string"},
              {"name": "task_rs_id","type": "string"},
            ],
            "writeMode": "append",
            "fieldDelimiter": "\t",
            "encoding": "utf-8"
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": "1"
      }
    },
    "errorLimit": {
      "record": "0",
      "percentage": "0"
    }
  }
}