{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": ["select l_operator_no, c_trade, c_free_entrust, l_dispense_order, l_instruction_count, vc_entrust_right from ${srcoradbname}.toptradeinfo "],
                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://${tgrhdfsurl}",
            "fileType": "orc",
            "haveKerberos":"${haveKerberos}",
            "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
            "kerberosPrincipal":"${kerberosPrincipal}",
            "path": "${tgrhivedbpath}/o3_toptradeinfo",
            "fileName": "o3_toptradeinfo",
            "column": [
              {"name":"l_operator_no","type":"bigint"},
              {"name":"c_trade","type":"string"},
              {"name":"c_free_entrust","type":"string"},
              {"name":"l_dispense_order","type":"bigint"},
              {"name":"l_instruction_count","type":"string"},
              {"name":"vc_entrust_right","type":"string"}
            ],
            "writeMode": "append",
            "fieldDelimiter": "\t",
            "encoding":"utf-8"
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
      }
    }
  }
}