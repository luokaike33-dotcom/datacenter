{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select l_serial_no,l_org_id ,vc_value ,vc_timestamp ,l_virtual_key  from ${srcoradbname}.torgsysparameter"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/o3_torgsysparameter", 
                        "fileName": "o3_torgsysparameter",
                        "column": [
     {"name":"l_serial_no","type":"int"},
                    {"name":"l_org_id","type":"int"},
                    {"name":"vc_value","type":"string"},
                    {"name":"vc_timestamp","type":"string"},
                    {"name":"l_virtual_key","type":"bigint"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
