{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": ["select vc_stockholder_id, c_market_no, l_open_date, c_stockholder_status, c_bind_status, vc_bind_seat, vc_stockholder_name, vc_permit_stock_types, vc_remarks, vc_fund_ids, vc_apply_quality, c_invest_type, c_apply_mode, c_credit_stockholder, vc_equ_stockholder, en_creditlimit_rz, en_creditlimit_rq, en_creditlimit, vc_rq_stockholder, vc_owner_type, vc_bpqz, l_default_combi, l_option_default_combi, l_virtual_key, vc_timestamp, l_org_id, c_allow_multi_apply, vc_market_remark, vc_old_bind_seat, en_again_coefficient, c_reduce_limit, l_modify_date from ${srcoradbname}.tstockholder "],
                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://${tgrhdfsurl}",
            "fileType": "orc",
            "haveKerberos":"${haveKerberos}",
            "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
            "kerberosPrincipal":"${kerberosPrincipal}",
            "path": "${tgrhivedbpath}/o3_tstockholder",
            "fileName": "o3_tstockholder",
            "column": [  
              {"name":"vc_stockholder_id","type":"string"},
              {"name":"c_market_no","type":"string"},
              {"name":"l_open_date","type":"bigint"},
              {"name":"c_stockholder_status","type":"string"},
              {"name":"c_bind_status","type":"string"},
              {"name":"vc_bind_seat","type":"string"},
              {"name":"vc_stockholder_name","type":"string"},
              {"name":"vc_permit_stock_types","type":"string"},
              {"name":"vc_remarks","type":"string"},
              {"name":"vc_fund_ids","type":"string"},
              {"name":"vc_apply_quality","type":"string"},
              {"name":"c_invest_type","type":"string"},
              {"name":"c_apply_mode","type":"string"},
              {"name":"c_credit_stockholder","type":"string"},
              {"name":"vc_equ_stockholder","type":"string"},
              {"name":"en_creditlimit_rz","type":"double"},
              {"name":"en_creditlimit_rq","type":"double"},
              {"name":"en_creditlimit","type":"double"},
              {"name":"vc_rq_stockholder","type":"string"},
              {"name":"vc_owner_type","type":"string"},
              {"name":"vc_bpqz","type":"string"},
              {"name":"l_default_combi","type":"bigint"},
              {"name":"l_option_default_combi","type":"bigint"},
              {"name":"l_virtual_key","type":"bigint"},
              {"name":"vc_timestamp","type":"string"},
              {"name":"l_org_id","type":"bigint"},
              {"name":"c_allow_multi_apply","type":"string"},
              {"name":"vc_market_remark","type":"string"},
              {"name":"vc_old_bind_seat","type":"string"},
              {"name":"en_again_coefficient","type":"double"},
              {"name":"c_reduce_limit","type":"string"},
              {"name":"l_modify_date","type":"bigint"}
            ],
            "writeMode": "append",
            "fieldDelimiter": "\t",
            "encoding":"utf-8"
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
      }
    }
  }
}