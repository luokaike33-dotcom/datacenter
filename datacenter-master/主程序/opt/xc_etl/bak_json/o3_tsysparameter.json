{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["SELECT C_SYSNAME, L_SERIAL_NO, L_SWITCH_NO1, L_SWITCH_NO2, L_SWITCH_NO3, VC_DESCRIBE, C_TYPE, VC_VALUE_BOUND, C_MULTI, VC_VALUE, VC_SHOW_TITLE, VC_SHOW_SUBTITLE, L_ORDER, C_ALIGN, C_MODIFY, C_CRYPTFLAG, VC_FULL_DESCRIBE, C_ISNULL, L_ADD_DATE, VC_TIMESTAMP, C_ALLOW_SUBORG_MODIFY, C_LOWEST_LAYER, VC_DLL_NAME, VC_FUNC_NAME from ${srcoradbname}.TSYSPARAMETER"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/o3_tsysparameter", 
                        "fileName": "o3_tsysparameter",
                        "column": [
     {"name":"c_sysname","type":"string"},
                     {"name":"l_serial_no","type":"int"},
                     {"name":"l_switch_no1","type":"int"},
                     {"name":"l_switch_no2","type":"int"},
                     {"name":"l_switch_no3","type":"int"},
                     {"name":"vc_describe","type":"string"},
                     {"name":"c_type","type":"string"},
                     {"name":"vc_value_bound","type":"string"},
                     {"name":"c_multi","type":"string"},
                     {"name":"vc_value","type":"string"},
                     {"name":"vc_show_title","type":"string"},
                     {"name":"vc_show_subtitle","type":"string"},
                     {"name":"l_order","type":"int"},
                     {"name":"c_align","type":"string"},
                     {"name":"c_modify","type":"string"},
                     {"name":"c_cryptflag","type":"string"},
                     {"name":"vc_full_describe","type":"string"},
                     {"name":"c_isnull","type":"string"},
                     {"name":"l_add_date","type":"int"},
                     {"name":"vc_timestamp","type":"string"},
                     {"name":"c_allow_suborg_modify","type":"string"},
                     {"name":"c_lowest_layer","type":"string"},
                     {"name":"vc_dll_name","type":"string"},
                     {"name":"vc_func_name","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
