{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      reportperiod,
                                      indexcode,
                                      fundcode,
                                      weight,
                                      srcsys,
                                      inserttime,
                                      updatetime,
                                      batchno,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'funds_fund_index_weight.json' as task_rs_id
                                from ${srcoradbname}.funds_fund_index_weight"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${is_kbs}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/funds_fund_index_weight",
                        "fileName": "funds_fund_index_weight",
                        "column": [
                                      {"name":"reportperiod","type":"bigint"},
                                      {"name":"indexcode","type":"string"},
                                      {"name":"fundcode","type":"string"},
                                      {"name":"weight","type":"double"},
                                      {"name":"srcsys","type":"string"},
                                      {"name":"inserttime","type":"timestamp"},
                                      {"name":"updatetime","type":"timestamp"},
                                      {"name":"batchno","type":"bigint"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}