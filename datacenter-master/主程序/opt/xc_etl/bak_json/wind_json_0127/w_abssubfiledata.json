{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,
													s_info_windcode,
													yield_min,
													yield_max,
													s_info_compcode,
													b_anal_ptmyear,
													basic_assets,
													mobile_places,
													product_compname,
													start_date,
													end_date,
													product_manager,
													bookkeeping_manager,
													subdivide_code,
													intex_name,
													intex_code,
													intex_rate,
													repay_typecode,
													opdate,
													opmode,
                          to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                          cast(sysdate as timestamp) as data_ins_time,
                          'w_accountrelatedwithbondissue.json' as task_rs_id from ${srcoradbname}.abssubfiledata"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_abssubfiledata",
                        "fileName": "w_abssubfiledata",
                        "column": [
                        {"name":"object_id","type":"STRING"},
						{"name":"s_info_windcode","type":"STRING"},
						{"name":"yield_min","type":"DOUBLE"},
						{"name":"yield_max","type":"DOUBLE"},
						{"name":"s_info_compcode","type":"STRING"},
						{"name":"b_anal_ptmyear","type":"DOUBLE"},
						{"name":"basic_assets","type":"STRING"},
						{"name":"mobile_places","type":"STRING"},
						{"name":"product_compname","type":"STRING"},
						{"name":"start_date","type":"STRING"},
						{"name":"end_date","type":"STRING"},
						{"name":"product_manager","type":"STRING"},
						{"name":"bookkeeping_manager","type":"STRING"},
						{"name":"subdivide_code","type":"DOUBLE"},
						{"name":"intex_name","type":"STRING"},
						{"name":"intex_code","type":"STRING"},
						{"name":"intex_rate","type":"STRING"},
						{"name":"repay_typecode","type":"DOUBLE"},
						{"name":"opdate","type":"DATE"},
						{"name":"opmode","type":"STRING"},
            {"name":"bath_dt","type":"string"},
            {"name":"data_ins_time","type":"timestamp"},
            {"name":"task_rs_id","type":"string"}                                   
						],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
