{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      trade_dt,
                                      dealnum_total,
                                      open_auction_price,
                                      open_auction_volume,
                                      open_auction_dealnum,
                                      maxup,
                                      maxdown,
                                      close_auction_price,
                                      close_auction_volume,
                                      close_auction_dealnum,
                                      ask_size_volume,
                                      bid_size_volume,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_ashareauction.json' as task_rs_id
                                from ${srcoradbname}.ashareauction WHERE trade_dt BETWEEN '${busi_month}'||'01' AND to_char(add_months(to_date('${busi_month}'||'01','yyyyMMdd'),1)-1,'yyyyMMdd') "],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_ashareauction/busi_month=${busi_month}",
                        "fileName": "w_ashareauction",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"trade_dt","type":"string"},
                                      {"name":"dealnum_total","type":"bigint"},
                                      {"name":"open_auction_price","type":"double"},
                                      {"name":"open_auction_volume","type":"double"},
                                      {"name":"open_auction_dealnum","type":"double"},
                                      {"name":"maxup","type":"double"},
                                      {"name":"maxdown","type":"double"},
                                      {"name":"close_auction_price","type":"double"},
                                      {"name":"close_auction_volume","type":"double"},
                                      {"name":"close_auction_dealnum","type":"double"},
                                      {"name":"ask_size_volume","type":"double"},
                                      {"name":"bid_size_volume","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}