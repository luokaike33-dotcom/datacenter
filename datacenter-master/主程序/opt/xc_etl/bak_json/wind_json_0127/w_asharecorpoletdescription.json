{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      s_info_windcode,
                                      s_info_compcode,
                                      letters_event_id,
                                      letters_department,
                                      letters_department_id,
                                      letters_number,
                                      letters_title,
                                      letters_type_code,
                                      letters_ann_dt,
                                      request_date,
                                      extension_reply_date,
                                      is_extension_reply,
                                      reply_annoucement_date,
                                      supplementary_date,
                                      extension_reply_adate,
                                      object_id,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_asharecorpoletdescription.json' as task_rs_id
                                from ${srcoradbname}.asharecorpoletdescription"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_asharecorpoletdescription",
                        "fileName": "w_asharecorpoletdescription",
                        "column": [
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"letters_event_id","type":"string"},
                                      {"name":"letters_department","type":"string"},
                                      {"name":"letters_department_id","type":"string"},
                                      {"name":"letters_number","type":"string"},
                                      {"name":"letters_title","type":"string"},
                                      {"name":"letters_type_code","type":"bigint"},
                                      {"name":"letters_ann_dt","type":"string"},
                                      {"name":"request_date","type":"string"},
                                      {"name":"extension_reply_date","type":"string"},
                                      {"name":"is_extension_reply","type":"bigint"},
                                      {"name":"reply_annoucement_date","type":"string"},
                                      {"name":"supplementary_date","type":"string"},
                                      {"name":"extension_reply_adate","type":"string"},
                                      {"name":"object_id","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}