{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_compcode,
                                      financing_events_type,
                                      money_raised_amount,
                                      non_currency_raise_amount,
                                      issue_cost,
                                      actual_fundraising_amount,
                                      currency_code,
                                      ann_date,
                                      item_number,
                                      investment_projects,
                                      plan_invest,
                                      issuer_plan_invest,
                                      issuer_plan_funds_investment,
                                      funds_has_invested,
                                      is_change,
                                      new_ann_date,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_asharefundusing.json' as task_rs_id
                                from ${srcoradbname}.asharefundusing"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_asharefundusing",
                        "fileName": "w_asharefundusing",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"financing_events_type","type":"string"},
                                      {"name":"money_raised_amount","type":"double"},
                                      {"name":"non_currency_raise_amount","type":"double"},
                                      {"name":"issue_cost","type":"double"},
                                      {"name":"actual_fundraising_amount","type":"double"},
                                      {"name":"currency_code","type":"string"},
                                      {"name":"ann_date","type":"string"},
                                      {"name":"item_number","type":"string"},
                                      {"name":"investment_projects","type":"string"},
                                      {"name":"plan_invest","type":"double"},
                                      {"name":"issuer_plan_invest","type":"double"},
                                      {"name":"issuer_plan_funds_investment","type":"double"},
                                      {"name":"funds_has_invested","type":"double"},
                                      {"name":"is_change","type":"bigint"},
                                      {"name":"new_ann_date","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}