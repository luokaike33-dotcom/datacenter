{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,wind_code,s_info_windcode,citics_ind_code,entry_dt,remove_dt,cur_sign,opdate,opmode from ${srcoradbname}.ashareindustriesclasscitics"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_ashareindustriesclasscitics",
                        "fileName": "w_ashareindustriesclasscitics",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"wind_code","type":"string"},
                            {"name":"s_info_windcode","type":"string"},
                            {"name":"citics_ind_code","type":"string"},
                            {"name":"entry_dt","type":"string"},
                            {"name":"remove_dt","type":"string"},
                            {"name":"cur_sign","type":"string"},
                            {"name":"opdate","type":"date"},
                            {"name":"opmode","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
