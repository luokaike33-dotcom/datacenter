{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      related_manager_name,
                                      reported_trader_name,
                                      change_volume,
                                      trade_avg_price,
                                      position_after_trade,
                                      trade_dt,
                                      ann_dt,
                                      trade_reason_code,
                                      related_manager_post,
                                      trader_manager_relation,
                                      actual_ann_dt,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_ashareinsidertrade.json' as task_rs_id
                                from ${srcoradbname}.ashareinsidertrade"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_ashareinsidertrade",
                        "fileName": "w_ashareinsidertrade",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"related_manager_name","type":"string"},
                                      {"name":"reported_trader_name","type":"string"},
                                      {"name":"change_volume","type":"double"},
                                      {"name":"trade_avg_price","type":"double"},
                                      {"name":"position_after_trade","type":"double"},
                                      {"name":"trade_dt","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"trade_reason_code","type":"bigint"},
                                      {"name":"related_manager_post","type":"string"},
                                      {"name":"trader_manager_relation","type":"string"},
                                      {"name":"actual_ann_dt","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}