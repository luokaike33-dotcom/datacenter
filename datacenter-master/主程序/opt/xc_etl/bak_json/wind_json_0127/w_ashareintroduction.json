{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      s_info_province,
                                      s_info_city,
                                      s_info_chairman,
                                      s_info_president,
                                      s_info_bdsecretary,
                                      s_info_regcapital,
                                      s_info_founddate,
                                      s_info_chineseintroduction,
                                      s_info_comptype,
                                      s_info_website,
                                      s_info_email,
                                      s_info_office,
                                      ann_dt,
                                      s_info_country,
                                      s_info_businessscope,
                                      s_info_company_type,
                                      s_info_totalemployees,
                                      s_info_main_business,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_ashareintroduction.json' as task_rs_id
                                from ${srcoradbname}.ashareintroduction"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_ashareintroduction",
                        "fileName": "w_ashareintroduction",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"s_info_province","type":"string"},
                                      {"name":"s_info_city","type":"string"},
                                      {"name":"s_info_chairman","type":"string"},
                                      {"name":"s_info_president","type":"string"},
                                      {"name":"s_info_bdsecretary","type":"string"},
                                      {"name":"s_info_regcapital","type":"double"},
                                      {"name":"s_info_founddate","type":"string"},
                                      {"name":"s_info_chineseintroduction","type":"string"},
                                      {"name":"s_info_comptype","type":"string"},
                                      {"name":"s_info_website","type":"string"},
                                      {"name":"s_info_email","type":"string"},
                                      {"name":"s_info_office","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"s_info_country","type":"string"},
                                      {"name":"s_info_businessscope","type":"string"},
                                      {"name":"s_info_company_type","type":"string"},
                                      {"name":"s_info_totalemployees","type":"bigint"},
                                      {"name":"s_info_main_business","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}