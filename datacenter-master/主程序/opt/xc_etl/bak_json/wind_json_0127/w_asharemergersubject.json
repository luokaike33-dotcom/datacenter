{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_compcode,
                                      s_info_dimension,
                                      s_info_dimension1,
                                      s_info_comp_name,
                                      s_info_comp_sname,
                                      s_info_compcode1,
                                      s_info_progress,
                                      s_update_date,
                                      s_meetevent_id,
                                      s_info_comp_name1,
                                      s_info_comp_sname1,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_asharemergersubject.json' as task_rs_id
                                from ${srcoradbname}.asharemergersubject"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_asharemergersubject",
                        "fileName": "w_asharemergersubject",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"s_info_dimension","type":"string"},
                                      {"name":"s_info_dimension1","type":"string"},
                                      {"name":"s_info_comp_name","type":"string"},
                                      {"name":"s_info_comp_sname","type":"string"},
                                      {"name":"s_info_compcode1","type":"string"},
                                      {"name":"s_info_progress","type":"string"},
                                      {"name":"s_update_date","type":"string"},
                                      {"name":"s_meetevent_id","type":"string"},
                                      {"name":"s_info_comp_name1","type":"string"},
                                      {"name":"s_info_comp_sname1","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}