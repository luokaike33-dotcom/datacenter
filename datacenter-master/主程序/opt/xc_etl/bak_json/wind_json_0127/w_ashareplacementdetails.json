{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,s_holder_name,s_holder_typecode,s_holder_type,typeofinvestor,ordqty,placement,trade_dt,ann_dt,lockmonth,tradable_dt,ann_ordqty,is_seooripo,latest_own_qty,s_info_compcode,placement_financing,placement_currency,placement_non_currency,meetevent_id,s_share_lsttypename from ${srcoradbname}.ashareplacementdetails"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_ashareplacementdetails",
                        "fileName": "w_ashareplacementdetails",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"s_info_windcode","type":"string"},
                            {"name":"s_holder_name","type":"string"},
                            {"name":"s_holder_typecode","type":"double"},
                            {"name":"s_holder_type","type":"string"},
                            {"name":"typeofinvestor","type":"string"},
                            {"name":"ordqty","type":"double"},
                            {"name":"placement","type":"double"},
                            {"name":"trade_dt","type":"string"},
                            {"name":"ann_dt","type":"string"},
                            {"name":"lockmonth","type":"double"},
                            {"name":"tradable_dt","type":"string"},
                            {"name":"ann_ordqty","type":"double"},
                            {"name":"is_seooripo","type":"double"},
                            {"name":"latest_own_qty","type":"double"},
                            {"name":"s_info_compcode","type":"string"},
                            {"name":"placement_financing","type":"double"},
                            {"name":"placement_currency","type":"double"},
                            {"name":"placement_non_currency","type":"double"},
                            {"name":"meetevent_id","type":"string"},
                            {"name":"s_share_lsttypename","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
