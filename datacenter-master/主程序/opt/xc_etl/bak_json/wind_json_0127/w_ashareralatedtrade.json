{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      ann_dt,
                                      s_relatedtrade_name,
                                      s_relatedtrade_relationcode,
                                      s_relatedtrade_control,
                                      s_relatedtrade_tradetype,
                                      s_relatedtrade_settletype,
                                      crncy_code,
                                      s_relatedtrade_amount,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_ashareralatedtrade.json' as task_rs_id
                                from ${srcoradbname}.ashareralatedtrade"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_ashareralatedtrade",
                        "fileName": "w_ashareralatedtrade",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"s_relatedtrade_name","type":"string"},
                                      {"name":"s_relatedtrade_relationcode","type":"string"},
                                      {"name":"s_relatedtrade_control","type":"bigint"},
                                      {"name":"s_relatedtrade_tradetype","type":"string"},
                                      {"name":"s_relatedtrade_settletype","type":"string"},
                                      {"name":"crncy_code","type":"string"},
                                      {"name":"s_relatedtrade_amount","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}