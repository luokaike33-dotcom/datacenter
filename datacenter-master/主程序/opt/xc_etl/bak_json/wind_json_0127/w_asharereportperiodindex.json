{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_compcode,
                                      ann_date,
                                      end_date,
                                      s_ft_bps,
                                      s_bps_change_reason,
                                      s_cap_rsrv,
                                      s_cap_rsrv_change_reason,
                                      s_undistributedps,
                                      s_change_reason,
                                      memo,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_asharereportperiodindex.json' as task_rs_id
                                from ${srcoradbname}.asharereportperiodindex"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_asharereportperiodindex",
                        "fileName": "w_asharereportperiodindex",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"ann_date","type":"string"},
                                      {"name":"end_date","type":"string"},
                                      {"name":"s_ft_bps","type":"double"},
                                      {"name":"s_bps_change_reason","type":"string"},
                                      {"name":"s_cap_rsrv","type":"double"},
                                      {"name":"s_cap_rsrv_change_reason","type":"string"},
                                      {"name":"s_undistributedps","type":"double"},
                                      {"name":"s_change_reason","type":"string"},
                                      {"name":"memo","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}