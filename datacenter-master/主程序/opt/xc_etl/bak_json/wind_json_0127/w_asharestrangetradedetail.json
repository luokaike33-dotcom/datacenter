{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      type_code,
                                      start_dt,
                                      end_dt,
                                      volume,
                                      amount,
                                      pctchange,
                                      change_deviation,
                                      swing,
                                      turn,
                                      change_deviation_3d,
                                      turn_3d,
                                      turn_3dto5d,
                                      margin_pct,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_asharestrangetradedetail.json' as task_rs_id
                                from ${srcoradbname}.asharestrangetradedetail"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_asharestrangetradedetail",
                        "fileName": "w_asharestrangetradedetail",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"type_code","type":"string"},
                                      {"name":"start_dt","type":"string"},
                                      {"name":"end_dt","type":"string"},
                                      {"name":"volume","type":"double"},
                                      {"name":"amount","type":"double"},
                                      {"name":"pctchange","type":"double"},
                                      {"name":"change_deviation","type":"double"},
                                      {"name":"swing","type":"double"},
                                      {"name":"turn","type":"double"},
                                      {"name":"change_deviation_3d","type":"double"},
                                      {"name":"turn_3d","type":"double"},
                                      {"name":"turn_3dto5d","type":"double"},
                                      {"name":"margin_pct","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}