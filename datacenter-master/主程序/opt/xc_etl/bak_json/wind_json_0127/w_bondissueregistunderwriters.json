{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_compname,
                                      s_info_compcode,
                                      ann_dt,
                                      underwriter,
                                      underwriterid,
                                      b_relation_typcode,
                                      start_dt,
                                      end_dt,
                                      cur_sign,
                                      bondtype_code,
                                      bondtype,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_bondissueregistunderwriters.json' as task_rs_id
                                from ${srcoradbname}.bondissueregistunderwriters"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_bondissueregistunderwriters",
                        "fileName": "w_bondissueregistunderwriters",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_compname","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"underwriter","type":"string"},
                                      {"name":"underwriterid","type":"string"},
                                      {"name":"b_relation_typcode","type":"string"},
                                      {"name":"start_dt","type":"string"},
                                      {"name":"end_dt","type":"string"},
                                      {"name":"cur_sign","type":"bigint"},
                                      {"name":"bondtype_code","type":"bigint"},
                                      {"name":"bondtype","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}