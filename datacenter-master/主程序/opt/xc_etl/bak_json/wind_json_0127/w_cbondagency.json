{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,b_info_windcode,b_agency_name,b_relation_typcode,b_agency_nameid,null as start_dt,null as end_dt from ${srcoradbname}.cbondagency"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cbondagency",
                        "fileName": "w_cbondagency",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"b_info_windcode","type":"string"},
                            {"name":"b_agency_name","type":"string"},
                            {"name":"b_relation_typcode","type":"string"},
                            {"name":"b_agency_nameid","type":"string"},
                            {"name":"start_dt","type":"string"},
                            {"name":"end_dt","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
