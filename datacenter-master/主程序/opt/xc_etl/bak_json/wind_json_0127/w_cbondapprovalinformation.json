{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      ann_date,
                                      b_info_fullname,
                                      bondtype,
                                      amount,
                                      s_info_compname,
                                      s_info_compcode,
                                      leadunderwriter,
                                      s_info_exchmarket,
                                      filenum,
                                      progress_code,
                                      project_typecode,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cbondapprovalinformation.json' as task_rs_id
                                from ${srcoradbname}.cbondapprovalinformation"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cbondapprovalinformation",
                        "fileName": "w_cbondapprovalinformation",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"ann_date","type":"string"},
                                      {"name":"b_info_fullname","type":"string"},
                                      {"name":"bondtype","type":"bigint"},
                                      {"name":"amount","type":"double"},
                                      {"name":"s_info_compname","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"leadunderwriter","type":"string"},
                                      {"name":"s_info_exchmarket","type":"string"},
                                      {"name":"filenum","type":"string"},
                                      {"name":"progress_code","type":"bigint"},
                                      {"name":"project_typecode","type":"bigint"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}