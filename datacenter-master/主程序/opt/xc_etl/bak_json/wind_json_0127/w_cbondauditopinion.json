{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_compcode,
                                      ann_dt,
                                      report_period,
                                      s_stmnote_audit_category,
                                      s_stmnote_audit_agency,
                                      s_stmnote_audit_cpa,
                                      audit_agency,
                                      audit_agency_code,
                                      s_in_control_audit_opinion,
                                      ann_dt1,
                                      s_in_control_accounting_firm,
                                      s_in_control_accountant,
                                      s_audit_fee_memo,
                                      s_audit_result_memo,
                                      s_in_control_audit,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cbondauditopinion.json' as task_rs_id
                                from ${srcoradbname}.cbondauditopinion"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cbondauditopinion",
                        "fileName": "w_cbondauditopinion",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"report_period","type":"string"},
                                      {"name":"s_stmnote_audit_category","type":"bigint"},
                                      {"name":"s_stmnote_audit_agency","type":"string"},
                                      {"name":"s_stmnote_audit_cpa","type":"string"},
                                      {"name":"audit_agency","type":"string"},
                                      {"name":"audit_agency_code","type":"bigint"},
                                      {"name":"s_in_control_audit_opinion","type":"bigint"},
                                      {"name":"ann_dt1","type":"string"},
                                      {"name":"s_in_control_accounting_firm","type":"string"},
                                      {"name":"s_in_control_accountant","type":"string"},
                                      {"name":"s_audit_fee_memo","type":"string"},
                                      {"name":"s_audit_result_memo","type":"string"},
                                      {"name":"s_in_control_audit","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}