{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,b_info_carrydate,b_info_enddate,b_info_couponrate,b_info_paymentdate,b_info_paymentinterest,b_info_paymentparvalue,b_info_paymentsum,opdate,opmode from ${srcoradbname}.cbondcf"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cbondcf",
                        "fileName": "w_cbondcf",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"s_info_windcode","type":"string"},
                            {"name":"b_info_carrydate","type":"string"},
                            {"name":"b_info_enddate","type":"string"},
                            {"name":"b_info_couponrate","type":"double"},
                            {"name":"b_info_paymentdate","type":"string"},
                            {"name":"b_info_paymentinterest","type":"double"},
                            {"name":"b_info_paymentparvalue","type":"double"},
                            {"name":"b_info_paymentsum","type":"double"},
                            {"name":"opdate","type":"date"},
                            {"name":"opmode","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
