{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_compcode,
                                      ann_dt,
                                      illeg_type,
                                      subject_type,
                                      subject,
                                      relation_type,
                                      behavior,
                                      disposal_dt,
                                      disposal_type,
                                      methodd,
                                      processor,
                                      amount,
                                      ban_year,
                                      ref_rule,
                                      illeg_type_code,
                                      ann_id,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cbondcompanyillegality.json' as task_rs_id
                                from ${srcoradbname}.cbondcompanyillegality"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cbondcompanyillegality",
                        "fileName": "w_cbondcompanyillegality",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"illeg_type","type":"string"},
                                      {"name":"subject_type","type":"bigint"},
                                      {"name":"subject","type":"string"},
                                      {"name":"relation_type","type":"bigint"},
                                      {"name":"behavior","type":"string"},
                                      {"name":"disposal_dt","type":"string"},
                                      {"name":"disposal_type","type":"string"},
                                      {"name":"methodd","type":"string"},
                                      {"name":"processor","type":"string"},
                                      {"name":"amount","type":"double"},
                                      {"name":"ban_year","type":"double"},
                                      {"name":"ref_rule","type":"string"},
                                      {"name":"illeg_type_code","type":"string"},
                                      {"name":"ann_id","type":"bigint"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}