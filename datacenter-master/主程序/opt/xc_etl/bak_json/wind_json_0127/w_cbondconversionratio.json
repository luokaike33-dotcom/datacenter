{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,b_cvn_startdate,b_cvn_enddate,b_cvn_rateofstdbnd,b_cvn_cvntperhundred,b_cvn_rateofstdbndcsi,opdate,opmode from ${srcoradbname}.cbondconversionratio where b_cvn_startdate between '${busi_month}'||'01' and to_char(add_months(to_date('${busi_month}'||01,'yyyyMMdd'),1)-1,'yyyyMMdd')"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}", 
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cbondconversionratio/busi_month=${busi_month}",
                        "fileName": "w_cbondconversionratio",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"s_info_windcode","type":"string"},
                            {"name":"b_cvn_startdate","type":"string"},
                            {"name":"b_cvn_enddate","type":"string"},
                            {"name":"b_cvn_rateofstdbnd","type":"double"},
                            {"name":"b_cvn_cvntperhundred","type":"double"},
                            {"name":"b_cvn_rateofstdbndcsi","type":"double"},
                            {"name":"opdate","type":"date"},
                            {"name":"opmode","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
