{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,trade_dt,b_anal_curvenumber,b_anal_curvename,b_anal_curvetype,b_anal_curveterm,b_anal_yield,null as b_anal_base_yield,null as b_anal_yield_total,opdate,opmode from ${srcoradbname}.cbondcurvecnbd where trade_dt between '${busi_month}'||'01' and to_char(add_months(to_date('${busi_month}'||01,'yyyyMMdd'),1)-1,'yyyyMMdd')"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cbondcurvecnbd/busi_month=${busi_month}",
                        "fileName": "w_cbondcurvecnbd",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"trade_dt","type":"string"},
                            {"name":"b_anal_curvenumber","type":"int"},
                            {"name":"b_anal_curvename","type":"string"},
                            {"name":"b_anal_curvetype","type":"string"},
                            {"name":"b_anal_curveterm","type":"double"},
                            {"name":"b_anal_yield","type":"double"},
                            {"name":"b_anal_base_yield","type":"double"},
                            {"name":"b_anal_yield_total","type":"double"},
                            {"name":"opdate","type":"date"},
                            {"name":"opmode","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
