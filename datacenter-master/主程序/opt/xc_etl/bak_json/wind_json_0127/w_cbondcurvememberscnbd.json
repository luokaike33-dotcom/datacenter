{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,trade_dt,b_anal_curvenumber,b_anal_curvename,s_info_windcode,cnbd_creditrating,opdate,opmode from ${srcoradbname}.cbondcurvememberscnbd where trade_dt between '${busi_month}'||'01' and to_char(add_months(to_date('${busi_month}'||01,'yyyyMMdd'),1)-1,'yyyyMMdd')"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cbondcurvememberscnbd/busi_month=${busi_month}",
                        "fileName": "w_cbondcurvememberscnbd",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"trade_dt","type":"string"},
                            {"name":"b_anal_curvenumber","type":"bigint"},
                            {"name":"b_anal_curvename","type":"string"},
                            {"name":"s_info_windcode","type":"string"},
                            {"name":"cnbd_creditrating","type":"string"},
                            {"name":"opdate","type":"date"},
                            {"name":"opmode","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
