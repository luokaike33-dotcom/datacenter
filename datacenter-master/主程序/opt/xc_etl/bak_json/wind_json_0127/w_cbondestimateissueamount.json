{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      issue_firstissue,
                                      bond_type,
                                      issue_amountplan,
                                      term_year,
                                      interesttype,
                                      interestfrequency,
                                      isser_introduce,
                                      specialbondtype,
                                      interesttype_code,
                                      reimbursement,
                                      s_info_windcode,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cbondestimateissueamount.json' as task_rs_id
                                from ${srcoradbname}.cbondestimateissueamount"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cbondestimateissueamount",
                        "fileName": "w_cbondestimateissueamount",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"issue_firstissue","type":"string"},
                                      {"name":"bond_type","type":"string"},
                                      {"name":"issue_amountplan","type":"double"},
                                      {"name":"term_year","type":"double"},
                                      {"name":"interesttype","type":"string"},
                                      {"name":"interestfrequency","type":"string"},
                                      {"name":"isser_introduce","type":"string"},
                                      {"name":"specialbondtype","type":"bigint"},
                                      {"name":"interesttype_code","type":"bigint"},
                                      {"name":"reimbursement","type":"bigint"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}