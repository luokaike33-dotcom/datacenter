{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_compcode,
                                      s_info_compname,
                                      ann_dt,
                                      report_period,
                                      statement_typecode,
                                      s_stmnote_intexp,
                                      s_stmnote_intinc,
                                      s_stmnote_exch,
                                      s_stmnote_fee,
                                      s_stmnote_others,
                                      s_stmnote_finexp,
                                      s_stmnote_finexp_1,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cbondfinancialexpense.json' as task_rs_id
                                from ${srcoradbname}.cbondfinancialexpense WHERE report_period BETWEEN '${busi_month}'||'01' AND to_char(add_months(to_date('${busi_month}'||'01','yyyyMMdd'),1)-1,'yyyyMMdd') "],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cbondfinancialexpense/busi_month=${busi_month}",
                        "fileName": "w_cbondfinancialexpense",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"s_info_compname","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"report_period","type":"string"},
                                      {"name":"statement_typecode","type":"bigint"},
                                      {"name":"s_stmnote_intexp","type":"double"},
                                      {"name":"s_stmnote_intinc","type":"double"},
                                      {"name":"s_stmnote_exch","type":"double"},
                                      {"name":"s_stmnote_fee","type":"double"},
                                      {"name":"s_stmnote_others","type":"double"},
                                      {"name":"s_stmnote_finexp","type":"double"},
                                      {"name":"s_stmnote_finexp_1","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}