{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": ["select object_id,
                  s_info_windcode,
                  trade_dt,
                  s_info_exchmarket,
                  s_flowcoefficient,
                  s_position_percentage,
                  s_flowcoefficient_relative,
                  s_flow_value
                  from ${srcoradbname}.cbondflowcoefficientcnbd"],
                  "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                  }
                ]
              }
            },
              "writer": {
                "name": "hdfswriter",
                "parameter": {
                  "defaultFS": "hdfs://${tgrhdfsurl}",
                  "fileType": "orc",
                  "path": "${tgrhivedbpath}/w_cbondflowcoefficientcnbd",
                  "fileName": "w_cbondflowcoefficientcnbd",
                  "column": [
                    {"name":"object_id","type":"string"},
                    {"name":"s_info_windcode","type":"string"},
                    {"name":"trade_dt","type":"string"},
                    {"name":"s_info_exchmarket","type":"string"},
                    {"name":"s_flowcoefficient","type":"double"},
                    {"name":"s_position_percentage","type":"double"},
                    {"name":"s_flowcoefficient_relative","type":"double"},
                    {"name":"s_flow_value","type":"double"}
                  ],
                  "writeMode": "append",
                  "fieldDelimiter": "\t",
                  "encoding":"utf-8",
                  "haveKerberos": "${haveKerberos}",
                  "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                  "kerberosPrincipal": "${kerberosPrincipal}"
                }
              }
              }
            ],
            "setting": {
              "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
              }
            }
          }
        }