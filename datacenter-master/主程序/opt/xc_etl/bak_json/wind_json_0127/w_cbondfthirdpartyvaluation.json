{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      dls_windcode,
                                      pricetype_code,
                                      trade_dt,
                                      dl_interest,
                                      intervalinterest,
                                      dl_cost,
                                      fs_spread,
                                      irr,
                                      rt_spread,
                                      rec_trans_marks,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cbondfthirdpartyvaluation.json' as task_rs_id
                                from ${srcoradbname}.cbondfthirdpartyvaluation"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cbondfthirdpartyvaluation",
                        "fileName": "w_cbondfthirdpartyvaluation",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"dls_windcode","type":"string"},
                                      {"name":"pricetype_code","type":"bigint"},
                                      {"name":"trade_dt","type":"string"},
                                      {"name":"dl_interest","type":"double"},
                                      {"name":"intervalinterest","type":"double"},
                                      {"name":"dl_cost","type":"double"},
                                      {"name":"fs_spread","type":"double"},
                                      {"name":"irr","type":"double"},
                                      {"name":"rt_spread","type":"double"},
                                      {"name":"rec_trans_marks","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}