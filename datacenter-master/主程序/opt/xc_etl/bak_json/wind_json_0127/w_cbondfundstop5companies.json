{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_compcode,
                                      report_period,
                                      ann_dt,
                                      s_info_compname,
                                      s_info_compcode2,
                                      typecode,
                                      conditioncode,
                                      start_dt,
                                      end_dt,
                                      amount1,
                                      amount2,
                                      crncy_code,
                                      rate,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cbondfundstop5companies.json' as task_rs_id
                                from ${srcoradbname}.cbondfundstop5companies WHERE report_period BETWEEN '${busi_month}'||'01' AND to_char(add_months(to_date('${busi_month}'||'01','yyyyMMdd'),1)-1,'yyyyMMdd') "],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cbondfundstop5companies/busi_month=${busi_month}",
                        "fileName": "w_cbondfundstop5companies",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"report_period","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"s_info_compname","type":"string"},
                                      {"name":"s_info_compcode2","type":"string"},
                                      {"name":"typecode","type":"bigint"},
                                      {"name":"conditioncode","type":"bigint"},
                                      {"name":"start_dt","type":"string"},
                                      {"name":"end_dt","type":"string"},
                                      {"name":"amount1","type":"double"},
                                      {"name":"amount2","type":"double"},
                                      {"name":"crncy_code","type":"string"},
                                      {"name":"rate","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}