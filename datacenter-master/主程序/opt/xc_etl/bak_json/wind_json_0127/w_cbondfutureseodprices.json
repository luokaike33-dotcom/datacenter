{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,trade_dt,s_dq_presettle,s_dq_open,s_dq_high,s_dq_low,s_dq_close,s_dq_settle,s_dq_volume,s_dq_amount,s_dq_oi,s_dq_change,null as s_dq_cccode from ${srcoradbname}.cbondfutureseodprices where trade_dt between '${busi_month}'||'01' and to_char(add_months(to_date('${busi_month}'||01,'yyyyMMdd'),1)-1,'yyyyMMdd')"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cbondfutureseodprices/busi_month=${busi_month}",
                        "fileName": "w_cbondfutureseodprices",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"s_info_windcode","type":"string"},
                            {"name":"trade_dt","type":"string"},
                            {"name":"s_dq_presettle","type":"double"},
                            {"name":"s_dq_open","type":"double"},
                            {"name":"s_dq_high","type":"double"},
                            {"name":"s_dq_low","type":"double"},
                            {"name":"s_dq_close","type":"double"},
                            {"name":"s_dq_settle","type":"double"},
                            {"name":"s_dq_volume","type":"double"},
                            {"name":"s_dq_amount","type":"double"},
                            {"name":"s_dq_oi","type":"double"},
                            {"name":"s_dq_change","type":"double"},
                            {"name":"s_dq_cccode","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
