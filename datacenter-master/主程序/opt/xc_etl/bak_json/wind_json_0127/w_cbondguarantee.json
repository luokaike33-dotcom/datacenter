{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_compcode,relation,guarantor,relation2,securedparty,method1,amount,crncy_code,term,start_dt,end_dt,is_complete,is_related,trade_dt,report_period,is_overdue,overdue_amount,is_counterguarantee,ann_dt from ${srcoradbname}.cbondguarantee"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cbondguarantee",
                        "fileName": "w_cbondguarantee",
                        "column": [
                        {"name":"object_id","type":"STRING"},
                        {"name":"s_info_compcode","type":"STRING"},
                        {"name":"relation","type":"STRING"},
                        {"name":"guarantor","type":"STRING"},
                        {"name":"relation2","type":"STRING"},
                        {"name":"securedparty","type":"STRING"},
                        {"name":"method1","type":"STRING"},
                        {"name":"amount","type":"DOUBLE"},
                        {"name":"crncy_code","type":"STRING"},
                        {"name":"term","type":"DOUBLE"},
                        {"name":"start_dt","type":"STRING"},
                        {"name":"end_dt","type":"STRING"},
                        {"name":"is_complete","type":"DOUBLE"},
                        {"name":"is_related","type":"DOUBLE"},
                        {"name":"trade_dt","type":"STRING"},
                        {"name":"report_period","type":"STRING"},
                        {"name":"is_overdue","type":"DOUBLE"},
                        {"name":"overdue_amount","type":"DOUBLE"},
                        {"name":"is_counterguarantee","type":"DOUBLE"},
                        {"name":"ann_dt","type":"STRING"}
],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
