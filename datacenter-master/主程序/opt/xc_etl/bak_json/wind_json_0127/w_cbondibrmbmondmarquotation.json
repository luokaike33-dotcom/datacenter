{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      b_dq_type,
                                      trade_dt,
                                      b_dq_open,
                                      b_dq_high,
                                      b_dq_low,
                                      b_dq_originclose,
                                      b_dq_waveragerate,
                                      b_dq_bpchange,
                                      b_dq_volume,
                                      b_dq_amount,
                                      b_dq_amountchange,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cbondibrmbmondmarquotation.json' as task_rs_id
                                from ${srcoradbname}.cbondibrmbmondmarquotation WHERE trade_dt BETWEEN '${busi_month}'||'01' AND to_char(add_months(to_date('${busi_month}'||'01','yyyyMMdd'),1)-1,'yyyyMMdd') "],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cbondibrmbmondmarquotation/busi_month=${busi_month}",
                        "fileName": "w_cbondibrmbmondmarquotation",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"b_dq_type","type":"string"},
                                      {"name":"trade_dt","type":"string"},
                                      {"name":"b_dq_open","type":"double"},
                                      {"name":"b_dq_high","type":"double"},
                                      {"name":"b_dq_low","type":"double"},
                                      {"name":"b_dq_originclose","type":"double"},
                                      {"name":"b_dq_waveragerate","type":"double"},
                                      {"name":"b_dq_bpchange","type":"double"},
                                      {"name":"b_dq_volume","type":"double"},
                                      {"name":"b_dq_amount","type":"double"},
                                      {"name":"b_dq_amountchange","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}