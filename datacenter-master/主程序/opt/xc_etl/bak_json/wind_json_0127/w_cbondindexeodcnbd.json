{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      trade_dt,
                                      s_dq_close,
                                      s_val_pe,
                                      avgmvduration,
                                      avgcf,
                                      avg_value_convexity,
                                      avg_cash_convexity,
                                      avg_cash_ytm,
                                      avg_matu,
                                      avg_dividend_rate,
                                      avg_vobp,
                                      pending_term_code,
                                      spot_settlement,
                                      avg_value_ytm,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cbondindexeodcnbd.json' as task_rs_id
                                from ${srcoradbname}.cbondindexeodcnbd WHERE trade_dt BETWEEN '${busi_month}'||'01' AND to_char(add_months(to_date('${busi_month}'||'01','yyyyMMdd'),1)-1,'yyyyMMdd') "],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cbondindexeodcnbd/busi_month=${busi_month}",
                        "fileName": "w_cbondindexeodcnbd",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"trade_dt","type":"string"},
                                      {"name":"s_dq_close","type":"double"},
                                      {"name":"s_val_pe","type":"double"},
                                      {"name":"avgmvduration","type":"double"},
                                      {"name":"avgcf","type":"double"},
                                      {"name":"avg_value_convexity","type":"double"},
                                      {"name":"avg_cash_convexity","type":"double"},
                                      {"name":"avg_cash_ytm","type":"double"},
                                      {"name":"avg_matu","type":"double"},
                                      {"name":"avg_dividend_rate","type":"double"},
                                      {"name":"avg_vobp","type":"double"},
                                      {"name":"pending_term_code","type":"bigint"},
                                      {"name":"spot_settlement","type":"double"},
                                      {"name":"avg_value_ytm","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}