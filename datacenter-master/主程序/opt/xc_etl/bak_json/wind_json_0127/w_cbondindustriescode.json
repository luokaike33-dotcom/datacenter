{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,industriescode1,industriescode,industriesname,levelnum,used,industriestype from ${srcoradbname}.cbondindustriescode"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cbondindustriescode",
                        "fileName": "w_cbondindustriescode",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"industriescode1","type":"string"},
                            {"name":"industriescode","type":"string"},
                            {"name":"industriesname","type":"string"},
                            {"name":"levelnum","type":"double"},
                            {"name":"used","type":"double"},
                            {"name":"industriestype","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
