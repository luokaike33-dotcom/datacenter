{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,b_info_announcementdate,s_div_recorddate,s_div_exdate,b_info_paymentdate,b_info_interestperthousands,b_info_principalperthousands,b_info_principalaftertax,crncy_code,b_info_redeem_net_price,opdate,opmode from ${srcoradbname}.cbondpayment"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cbondpayment",
                        "fileName": "w_cbondpayment",
                        "column": [
                        {"name":"object_id","type":"STRING"},
                        {"name":"s_info_windcode","type":"STRING"},
                        {"name":"b_info_announcementdate","type":"STRING"},
                        {"name":"s_div_recorddate","type":"STRING"},
                        {"name":"s_div_exdate","type":"STRING"},
                        {"name":"b_info_paymentdate","type":"STRING"},
                        {"name":"b_info_interestperthousands","type":"DOUBLE"},
                        {"name":"b_info_principalperthousands","type":"DOUBLE"},
                        {"name":"b_info_principalaftertax","type":"DOUBLE"},
                        {"name":"crncy_code","type":"STRING"},
                        {"name":"b_info_redeem_net_price","type":"DOUBLE"},
                        {"name":"opdate","type":"DATE"},
                        {"name":"opmode","type":"STRING"}
],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
