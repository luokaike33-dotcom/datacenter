{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,s_info_subjectwindcode,b_info_repo_type,b_info_repo_days,b_info_repo_firstdate,b_info_repo_pcntbond,s_info_name,s_info_exchmarket,repo_days,s_info_fullname,s_info_type,s_info_typename,security_status,crncy_name,opdate,opmode from ${srcoradbname}.cbondprepodescription"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cbondprepodescription",
                        "fileName": "w_cbondprepodescription",
                        "column": [
                        {"name":"object_id","type":"STRING"},
                        {"name":"s_info_windcode","type":"STRING"},
                        {"name":"s_info_subjectwindcode","type":"STRING"},
                        {"name":"b_info_repo_type","type":"STRING"},
                        {"name":"b_info_repo_days","type":"DOUBLE"},
                        {"name":"b_info_repo_firstdate","type":"STRING"},
                        {"name":"b_info_repo_pcntbond","type":"DOUBLE"},
                        {"name":"s_info_name","type":"STRING"},
                        {"name":"s_info_exchmarket","type":"STRING"},
                        {"name":"repo_days","type":"STRING"},
                        {"name":"s_info_fullname","type":"STRING"},
                        {"name":"s_info_type","type":"DOUBLE"},
                        {"name":"s_info_typename","type":"STRING"},
                        {"name":"security_status","type":"DOUBLE"},
                        {"name":"crncy_name","type":"STRING"},
                        {"name":"opdate","type":"DATE"},
                        {"name":"opmode","type":"STRING"}
],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
