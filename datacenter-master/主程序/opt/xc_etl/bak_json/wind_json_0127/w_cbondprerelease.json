{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      ann_date,
                                      pre_release_code,
                                      pre_release_name,
                                      pre_release_begindate,
                                      pre_release_enddate,
                                      s_base_info,
                                      b_anal_rduration,
                                      price_type_code,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cbondprerelease.json' as task_rs_id
                                from ${srcoradbname}.cbondprerelease"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cbondprerelease",
                        "fileName": "w_cbondprerelease",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"ann_date","type":"string"},
                                      {"name":"pre_release_code","type":"string"},
                                      {"name":"pre_release_name","type":"string"},
                                      {"name":"pre_release_begindate","type":"string"},
                                      {"name":"pre_release_enddate","type":"string"},
                                      {"name":"s_base_info","type":"double"},
                                      {"name":"b_anal_rduration","type":"double"},
                                      {"name":"price_type_code","type":"bigint"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}