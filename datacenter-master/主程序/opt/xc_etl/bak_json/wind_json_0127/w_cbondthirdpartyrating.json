{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_compname,s_info_compcode,b_rate_style,b_info_listdate,b_typcode,b_est_rating_inst,b_est_institute,b_rate_ratingoutlook,b_est_prerating_inst,b_rate_preratingoutlook,b_est_rating_change,null as b_rate_ratingoutlook_code,null as b_rate_preratingoutlook_code from ${srcoradbname}.cbondthirdpartyrating"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cbondthirdpartyrating",
                        "fileName": "w_cbondthirdpartyrating",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"s_info_compname","type":"string"},
                            {"name":"s_info_compcode","type":"string"},
                            {"name":"b_rate_style","type":"double"},
                            {"name":"b_info_listdate","type":"string"},
                            {"name":"b_typcode","type":"double"},
                            {"name":"b_est_rating_inst","type":"string"},
                            {"name":"b_est_institute","type":"string"},
                            {"name":"b_rate_ratingoutlook","type":"string"},
                            {"name":"b_est_prerating_inst","type":"string"},
                            {"name":"b_rate_preratingoutlook","type":"string"},
                            {"name":"b_est_rating_change","type":"string"},
                            {"name":"b_rate_ratingoutlook_code","type":"double"},
                            {"name":"b_rate_preratingoutlook_code","type":"double"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
