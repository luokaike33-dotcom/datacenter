{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": ["select object_id,
                  s_info_windcode,
                  ann_dt,
                  conv_code,
                  conv_name,
                  conv_price,
                  crncy_code,
                  conv_startdate,
                  conv_enddate,
                  trade_dt_last,
                  forced_conv_date,
                  forced_conv_price,
                  rel_conv_month,
                  isforced,
                  forced_conv_reason
                  from ${srcoradbname}.ccbondconversion"],
                  "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                  }
                ]
              }
            },
              "writer": {
                "name": "hdfswriter",
                "parameter": {
                  "defaultFS": "hdfs://${tgrhdfsurl}",
                  "fileType": "orc",
                  "path": "${tgrhivedbpath}/w_ccbondconversion",
                  "fileName": "w_ccbondconversion",
                  "column": [
                    {"name":"object_id","type":"string"},
                    {"name":"s_info_windcode","type":"string"},
                    {"name":"ann_dt","type":"string"},
                    {"name":"conv_code","type":"string"},
                    {"name":"conv_name","type":"string"},
                    {"name":"conv_price","type":"double"},
                    {"name":"crncy_code","type":"string"},
                    {"name":"conv_startdate","type":"string"},
                    {"name":"conv_enddate","type":"string"},
                    {"name":"trade_dt_last","type":"string"},
                    {"name":"forced_conv_date","type":"string"},
                    {"name":"forced_conv_price","type":"double"},
                    {"name":"rel_conv_month","type":"double"},
                    {"name":"isforced","type":"double"},
                    {"name":"forced_conv_reason","type":"string"}
                  ],
                  "writeMode": "append",
                  "fieldDelimiter": "\t",
                  "encoding":"utf-8",
                  "haveKerberos": "${haveKerberos}",
                  "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                  "kerberosPrincipal": "${kerberosPrincipal}"
                }
              }
              }
            ],
            "setting": {
              "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
              }
            }
          }
        }