{
  "job": {
    "content": [
      {
        "reader": {
          "name": "oraclereader",
          "parameter": {
            "username": "${srcorausername}",
            "password": "${srcorapassword}",
            "where": "",
            "connection": [
              {
                "querySql": ["select object_id,
                  b_info_windcode,
                  b_info_redemptionprice,
                  b_info_bgndt,
                  b_info_enddt,
                  b_info_trnsrt
                  from ${srcoradbname}.ccbondredemptionpricerate"],
                  "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                  }
                ]
              }
            },
              "writer": {
                "name": "hdfswriter",
                "parameter": {
                  "defaultFS": "hdfs://${tgrhdfsurl}",
                  "fileType": "orc",
                  "path": "${tgrhivedbpath}/w_ccbondredemptionpricerate",
                  "fileName": "w_ccbondredemptionpricerate",
                  "column": [
                    {"name":"object_id","type":"string"},
                    {"name":"b_info_windcode","type":"string"},
                    {"name":"b_info_redemptionprice","type":"double"},
                    {"name":"b_info_bgndt","type":"string"},
                    {"name":"b_info_enddt","type":"string"},
                    {"name":"b_info_trnsrt","type":"double"}
                  ],
                  "writeMode": "append",
                  "fieldDelimiter": "\t",
                  "encoding":"utf-8",
                  "haveKerberos": "${haveKerberos}",
                  "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                  "kerberosPrincipal": "${kerberosPrincipal}"
                }
              }
              }
            ],
            "setting": {
              "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
              }
            }
          }
        }