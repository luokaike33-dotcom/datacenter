{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      trade_dt,
                                      cb_anal_accrueddays,
                                      cb_anal_accruedinterest,
                                      cb_anal_ptm,
                                      cb_anal_curyield,
                                      cb_anal_ytm,
                                      cb_anal_strbvalue,
                                      cb_anal_strbpremium,
                                      cb_anal_strbpremiumratio,
                                      cb_anal_convprice,
                                      cb_anal_convratio,
                                      cb_anal_convvalue,
                                      cb_anal_convpremium,
                                      cb_anal_convpremiumratio,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_ccbondvaluation.json' as task_rs_id
                                from ${srcoradbname}.ccbondvaluation"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_ccbondvaluation",
                        "fileName": "w_ccbondvaluation",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"trade_dt","type":"string"},
                                      {"name":"cb_anal_accrueddays","type":"double"},
                                      {"name":"cb_anal_accruedinterest","type":"double"},
                                      {"name":"cb_anal_ptm","type":"double"},
                                      {"name":"cb_anal_curyield","type":"double"},
                                      {"name":"cb_anal_ytm","type":"double"},
                                      {"name":"cb_anal_strbvalue","type":"double"},
                                      {"name":"cb_anal_strbpremium","type":"double"},
                                      {"name":"cb_anal_strbpremiumratio","type":"double"},
                                      {"name":"cb_anal_convprice","type":"double"},
                                      {"name":"cb_anal_convratio","type":"double"},
                                      {"name":"cb_anal_convvalue","type":"double"},
                                      {"name":"cb_anal_convpremium","type":"double"},
                                      {"name":"cb_anal_convpremiumratio","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}