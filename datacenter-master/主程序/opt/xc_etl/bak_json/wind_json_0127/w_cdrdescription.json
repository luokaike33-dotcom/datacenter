{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      s_info_code,
                                      s_info_name,
                                      s_info_compname,
                                      s_info_compnameeng,
                                      s_info_isincode,
                                      s_info_exchmarket,
                                      s_info_listboard,
                                      s_info_listdate,
                                      s_info_delistdate,
                                      crncy_code,
                                      s_info_pinyin,
                                      s_info_listboardname,
                                      s_info_compcode,
                                      sec_id,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cdrdescription.json' as task_rs_id
                                from ${srcoradbname}.cdrdescription"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cdrdescription",
                        "fileName": "w_cdrdescription",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"s_info_code","type":"string"},
                                      {"name":"s_info_name","type":"string"},
                                      {"name":"s_info_compname","type":"string"},
                                      {"name":"s_info_compnameeng","type":"string"},
                                      {"name":"s_info_isincode","type":"string"},
                                      {"name":"s_info_exchmarket","type":"string"},
                                      {"name":"s_info_listboard","type":"string"},
                                      {"name":"s_info_listdate","type":"string"},
                                      {"name":"s_info_delistdate","type":"string"},
                                      {"name":"crncy_code","type":"string"},
                                      {"name":"s_info_pinyin","type":"string"},
                                      {"name":"s_info_listboardname","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"sec_id","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}