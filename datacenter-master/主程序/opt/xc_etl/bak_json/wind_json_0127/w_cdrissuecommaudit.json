{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      s_info_companyname,
                                      s_ic_year,
                                      s_ic_sessiontimes,
                                      s_ic_audittype,
                                      s_ic_type,
                                      s_ic_announcementdate,
                                      s_ic_date,
                                      s_ic_auditocetype,
                                      s_ic_auditannocedate,
                                      s_info_expectedissueshares,
                                      s_info_expectedcollection,
                                      s_info_veto_reason,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cdrissuecommaudit.json' as task_rs_id
                                from ${srcoradbname}.cdrissuecommaudit"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cdrissuecommaudit",
                        "fileName": "w_cdrissuecommaudit",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"s_info_companyname","type":"string"},
                                      {"name":"s_ic_year","type":"string"},
                                      {"name":"s_ic_sessiontimes","type":"string"},
                                      {"name":"s_ic_audittype","type":"string"},
                                      {"name":"s_ic_type","type":"bigint"},
                                      {"name":"s_ic_announcementdate","type":"string"},
                                      {"name":"s_ic_date","type":"string"},
                                      {"name":"s_ic_auditocetype","type":"string"},
                                      {"name":"s_ic_auditannocedate","type":"string"},
                                      {"name":"s_info_expectedissueshares","type":"double"},
                                      {"name":"s_info_expectedcollection","type":"double"},
                                      {"name":"s_info_veto_reason","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}