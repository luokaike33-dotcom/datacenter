{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      comp_id,
                                      comp_name,
                                      name_bank_account,
                                      account_name,
                                      bank_account,
                                      bank_number,
                                      exchange_number,
                                      line_number,
                                      line_payment_system,
                                      update1,
                                      is_effective,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cfundbankaccount.json' as task_rs_id
                                from ${srcoradbname}.cfundbankaccount"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cfundbankaccount",
                        "fileName": "w_cfundbankaccount",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"comp_id","type":"string"},
                                      {"name":"comp_name","type":"string"},
                                      {"name":"name_bank_account","type":"string"},
                                      {"name":"account_name","type":"string"},
                                      {"name":"bank_account","type":"string"},
                                      {"name":"bank_number","type":"string"},
                                      {"name":"exchange_number","type":"string"},
                                      {"name":"line_number","type":"string"},
                                      {"name":"line_payment_system","type":"string"},
                                      {"name":"update1","type":"string"},
                                      {"name":"is_effective","type":"bigint"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}