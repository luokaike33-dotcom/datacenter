{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      event_type,
                                      occurrence_date,
                                      disclosure_date,
                                      memo,
                                      date_created,
                                      s_info_code,
                                      s_info_name,
                                      type_code,
                                      language1,
                                      eqy_record_dt,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cfundeventdateinformation.json' as task_rs_id
                                from ${srcoradbname}.cfundeventdateinformation WHERE occurrence_date BETWEEN '${busi_month}'||'01' AND to_char(add_months(to_date('${busi_month}'||'01','yyyyMMdd'),1)-1,'yyyyMMdd') "],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cfundeventdateinformation/busi_month=${busi_month}",
                        "fileName": "w_cfundeventdateinformation",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"event_type","type":"bigint"},
                                      {"name":"occurrence_date","type":"string"},
                                      {"name":"disclosure_date","type":"string"},
                                      {"name":"memo","type":"string"},
                                      {"name":"date_created","type":"string"},
                                      {"name":"s_info_code","type":"string"},
                                      {"name":"s_info_name","type":"string"},
                                      {"name":"type_code","type":"string"},
                                      {"name":"language1","type":"string"},
                                      {"name":"eqy_record_dt","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}