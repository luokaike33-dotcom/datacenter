{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      s_change_date,
                                      date_closing_date,
                                      style_coefficient,
                                      growth_z,
                                      value_z,
                                      avg_market_value,
                                      gross_oper_rev,
                                      gross_oper_netprofit,
                                      value_coefficient,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cfundstylecoefficient.json' as task_rs_id
                                from ${srcoradbname}.cfundstylecoefficient"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cfundstylecoefficient",
                        "fileName": "w_cfundstylecoefficient",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"s_change_date","type":"string"},
                                      {"name":"date_closing_date","type":"string"},
                                      {"name":"style_coefficient","type":"double"},
                                      {"name":"growth_z","type":"double"},
                                      {"name":"value_z","type":"double"},
                                      {"name":"avg_market_value","type":"double"},
                                      {"name":"gross_oper_rev","type":"double"},
                                      {"name":"gross_oper_netprofit","type":"double"},
                                      {"name":"value_coefficient","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}