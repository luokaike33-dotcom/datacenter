{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      trade_dt,
                                      s_dq_open,
                                      s_dq_high,
                                      s_dq_low,
                                      s_dq_close,
                                      s_dq_avgprice,
                                      s_dq_volume,
                                      s_dq_amount,
                                      s_dq_oi,
                                      del_amt,
                                      s_dq_settle,
                                      delay_pay_typecode,
                                      s_pct_chg,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cgoldspoteodprices.json' as task_rs_id
                                from ${srcoradbname}.cgoldspoteodprices"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cgoldspoteodprices",
                        "fileName": "w_cgoldspoteodprices",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"trade_dt","type":"string"},
                                      {"name":"s_dq_open","type":"double"},
                                      {"name":"s_dq_high","type":"double"},
                                      {"name":"s_dq_low","type":"double"},
                                      {"name":"s_dq_close","type":"double"},
                                      {"name":"s_dq_avgprice","type":"double"},
                                      {"name":"s_dq_volume","type":"double"},
                                      {"name":"s_dq_amount","type":"double"},
                                      {"name":"s_dq_oi","type":"double"},
                                      {"name":"del_amt","type":"double"},
                                      {"name":"s_dq_settle","type":"double"},
                                      {"name":"delay_pay_typecode","type":"bigint"},
                                      {"name":"s_pct_chg","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}