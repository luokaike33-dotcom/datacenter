{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,f_info_windcode,ann_date,price_date,f_nav_unit,f_nav_accumulated,f_nav_divaccumulated,f_nav_adjfactor,crncy_code,f_prt_netasset,f_asset_mergedsharesornot,netasset_total,f_nav_adjusted,is_exdividenddate,f_nav_distribution,s_info_asharecode,opdate,opmode from ${srcoradbname}.chinamutualfundnav where price_date between '${busi_month}'||'01' and to_char(add_months(to_date('${busi_month}'||01,'yyyyMMdd'),1)-1,'yyyyMMdd')"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_chinamutualfundnav/busi_month=${busi_month}",
                        "fileName": "w_chinamutualfundnav",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"f_info_windcode","type":"string"},
                            {"name":"ann_date","type":"string"},
                            {"name":"price_date","type":"string"},
                            {"name":"f_nav_unit","type":"double"},
                            {"name":"f_nav_accumulated","type":"double"},
                            {"name":"f_nav_divaccumulated","type":"double"},
                            {"name":"f_nav_adjfactor","type":"double"},
                            {"name":"crncy_code","type":"string"},
                            {"name":"f_prt_netasset","type":"double"},
                            {"name":"f_asset_mergedsharesornot","type":"int"},
                            {"name":"netasset_total","type":"double"},
                            {"name":"f_nav_adjusted","type":"double"},
                            {"name":"is_exdividenddate","type":"int"},
                            {"name":"f_nav_distribution","type":"double"},
                            {"name":"s_info_asharecode","type":"string"},
                            {"name":"opdate","type":"date"},
                            {"name":"opmode","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
