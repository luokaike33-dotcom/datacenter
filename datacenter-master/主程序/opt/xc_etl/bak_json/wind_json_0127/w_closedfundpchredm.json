{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,s_info_exchmarket,substription_code,substription_name,substription_price,substription_start_dt,substription_end_dt,pch_code,pch_name,pch_start_dt,redm_start_dt from ${srcoradbname}.closedfundpchredm"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_closedfundpchredm",
                        "fileName": "w_closedfundpchredm",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"s_info_windcode","type":"string"},
                            {"name":"s_info_exchmarket","type":"string"},
                            {"name":"substription_code","type":"string"},
                            {"name":"substription_name","type":"string"},
                            {"name":"substription_price","type":"double"},
                            {"name":"substription_start_dt","type":"string"},
                            {"name":"substription_end_dt","type":"string"},
                            {"name":"pch_code","type":"string"},
                            {"name":"pch_name","type":"string"},
                            {"name":"pch_start_dt","type":"string"},
                            {"name":"redm_start_dt","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
