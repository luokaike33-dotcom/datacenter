{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      sec_id,
                                      report_period,
                                      ann_dt,
                                      is_list,
                                      anal_netincome,
                                      anal_income,
                                      anal_avgnetincomeperunit,
                                      anal_avgnavreturn,
                                      anal_nav_return,
                                      nav_acc_return,
                                      anal_distributable,
                                      anal_distributableperunit,
                                      prt_netasset,
                                      prt_netassetperunit,
                                      prt_totalasset,
                                      unit_total,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cmffinancialindicator.json' as task_rs_id
                                from ${srcoradbname}.cmffinancialindicator"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cmffinancialindicator",
                        "fileName": "w_cmffinancialindicator",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"sec_id","type":"string"},
                                      {"name":"report_period","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"is_list","type":"bigint"},
                                      {"name":"anal_netincome","type":"double"},
                                      {"name":"anal_income","type":"double"},
                                      {"name":"anal_avgnetincomeperunit","type":"double"},
                                      {"name":"anal_avgnavreturn","type":"double"},
                                      {"name":"anal_nav_return","type":"double"},
                                      {"name":"nav_acc_return","type":"double"},
                                      {"name":"anal_distributable","type":"double"},
                                      {"name":"anal_distributableperunit","type":"double"},
                                      {"name":"prt_netasset","type":"double"},
                                      {"name":"prt_netassetperunit","type":"double"},
                                      {"name":"prt_totalasset","type":"double"},
                                      {"name":"unit_total","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}