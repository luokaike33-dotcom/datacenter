{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      f_info_windcode,
                                      f_unit_rpstartdate,
                                      f_unit_rpenddate,
                                      trade_dt,
                                      f_inquirer_type,
                                      f_inquirer_type_num,
                                      f_holding_time,
                                      f_start_num_holder,
                                      f_unit_pch,
                                      f_unit_redm,
                                      f_end_num_holder,
                                      f_end_num_holder_proportion,
                                      is_merge,
                                      f_inquirer_typecode,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cmfholdingratioanomaly.json' as task_rs_id
                                from ${srcoradbname}.cmfholdingratioanomaly"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cmfholdingratioanomaly",
                        "fileName": "w_cmfholdingratioanomaly",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"f_info_windcode","type":"string"},
                                      {"name":"f_unit_rpstartdate","type":"string"},
                                      {"name":"f_unit_rpenddate","type":"string"},
                                      {"name":"trade_dt","type":"string"},
                                      {"name":"f_inquirer_type","type":"string"},
                                      {"name":"f_inquirer_type_num","type":"bigint"},
                                      {"name":"f_holding_time","type":"string"},
                                      {"name":"f_start_num_holder","type":"double"},
                                      {"name":"f_unit_pch","type":"double"},
                                      {"name":"f_unit_redm","type":"double"},
                                      {"name":"f_end_num_holder","type":"double"},
                                      {"name":"f_end_num_holder_proportion","type":"double"},
                                      {"name":"is_merge","type":"bigint"},
                                      {"name":"f_inquirer_typecode","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}