{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,s_info_name,trade_dt,crncy_code,s_dq_preclose,s_dq_open,s_dq_high,s_dq_low,s_dq_close,s_dq_volume,s_dq_amount,sec_id,s_dq_change,s_dq_pctchange,opdate,opmode from ${srcoradbname}.cmfindexeod"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cmfindexeod",
                        "fileName": "w_cmfindexeod",
                        "column": [
                        {"name":"object_id","type":"STRING"},
                        {"name":"s_info_windcode","type":"STRING"},
                        {"name":"s_info_name","type":"STRING"},
                        {"name":"trade_dt","type":"STRING"},
                        {"name":"crncy_code","type":"STRING"},
                        {"name":"s_dq_preclose","type":"DOUBLE"},
                        {"name":"s_dq_open","type":"DOUBLE"},
                        {"name":"s_dq_high","type":"DOUBLE"},
                        {"name":"s_dq_low","type":"DOUBLE"},
                        {"name":"s_dq_close","type":"DOUBLE"},
                        {"name":"s_dq_volume","type":"DOUBLE"},
                        {"name":"s_dq_amount","type":"DOUBLE"},
                        {"name":"sec_id","type":"STRING"},
                        {"name":"s_dq_change","type":"DOUBLE"},
                        {"name":"s_dq_pctchange","type":"DOUBLE"},
                        {"name":"opdate","type":"DATE"},
                        {"name":"opmode","type":"STRING"}
],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
