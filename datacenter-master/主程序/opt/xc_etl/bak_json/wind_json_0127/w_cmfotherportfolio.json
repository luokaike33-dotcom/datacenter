{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,end_dt,ann_dt,crncy_code,s_info_holdwindcode,value,quantity,valuetonav,opdate,opmode from  ${srcoradbname}.cmfotherportfolio  where end_dt between '${busi_month}'||'01' and to_char(add_months(to_date('${busi_month}'||01,'yyyyMMdd'),1)-1,'yyyyMMdd')"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cmfotherportfolio/busi_month=${busi_month}",
                        "fileName": "w_cmfotherportfolio",
                        "column": [
                        {"name":"object_id","type":"STRING"},
                        {"name":"s_info_windcode","type":"STRING"},
                        {"name":"end_dt","type":"STRING"},
                        {"name":"ann_dt","type":"STRING"},
                        {"name":"crncy_code","type":"STRING"},
                        {"name":"s_info_holdwindcode","type":"STRING"},
                        {"name":"value","type":"DOUBLE"},
                        {"name":"quantity","type":"DOUBLE"},
                        {"name":"valuetonav","type":"DOUBLE"},
                        {"name":"opdate","type":"DATE"},
                        {"name":"opmode","type":"STRING"}
],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
