{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,ann_date,feetypecode,chargeway,amountdownlimit,amountuplimit,holdingperiod_downlimit,holdingperiod_uplimit,feeratio,isuplimitfee,change_dt,supplementary,tradingplace,tradingplacecode,holdingperiodunit,used,memo,null as fee_type_code from ${srcoradbname}.cmfsubredfee"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cmfsubredfee",
                        "fileName": "w_cmfsubredfee",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"s_info_windcode","type":"string"},
                            {"name":"ann_date","type":"string"},
                            {"name":"feetypecode","type":"string"},
                            {"name":"chargeway","type":"string"},
                            {"name":"amountdownlimit","type":"double"},
                            {"name":"amountuplimit","type":"double"},
                            {"name":"holdingperiod_downlimit","type":"double"},
                            {"name":"holdingperiod_uplimit","type":"double"},
                            {"name":"feeratio","type":"double"},
                            {"name":"isuplimitfee","type":"string"},
                            {"name":"change_dt","type":"string"},
                            {"name":"supplementary","type":"string"},
                            {"name":"tradingplace","type":"string"},
                            {"name":"tradingplacecode","type":"double"},
                            {"name":"holdingperiodunit","type":"string"},
                            {"name":"used","type":"double"},
                            {"name":"memo","type":"string"},
                            {"name":"fee_type_code","type":"double"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
