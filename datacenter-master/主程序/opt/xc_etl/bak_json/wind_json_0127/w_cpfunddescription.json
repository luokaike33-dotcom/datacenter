{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,f_info_windcode,ann_dt,cp_period,start_dt,end_dt,guarant_fee,trigger_yield,trigger_info,guarantor,guarantor_info,opdate,opmode from ${srcoradbname}.cpfunddescription"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_cpfunddescription",
                        "fileName": "w_cpfunddescription",
                        "column": [
                        {"name":"object_id","type":"STRING"},
                        {"name":"f_info_windcode","type":"STRING"},
                        {"name":"ann_dt","type":"STRING"},
                        {"name":"cp_period","type":"DOUBLE"},
                        {"name":"start_dt","type":"STRING"},
                        {"name":"end_dt","type":"STRING"},
                        {"name":"guarant_fee","type":"DOUBLE"},
                        {"name":"trigger_yield","type":"DOUBLE"},
                        {"name":"trigger_info","type":"STRING"},
                        {"name":"guarantor","type":"STRING"},
                        {"name":"guarantor_info","type":"STRING"},
                        {"name":"opdate","type":"DATE"},
                        {"name":"opmode","type":"STRING"}
],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
