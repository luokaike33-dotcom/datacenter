{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_compname,
                                      ann_dt,
                                      s_rate_style,
                                      s_info_creditrating,
                                      s_rate_ratingoutlook,
                                      s_info_creditratingagency,
                                      s_info_compcode,
                                      s_info_creditratingexplain,
                                      s_info_precreditrating,
                                      s_creditrating_change,
                                      s_info_issuerratetype,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_cpsissuerrating.json' as task_rs_id
                                from ${srcoradbname}.cpsissuerrating"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_cpsissuerrating",
                        "fileName": "w_cpsissuerrating",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_compname","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"s_rate_style","type":"string"},
                                      {"name":"s_info_creditrating","type":"string"},
                                      {"name":"s_rate_ratingoutlook","type":"bigint"},
                                      {"name":"s_info_creditratingagency","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"s_info_creditratingexplain","type":"string"},
                                      {"name":"s_info_precreditrating","type":"string"},
                                      {"name":"s_creditrating_change","type":"string"},
                                      {"name":"s_info_issuerratetype","type":"bigint"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}