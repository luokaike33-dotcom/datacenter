{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      crncy_name,
                                      currency_code,
                                      main_currency_code,
                                      pip_value,
                                      main_currency_ratio,
                                      latest_logo,
                                      memo,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_currencycode.json' as task_rs_id
                                from ${srcoradbname}.currencycode"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_currencycode",
                        "fileName": "w_currencycode",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"crncy_name","type":"string"},
                                      {"name":"currency_code","type":"string"},
                                      {"name":"main_currency_code","type":"string"},
                                      {"name":"pip_value","type":"double"},
                                      {"name":"main_currency_ratio","type":"bigint"},
                                      {"name":"latest_logo","type":"bigint"},
                                      {"name":"memo","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}