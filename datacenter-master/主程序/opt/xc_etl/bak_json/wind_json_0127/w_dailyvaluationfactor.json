{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      trade_dt,
                                      s_dfa_lnmv,
                                      s_dfa_lntotassets,
                                      s_dfa_floatmv,
                                      s_dfa_lnfloatmv,
                                      s_dfa_opps,
                                      s_dfa_pettm_deducted,
                                      s_dfa_mvtoebitda,
                                      s_dfa_profittomv,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_dailyvaluationfactor.json' as task_rs_id
                                from ${srcoradbname}.dailyvaluationfactor"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_dailyvaluationfactor",
                        "fileName": "w_dailyvaluationfactor",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"trade_dt","type":"string"},
                                      {"name":"s_dfa_lnmv","type":"double"},
                                      {"name":"s_dfa_lntotassets","type":"double"},
                                      {"name":"s_dfa_floatmv","type":"double"},
                                      {"name":"s_dfa_lnfloatmv","type":"double"},
                                      {"name":"s_dfa_opps","type":"double"},
                                      {"name":"s_dfa_pettm_deducted","type":"double"},
                                      {"name":"s_dfa_mvtoebitda","type":"double"},
                                      {"name":"s_dfa_profittomv","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}