{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,s_info_exchmarket,online_offering_code,networkcashbuystartdt,networkcashbuyenddt,networkcashbuydownlimit,networkcashbuyuplimit,offnetworkbuystartdt,offnetworkbuyenddt,offnetworkcashbuydownlimit,pch_start_dt,redm_start_dt,pch_code,pch_name,list_dt,list_share,conversion_dt,conversion_ratio from ${srcoradbname}.etfpchredm"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_etfpchredm",
                        "fileName": "w_etfpchredm",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"s_info_windcode","type":"string"},
                            {"name":"s_info_exchmarket","type":"string"},
                            {"name":"online_offering_code","type":"string"},
                            {"name":"networkcashbuystartdt","type":"string"},
                            {"name":"networkcashbuyenddt","type":"string"},
                            {"name":"networkcashbuydownlimit","type":"double"},
                            {"name":"networkcashbuyuplimit","type":"double"},
                            {"name":"offnetworkbuystartdt","type":"string"},
                            {"name":"offnetworkbuyenddt","type":"string"},
                            {"name":"offnetworkcashbuydownlimit","type":"double"},
                            {"name":"pch_start_dt","type":"string"},
                            {"name":"redm_start_dt","type":"string"},
                            {"name":"pch_code","type":"string"},
                            {"name":"pch_name","type":"string"},
                            {"name":"list_dt","type":"string"},
                            {"name":"list_share","type":"double"},
                            {"name":"conversion_dt","type":"string"},
                            {"name":"conversion_ratio","type":"double"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
