{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_code,
                                      deadline,
                                      b_info_creditrating,
                                      rating_value_type,
                                      market_value,
                                      net_assets_ratio,
                                      currency_code,
                                      position_type_code,
                                      ann_date,
                                      announce_rating_code,
                                      comp_id,
                                      rating_type_code,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_fundbondportfolio.json' as task_rs_id
                                from ${srcoradbname}.fundbondportfolio"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_fundbondportfolio",
                        "fileName": "w_fundbondportfolio",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_code","type":"string"},
                                      {"name":"deadline","type":"string"},
                                      {"name":"b_info_creditrating","type":"bigint"},
                                      {"name":"rating_value_type","type":"bigint"},
                                      {"name":"market_value","type":"double"},
                                      {"name":"net_assets_ratio","type":"double"},
                                      {"name":"currency_code","type":"string"},
                                      {"name":"position_type_code","type":"bigint"},
                                      {"name":"ann_date","type":"string"},
                                      {"name":"announce_rating_code","type":"string"},
                                      {"name":"comp_id","type":"string"},
                                      {"name":"rating_type_code","type":"bigint"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}