{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,trade_dt,s_info_windcode,s_dq_open,s_dq_high,s_dq_low,s_dq_close,windcode,s_dq_buy,s_dq_sell,opdate,opmode from ${srcoradbname}.fxeodprices"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_fxeodprices",
                        "fileName": "w_fxeodprices",
                        "column": [
                            {"name":"object_id","type":"STRING"},
                            {"name":"trade_dt","type":"STRING"},
                            {"name":"s_info_windcode","type":"STRING"},
                            {"name":"s_dq_open","type":"DOUBLE"},
                            {"name":"s_dq_high","type":"DOUBLE"},
                            {"name":"s_dq_low","type":"DOUBLE"},
                            {"name":"s_dq_close","type":"DOUBLE"},
                            {"name":"windcode","type":"STRING"},
                            {"name":"s_dq_buy","type":"DOUBLE"},
                            {"name":"s_dq_sell","type":"DOUBLE"},
                            {"name":"opdate","type":"DATE"},
                            {"name":"opmode","type":"STRING"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
