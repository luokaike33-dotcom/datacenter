{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      exchange_sname_eng,
                                      exchange_name,
                                      securities_type,
                                      trading_hours_code,
                                      trading_hours,
                                      trading_hours_2,
                                      exchange_eng_name,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_globalmarkettradingtime.json' as task_rs_id
                                from ${srcoradbname}.globalmarkettradingtime"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_globalmarkettradingtime",
                        "fileName": "w_globalmarkettradingtime",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"exchange_sname_eng","type":"string"},
                                      {"name":"exchange_name","type":"string"},
                                      {"name":"securities_type","type":"string"},
                                      {"name":"trading_hours_code","type":"string"},
                                      {"name":"trading_hours","type":"string"},
                                      {"name":"trading_hours_2","type":"string"},
                                      {"name":"exchange_eng_name","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}