{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_windcode,
                                      institution,
                                      analyst,
                                      est_date,
                                      expirydate,
                                      low_trgt_prc,
                                      high_trgt_prc,
                                      score,
                                      rating,
                                      reportid,
                                      r_report_type,
                                      ann_date,
                                      prerating,
                                      prescore,
                                      chg_drctn_code,
                                      pre_low_trgt_prc,
                                      pre_high_trgt_prc,
                                      crncy_code,
                                      changerate,
                                      description,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_hkanalystrating.json' as task_rs_id
                                from ${srcoradbname}.hkanalystrating"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_hkanalystrating",
                        "fileName": "w_hkanalystrating",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"institution","type":"string"},
                                      {"name":"analyst","type":"string"},
                                      {"name":"est_date","type":"string"},
                                      {"name":"expirydate","type":"string"},
                                      {"name":"low_trgt_prc","type":"double"},
                                      {"name":"high_trgt_prc","type":"double"},
                                      {"name":"score","type":"bigint"},
                                      {"name":"rating","type":"string"},
                                      {"name":"reportid","type":"string"},
                                      {"name":"r_report_type","type":"string"},
                                      {"name":"ann_date","type":"string"},
                                      {"name":"prerating","type":"string"},
                                      {"name":"prescore","type":"bigint"},
                                      {"name":"chg_drctn_code","type":"bigint"},
                                      {"name":"pre_low_trgt_prc","type":"double"},
                                      {"name":"pre_high_trgt_prc","type":"double"},
                                      {"name":"crncy_code","type":"string"},
                                      {"name":"changerate","type":"double"},
                                      {"name":"description","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}