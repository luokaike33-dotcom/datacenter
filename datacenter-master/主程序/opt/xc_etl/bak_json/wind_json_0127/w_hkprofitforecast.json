{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      s_info_compcode,
                                      institution,
                                      analyst,
                                      r_report_type,
                                      startdate,
                                      enddate,
                                      est_date,
                                      est_eps,
                                      est_main_bus,
                                      est_net_profit,
                                      memo,
                                      acc_sta,
                                      crncy_code,
                                      report_type,
                                      est_enddate,
                                      ann_dt,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_hkprofitforecast.json' as task_rs_id
                                from ${srcoradbname}.hkprofitforecast"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_hkprofitforecast",
                        "fileName": "w_hkprofitforecast",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"institution","type":"string"},
                                      {"name":"analyst","type":"string"},
                                      {"name":"r_report_type","type":"string"},
                                      {"name":"startdate","type":"string"},
                                      {"name":"enddate","type":"string"},
                                      {"name":"est_date","type":"string"},
                                      {"name":"est_eps","type":"double"},
                                      {"name":"est_main_bus","type":"double"},
                                      {"name":"est_net_profit","type":"double"},
                                      {"name":"memo","type":"string"},
                                      {"name":"acc_sta","type":"string"},
                                      {"name":"crncy_code","type":"string"},
                                      {"name":"report_type","type":"string"},
                                      {"name":"est_enddate","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}