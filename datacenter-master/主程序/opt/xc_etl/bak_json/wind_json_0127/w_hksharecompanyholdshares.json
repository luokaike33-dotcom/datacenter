{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      relations_code,
                                      s_capitaloperation_comainbus,
                                      s_info_compcode,
                                      s_capitaloperation_companyid,
                                      s_capitaloperation_amount,
                                      operationcrncy_code,
                                      voting_rights,
                                      is_consolidate,
                                      enddate,
                                      s_capitaloperation_coregcap,
                                      operationcrncy_code2,
                                      s_capitaloperation_companyname,
                                      ann_dt,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_hksharecompanyholdshares.json' as task_rs_id
                                from ${srcoradbname}.hksharecompanyholdshares"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_hksharecompanyholdshares",
                        "fileName": "w_hksharecompanyholdshares",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"relations_code","type":"string"},
                                      {"name":"s_capitaloperation_comainbus","type":"string"},
                                      {"name":"s_info_compcode","type":"string"},
                                      {"name":"s_capitaloperation_companyid","type":"string"},
                                      {"name":"s_capitaloperation_amount","type":"double"},
                                      {"name":"operationcrncy_code","type":"string"},
                                      {"name":"voting_rights","type":"double"},
                                      {"name":"is_consolidate","type":"bigint"},
                                      {"name":"enddate","type":"string"},
                                      {"name":"s_capitaloperation_coregcap","type":"double"},
                                      {"name":"operationcrncy_code2","type":"string"},
                                      {"name":"s_capitaloperation_companyname","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}