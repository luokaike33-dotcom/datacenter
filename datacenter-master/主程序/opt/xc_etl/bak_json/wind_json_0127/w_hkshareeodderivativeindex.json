{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,financial_trade_dt,trade_crncy_code,tot_shr_today,float_a_shr_today,s_val_mv,s_dq_mv,s_dq_close_today,s_pq_high_52w,s_pq_low_52w,s_val_pb_new,s_val_pe_lyr,s_val_pe_ttm,s_val_pcf_ocflyr,s_val_pcf_ocfttm,s_val_pcf_ncflyr,s_val_pcf_ncfttm,s_val_ps_lyr,s_val_ps_ttm,s_dq_turn,crncy_code,net_assets_today,net_profit_parent_comp_lyr,net_profit_parent_comp_ttm,net_cash_flows_oper_act_lyr,net_cash_flows_oper_act_ttm,oper_rev_lyr,oper_rev_ttm,net_incr_cash_cash_equ_lyr,net_incr_cash_cash_equ_ttm,opdate,opmode from ${srcoradbname}.hkshareeodderivativeindex"],
