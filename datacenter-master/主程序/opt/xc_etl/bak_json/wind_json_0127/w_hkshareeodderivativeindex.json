                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_hkshareeodderivativeindex",
                        "fileName": "w_hkshareeodderivativeindex",
                        "column": [
                        {"name":"object_id","type":"STRING"},
                        {"name":"s_info_windcode","type":"STRING"},
                        {"name":"financial_trade_dt","type":"STRING"},
                        {"name":"trade_crncy_code","type":"STRING"},
                        {"name":"tot_shr_today","type":"DOUBLE"},
                        {"name":"float_a_shr_today","type":"DOUBLE"},
                        {"name":"s_val_mv","type":"DOUBLE"},
                        {"name":"s_dq_mv","type":"DOUBLE"},
                        {"name":"s_dq_close_today","type":"DOUBLE"},
                        {"name":"s_pq_high_52w","type":"DOUBLE"},
                        {"name":"s_pq_low_52w","type":"DOUBLE"},
                        {"name":"s_val_pb_new","type":"DOUBLE"},
                        {"name":"s_val_pe_lyr","type":"DOUBLE"},
                        {"name":"s_val_pe_ttm","type":"DOUBLE"},
                        {"name":"s_val_pcf_ocflyr","type":"DOUBLE"},
                        {"name":"s_val_pcf_ocfttm","type":"DOUBLE"},
                        {"name":"s_val_pcf_ncflyr","type":"DOUBLE"},
                        {"name":"s_val_pcf_ncfttm","type":"DOUBLE"},
                        {"name":"s_val_ps_lyr","type":"DOUBLE"},
                        {"name":"s_val_ps_ttm","type":"DOUBLE"},
                        {"name":"s_dq_turn","type":"DOUBLE"},
                        {"name":"crncy_code","type":"STRING"},
                        {"name":"net_assets_today","type":"DOUBLE"},
                        {"name":"net_profit_parent_comp_lyr","type":"DOUBLE"},
                        {"name":"net_profit_parent_comp_ttm","type":"DOUBLE"},
                        {"name":"net_cash_flows_oper_act_lyr","type":"DOUBLE"},
                        {"name":"net_cash_flows_oper_act_ttm","type":"DOUBLE"},
                        {"name":"oper_rev_lyr","type":"DOUBLE"},
                        {"name":"oper_rev_ttm","type":"DOUBLE"},
                        {"name":"net_incr_cash_cash_equ_lyr","type":"DOUBLE"},
                        {"name":"net_incr_cash_cash_equ_ttm","type":"DOUBLE"},
                        {"name":"opdate","type":"DATE"},
                        {"name":"opmode","type":"STRING"}
],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
