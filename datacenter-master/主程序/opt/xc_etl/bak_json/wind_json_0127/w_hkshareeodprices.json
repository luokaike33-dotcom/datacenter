{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,trade_dt,crncy_code,s_dq_open,s_dq_high,s_dq_low,s_dq_close,s_dq_volume,s_dq_amount,s_dq_preclose,s_dq_adjpreclose,s_dq_adjopen,s_dq_adjhigh,s_dq_adjlow,s_dq_adjclose,s_dq_adjfactor,s_dq_avgprice,dividend_yield,opdate,opmode from ${srcoradbname}.hkshareeodprices where trade_dt  between '${busi_month}'||'01' and to_char(add_months(to_date('${busi_month}'||01,'yyyyMMdd'),1)-1,'yyyyMMdd')"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}", 
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_hkshareeodprices/busi_month=${busi_month}",
                        "fileName": "w_hkshareeodprices",
                        "column": [
                            {"name":"object_id","type":"string"},
                            {"name":"s_info_windcode","type":"string"},
                            {"name":"trade_dt","type":"string"},
                            {"name":"crncy_code","type":"string"},
                            {"name":"s_dq_open","type":"double"},
                            {"name":"s_dq_high","type":"double"},
                            {"name":"s_dq_low","type":"double"},
                            {"name":"s_dq_close","type":"double"},
                            {"name":"s_dq_volume","type":"double"},
                            {"name":"s_dq_amount","type":"double"},
                            {"name":"s_dq_preclose","type":"double"},
                            {"name":"s_dq_adjpreclose","type":"double"},
                            {"name":"s_dq_adjopen","type":"double"},
                            {"name":"s_dq_adjhigh","type":"double"},
                            {"name":"s_dq_adjlow","type":"double"},
                            {"name":"s_dq_adjclose","type":"double"},
                            {"name":"s_dq_adjfactor","type":"double"},
                            {"name":"s_dq_avgprice","type":"double"},
                            {"name":"dividend_yield","type":"double"},
                            {"name":"opdate","type":"date"},
                            {"name":"opmode","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
