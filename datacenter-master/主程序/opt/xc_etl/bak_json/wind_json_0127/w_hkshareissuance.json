{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,ann_date,isipo,s_issue_type,boardlotunit,s_issue_par,par_crncy_code,s_issue_price,crncy_code,fundraising_net,ptotal_num_shares,pnum_hkshares,pnum_intrnl_shares,total_num_shares,num_hk_shares,num_intrnl_shares,overallotmentamount,hkvalidshares,hkvalidmultiple,pricerange_up,pricerange_down,hearingdate,prc_dtrmntn_date,paymentdate,listdate,sbscrpt_startdate,sbscrpt_enddate,intrnl_validshares,intrnl_validmultiple,pn_selling_shrhldr,oan_selling_shrhldr,overallotment_fundraising,totalfundraising,lotwinningrate,minpurchase_1hand,result_ann_date,funduse,web_info_ann_date,initial_issue_price,null as right_issue_d_date,null as right_issue_l_date from ${srcoradbname}.hkshareissuance"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
