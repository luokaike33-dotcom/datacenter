                        {"name":"ann_date","type":"STRING"},
                        {"name":"isipo","type":"DOUBLE"},
                        {"name":"s_issue_type","type":"STRING"},
                        {"name":"boardlotunit","type":"DOUBLE"},
                        {"name":"s_issue_par","type":"DOUBLE"},
                        {"name":"par_crncy_code","type":"STRING"},
                        {"name":"s_issue_price","type":"DOUBLE"},
                        {"name":"crncy_code","type":"STRING"},
                        {"name":"fundraising_net","type":"DOUBLE"},
                        {"name":"ptotal_num_shares","type":"DOUBLE"},
                        {"name":"pnum_hkshares","type":"DOUBLE"},
                        {"name":"pnum_intrnl_shares","type":"DOUBLE"},
                        {"name":"total_num_shares","type":"DOUBLE"},
                        {"name":"num_hk_shares","type":"DOUBLE"},
                        {"name":"num_intrnl_shares","type":"DOUBLE"},
                        {"name":"overallotmentamount","type":"DOUBLE"},
                        {"name":"hkvalidshares","type":"DOUBLE"},
                        {"name":"hkvalidmultiple","type":"DOUBLE"},
                        {"name":"pricerange_up","type":"DOUBLE"},
