{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,suspenddate,suspendtype,suspendreason,suspendtypecode,suspendreasoncode,resumpdate,resumptime from ${srcoradbname}.hktransactionstatus"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_hktransactionstatus",
                        "fileName": "w_hktransactionstatus",
                        "column": [
                        {"name":"object_id","type":"STRING"},
                        {"name":"s_info_windcode","type":"STRING"},
                        {"name":"suspenddate","type":"STRING"},
                        {"name":"suspendtype","type":"STRING"},
                        {"name":"suspendreason","type":"STRING"},
                        {"name":"suspendtypecode","type":"DOUBLE"},
                        {"name":"suspendreasoncode","type":"DOUBLE"},
                        {"name":"resumpdate","type":"STRING"},
                        {"name":"resumptime","type":"STRING"}
],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
