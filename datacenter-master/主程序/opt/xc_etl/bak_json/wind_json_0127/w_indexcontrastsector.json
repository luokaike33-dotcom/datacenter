{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_indexcode,s_info_name,s_info_industrycode,s_info_industryname,s_info_industrycode2,s_info_industryname_eng from ${srcoradbname}.indexcontrastsector"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_indexcontrastsector",
                        "fileName": "w_indexcontrastsector",
                        "column": [
                        {"name":"object_id","type":"STRING"},
                        {"name":"s_info_indexcode","type":"STRING"},
                        {"name":"s_info_name","type":"STRING"},
                        {"name":"s_info_industrycode","type":"STRING"},
                        {"name":"s_info_industryname","type":"STRING"},
                        {"name":"s_info_industrycode2","type":"STRING"},
                        {"name":"s_info_industryname_eng","type":"STRING"}
],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
