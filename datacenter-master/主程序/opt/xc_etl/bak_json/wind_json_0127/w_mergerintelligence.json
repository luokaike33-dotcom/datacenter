{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      intelligence_id,
                                      title,
                                      ann_date,
                                      involved_amount,
                                      subject_typecode,
                                      wind_ind_code,
                                      level_code,
                                      key_words,
                                      data_source,
                                      involved_equity,
                                      content,
                                      event_id,
                                      progress_code,
                                      receipt_date,
                                      is_important,
                                      effective_date,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_mergerintelligence.json' as task_rs_id
                                from ${srcoradbname}.mergerintelligence"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_mergerintelligence",
                        "fileName": "w_mergerintelligence",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"intelligence_id","type":"string"},
                                      {"name":"title","type":"string"},
                                      {"name":"ann_date","type":"string"},
                                      {"name":"involved_amount","type":"string"},
                                      {"name":"subject_typecode","type":"bigint"},
                                      {"name":"wind_ind_code","type":"string"},
                                      {"name":"level_code","type":"bigint"},
                                      {"name":"key_words","type":"string"},
                                      {"name":"data_source","type":"string"},
                                      {"name":"involved_equity","type":"string"},
                                      {"name":"content","type":"string"},
                                      {"name":"event_id","type":"string"},
                                      {"name":"progress_code","type":"bigint"},
                                      {"name":"receipt_date","type":"timestamp"},
                                      {"name":"is_important","type":"bigint"},
                                      {"name":"effective_date","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}