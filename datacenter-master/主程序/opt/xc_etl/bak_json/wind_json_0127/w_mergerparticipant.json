{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      event_id,
                                      party_name,
                                      country_code,
                                      party_id,
                                      s_info_windcode,
                                      party_type_code,
                                      relationship,
                                      party_role_code,
                                      pre_proportion,
                                      after_proportion,
                                      stockright_proportion,
                                      evalue_value,
                                      appreciation_rate,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_mergerparticipant.json' as task_rs_id
                                from ${srcoradbname}.mergerparticipant"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_mergerparticipant",
                        "fileName": "w_mergerparticipant",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"event_id","type":"string"},
                                      {"name":"party_name","type":"string"},
                                      {"name":"country_code","type":"string"},
                                      {"name":"party_id","type":"string"},
                                      {"name":"s_info_windcode","type":"string"},
                                      {"name":"party_type_code","type":"bigint"},
                                      {"name":"relationship","type":"bigint"},
                                      {"name":"party_role_code","type":"bigint"},
                                      {"name":"pre_proportion","type":"double"},
                                      {"name":"after_proportion","type":"double"},
                                      {"name":"stockright_proportion","type":"double"},
                                      {"name":"evalue_value","type":"double"},
                                      {"name":"appreciation_rate","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}