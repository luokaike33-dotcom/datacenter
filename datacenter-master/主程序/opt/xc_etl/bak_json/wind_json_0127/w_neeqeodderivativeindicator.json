{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,trade_dt,crncy_code,s_dq_turn,s_val_mv,s_dq_mv,s_pq_high_52w_,s_pq_low_52w_,s_val_pe,s_val_pb_new,s_val_pe_ttm,s_val_pcf_ocf,s_val_pcf_ocfttm,s_val_ps,s_val_ps_ttm,s_dq_freeturnover,tot_shr_today,float_a_shr_today,free_shares_today,net_profit_parent_comp_ttm,net_profit_parent_comp_lyr,net_assets_today,net_cash_flows_oper_act_ttm,net_cash_flows_oper_act_lyr,s_dq_close_today,oper_rev_ttm,oper_rev_lyr,net_incr_cash_cash_equ_ttm,net_incr_cash_cash_equ_lyr,s_val_pcf_ncf,s_val_pcf_ncfttm,crncy_code2,opdate,opmode from ${srcoradbname}.neeqeodderivativeindicator"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_neeqeodderivativeindicator",
                        "fileName": "w_neeqeodderivativeindicator",
                        "column": [
                        {"name":"object_id","type":"STRING"},
                        {"name":"s_info_windcode","type":"STRING"},
                        {"name":"trade_dt","type":"STRING"},
                        {"name":"crncy_code","type":"STRING"},
                        {"name":"s_dq_turn","type":"DOUBLE"},
                        {"name":"s_val_mv","type":"DOUBLE"},
                        {"name":"s_dq_mv","type":"DOUBLE"},
                        {"name":"s_pq_high_52w_","type":"DOUBLE"},
                        {"name":"s_pq_low_52w_","type":"DOUBLE"},
                        {"name":"s_val_pe","type":"DOUBLE"},
                        {"name":"s_val_pb_new","type":"DOUBLE"},
                        {"name":"s_val_pe_ttm","type":"DOUBLE"},
                        {"name":"s_val_pcf_ocf","type":"DOUBLE"},
                        {"name":"s_val_pcf_ocfttm","type":"DOUBLE"},
                        {"name":"s_val_ps","type":"DOUBLE"},
                        {"name":"s_val_ps_ttm","type":"DOUBLE"},
                        {"name":"s_dq_freeturnover","type":"DOUBLE"},
                        {"name":"tot_shr_today","type":"DOUBLE"},
                        {"name":"float_a_shr_today","type":"DOUBLE"},
                        {"name":"free_shares_today","type":"DOUBLE"},
                        {"name":"net_profit_parent_comp_ttm","type":"DOUBLE"},
                        {"name":"net_profit_parent_comp_lyr","type":"DOUBLE"},
                        {"name":"net_assets_today","type":"DOUBLE"},
                        {"name":"net_cash_flows_oper_act_ttm","type":"DOUBLE"},
                        {"name":"net_cash_flows_oper_act_lyr","type":"DOUBLE"},
                        {"name":"s_dq_close_today","type":"DOUBLE"},
                        {"name":"oper_rev_ttm","type":"DOUBLE"},
                        {"name":"oper_rev_lyr","type":"DOUBLE"},
                        {"name":"net_incr_cash_cash_equ_ttm","type":"DOUBLE"},
                        {"name":"net_incr_cash_cash_equ_lyr","type":"DOUBLE"},
                        {"name":"s_val_pcf_ncf","type":"DOUBLE"},
                        {"name":"s_val_pcf_ncfttm","type":"DOUBLE"},
                        {"name":"crncy_code2","type":"STRING"},
                        {"name":"opdate","type":"DATE"},
                        {"name":"opmode","type":"STRING"}
],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
