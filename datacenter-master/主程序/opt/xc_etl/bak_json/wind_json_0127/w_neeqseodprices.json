{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["select object_id,s_info_windcode,trade_dt,crncy_code,s_dq_preclose,s_dq_open,s_dq_high,s_dq_low,s_dq_close,s_dq_change,s_dq_pctchange,s_dq_volume,s_dq_amount,s_dq_adjpreclose,s_dq_adjopen,s_dq_adjhigh,s_dq_adjlow,s_dq_adjclose,s_dq_adjfactor,s_dq_avgprice,s_dq_tradestatus,s_dq_turn,opdate,opmode from ${srcoradbname}.neeqseodprices"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos":"${haveKerberos}",
                        "kerberosKeytabFilePath":"${kerberosKeytabFilePath}",
                        "kerberosPrincipal":"${kerberosPrincipal}",
                        "path": "${tgrhivedbpath}/w_neeqseodprices",
                        "fileName": "w_neeqseodprices",
                        "column": [
                        {"name":"object_id","type":"STRING"},
                        {"name":"s_info_windcode","type":"STRING"},
                        {"name":"trade_dt","type":"STRING"},
                        {"name":"crncy_code","type":"STRING"},
                        {"name":"s_dq_preclose","type":"DOUBLE"},
                        {"name":"s_dq_open","type":"DOUBLE"},
                        {"name":"s_dq_high","type":"DOUBLE"},
                        {"name":"s_dq_low","type":"DOUBLE"},
                        {"name":"s_dq_close","type":"DOUBLE"},
                        {"name":"s_dq_change","type":"DOUBLE"},
                        {"name":"s_dq_pctchange","type":"DOUBLE"},
                        {"name":"s_dq_volume","type":"DOUBLE"},
                        {"name":"s_dq_amount","type":"DOUBLE"},
                        {"name":"s_dq_adjpreclose","type":"DOUBLE"},
                        {"name":"s_dq_adjopen","type":"DOUBLE"},
                        {"name":"s_dq_adjhigh","type":"DOUBLE"},
                        {"name":"s_dq_adjlow","type":"DOUBLE"},
                        {"name":"s_dq_adjclose","type":"DOUBLE"},
                        {"name":"s_dq_adjfactor","type":"DOUBLE"},
                        {"name":"s_dq_avgprice","type":"DOUBLE"},
                        {"name":"s_dq_tradestatus","type":"STRING"},
                        {"name":"s_dq_turn","type":"DOUBLE"},
                        {"name":"opdate","type":"DATE"},
                        {"name":"opmode","type":"STRING"}
],
                        "writeMode": "append",
                        "fieldDelimiter": "\t"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"},"errorLimit": {"record": "0","percentage": "0"
            }
        }
    }
}
