{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      pool_name,
                                      ann_dt,
                                      start_dt,
                                      end_dr,
                                      laon_balance,
                                      laon_num,
                                      wa_loanrate,
                                      wa_remtm,
                                      credit_num,
                                      guarantee_num,
                                      credit_pct,
                                      guarantee_pct,
                                      defaut_value,
                                      default_backvalue,
                                      default_rate,
                                      arrears_rate,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_poolstatistics.json' as task_rs_id
                                from ${srcoradbname}.poolstatistics"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_poolstatistics",
                        "fileName": "w_poolstatistics",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"pool_name","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"start_dt","type":"string"},
                                      {"name":"end_dr","type":"string"},
                                      {"name":"laon_balance","type":"double"},
                                      {"name":"laon_num","type":"double"},
                                      {"name":"wa_loanrate","type":"double"},
                                      {"name":"wa_remtm","type":"double"},
                                      {"name":"credit_num","type":"double"},
                                      {"name":"guarantee_num","type":"double"},
                                      {"name":"credit_pct","type":"double"},
                                      {"name":"guarantee_pct","type":"double"},
                                      {"name":"defaut_value","type":"double"},
                                      {"name":"default_backvalue","type":"double"},
                                      {"name":"default_rate","type":"double"},
                                      {"name":"arrears_rate","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}