{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      f_info_compname,
                                      f_info_compcode,
                                      trustee_name,
                                      trustee_id,
                                      custody_secur_compname,
                                      custody_secur_compid,
                                      approval_date,
                                      approval_enddate,
                                      approval_date_first,
                                      approval_date_account,
                                      ann_date,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_qfiidescription.json' as task_rs_id
                                from ${srcoradbname}.qfiidescription"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_qfiidescription",
                        "fileName": "w_qfiidescription",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"f_info_compname","type":"string"},
                                      {"name":"f_info_compcode","type":"string"},
                                      {"name":"trustee_name","type":"string"},
                                      {"name":"trustee_id","type":"string"},
                                      {"name":"custody_secur_compname","type":"string"},
                                      {"name":"custody_secur_compid","type":"string"},
                                      {"name":"approval_date","type":"string"},
                                      {"name":"approval_enddate","type":"string"},
                                      {"name":"approval_date_first","type":"string"},
                                      {"name":"approval_date_account","type":"string"},
                                      {"name":"ann_date","type":"string"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}