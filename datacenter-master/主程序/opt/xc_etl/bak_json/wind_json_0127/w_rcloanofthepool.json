{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      object_id,
                                      pool_name,
                                      ann_dt,
                                      start_dt,
                                      end_dr,
                                      rcloan_num,
                                      rc,
                                      rcprincipal,
                                      rcinterest,
                                      rcpenalty,
                                      rcother,
                                      payip_num,
                                      payip,
                                      prepay_num,
                                      prepay,
                                      arrears_rcnum,
                                      arrears_rc,
                                      default_rcnum,
                                      default_rc,
                                      taxes,
                                      opdate,
                                      opmode,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'w_rcloanofthepool.json' as task_rs_id
                                from ${srcoradbname}.rcloanofthepool"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/w_rcloanofthepool",
                        "fileName": "w_rcloanofthepool",
                        "column": [
                                      {"name":"object_id","type":"string"},
                                      {"name":"pool_name","type":"string"},
                                      {"name":"ann_dt","type":"string"},
                                      {"name":"start_dt","type":"string"},
                                      {"name":"end_dr","type":"string"},
                                      {"name":"rcloan_num","type":"double"},
                                      {"name":"rc","type":"double"},
                                      {"name":"rcprincipal","type":"double"},
                                      {"name":"rcinterest","type":"double"},
                                      {"name":"rcpenalty","type":"double"},
                                      {"name":"rcother","type":"double"},
                                      {"name":"payip_num","type":"double"},
                                      {"name":"payip","type":"double"},
                                      {"name":"prepay_num","type":"double"},
                                      {"name":"prepay","type":"double"},
                                      {"name":"arrears_rcnum","type":"double"},
                                      {"name":"arrears_rc","type":"double"},
                                      {"name":"default_rcnum","type":"double"},
                                      {"name":"default_rc","type":"double"},
                                      {"name":"taxes","type":"double"},
                                      {"name":"opdate","type":"timestamp"},
                                      {"name":"opmode","type":"string"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}