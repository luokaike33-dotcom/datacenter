{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      id,
                                      stock_code,
                                      stock_name,
                                      con_date,
                                      con_rating_strength,
                                      con_rating_type,
                                      entrytime,
                                      updatetime,
                                      tmstamp,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'zyyx_con_rating_stk.json' as task_rs_id
                                from ${srcoradbname}.con_rating_stk WHERE con_date BETWEEN '${beg_date}'||'01' AND to_char(add_months(to_date('${beg_date}'||'01','yyyyMMdd'),1)-1,'yyyyMMdd') "],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${is_kbs}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/zyyx_con_rating_stk/busi_month=${busi_month}",
                        "fileName": "zyyx_con_rating_stk",
                        "column": [
                                      {"name":"id","type":"bigint"},
                                      {"name":"stock_code","type":"string"},
                                      {"name":"stock_name","type":"string"},
                                      {"name":"con_date","type":"timestamp"},
                                      {"name":"con_rating_strength","type":"double"},
                                      {"name":"con_rating_type","type":"bigint"},
                                      {"name":"entrytime","type":"timestamp"},
                                      {"name":"updatetime","type":"timestamp"},
                                      {"name":"tmstamp","type":"bigint"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}