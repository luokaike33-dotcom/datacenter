{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      id,
                                      author_id,
                                      author,
                                      organ_id,
                                      organ_name,
                                      report_year,
                                      list_type,
                                      industry_code,
                                      industry_name,
                                      prize_awarded,
                                      is_in_team,
                                      entrytime,
                                      updatetime,
                                      tmstamp,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'zyyx_der_crystalball_author.json' as task_rs_id
                                from ${srcoradbname}.der_crystalball_author"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${is_kbs}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/zyyx_der_crystalball_author",
                        "fileName": "zyyx_der_crystalball_author",
                        "column": [
                                      {"name":"id","type":"bigint"},
                                      {"name":"author_id","type":"bigint"},
                                      {"name":"author","type":"string"},
                                      {"name":"organ_id","type":"bigint"},
                                      {"name":"organ_name","type":"string"},
                                      {"name":"report_year","type":"bigint"},
                                      {"name":"list_type","type":"bigint"},
                                      {"name":"industry_code","type":"bigint"},
                                      {"name":"industry_name","type":"string"},
                                      {"name":"prize_awarded","type":"string"},
                                      {"name":"is_in_team","type":"bigint"},
                                      {"name":"entrytime","type":"timestamp"},
                                      {"name":"updatetime","type":"timestamp"},
                                      {"name":"tmstamp","type":"bigint"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}