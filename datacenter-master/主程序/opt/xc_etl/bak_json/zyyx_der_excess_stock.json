{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      id,
                                      company_code,
                                      stock_code,
                                      stock_name,
                                      report_year,
                                      report_quarter,
                                      declare_date,
                                      appraisal_date,
                                      is_prediction,
                                      excess_standard,
                                      excess_type,
                                      act_np,
                                      con_np,
                                      excess_rate,
                                      organ_num,
                                      excess_on,
                                      entrytime,
                                      updatetime,
                                      tmstamp,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'zyyx_der_excess_stock.json' as task_rs_id
                                from ${srcoradbname}.der_excess_stock"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${is_kbs}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/zyyx_der_excess_stock",
                        "fileName": "zyyx_der_excess_stock",
                        "column": [
                                      {"name":"id","type":"bigint"},
                                      {"name":"company_code","type":"string"},
                                      {"name":"stock_code","type":"string"},
                                      {"name":"stock_name","type":"string"},
                                      {"name":"report_year","type":"bigint"},
                                      {"name":"report_quarter","type":"bigint"},
                                      {"name":"declare_date","type":"timestamp"},
                                      {"name":"appraisal_date","type":"timestamp"},
                                      {"name":"is_prediction","type":"bigint"},
                                      {"name":"excess_standard","type":"bigint"},
                                      {"name":"excess_type","type":"bigint"},
                                      {"name":"act_np","type":"double"},
                                      {"name":"con_np","type":"double"},
                                      {"name":"excess_rate","type":"double"},
                                      {"name":"organ_num","type":"bigint"},
                                      {"name":"excess_on","type":"bigint"},
                                      {"name":"entrytime","type":"timestamp"},
                                      {"name":"updatetime","type":"timestamp"},
                                      {"name":"tmstamp","type":"bigint"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}