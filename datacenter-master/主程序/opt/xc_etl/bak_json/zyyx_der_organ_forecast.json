{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      id,
                                      group_code,
                                      group_name,
                                      group_type,
                                      organ_id,
                                      organ_name,
                                      con_date,
                                      con_year,
                                      pei,
                                      con_np,
                                      con_pe,
                                      entrytime,
                                      updatetime,
                                      tmstamp,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'zyyx_der_organ_forecast.json' as task_rs_id
                                from ${srcoradbname}.der_organ_forecast WHERE con_date BETWEEN '${beg_date}'||'01' AND to_char(add_months(to_date('${beg_date}'||'01','yyyyMMdd'),1)-1,'yyyyMMdd') "],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${is_kbs}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/zyyx_der_organ_forecast/busi_month=${busi_month}",
                        "fileName": "zyyx_der_organ_forecast",
                        "column": [
                                      {"name":"id","type":"bigint"},
                                      {"name":"group_code","type":"string"},
                                      {"name":"group_name","type":"string"},
                                      {"name":"group_type","type":"bigint"},
                                      {"name":"organ_id","type":"bigint"},
                                      {"name":"organ_name","type":"string"},
                                      {"name":"con_date","type":"timestamp"},
                                      {"name":"con_year","type":"bigint"},
                                      {"name":"pei","type":"double"},
                                      {"name":"con_np","type":"double"},
                                      {"name":"con_pe","type":"double"},
                                      {"name":"entrytime","type":"timestamp"},
                                      {"name":"updatetime","type":"timestamp"},
                                      {"name":"tmstamp","type":"bigint"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}