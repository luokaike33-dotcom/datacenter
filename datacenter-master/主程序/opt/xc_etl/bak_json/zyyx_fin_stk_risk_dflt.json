{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "oraclereader",
                    "parameter": {
                        "username": "${srcorausername}",
                        "password": "${srcorapassword}",
                        "where": "",
                        "connection": [
                            {
                                "querySql": ["
                                select 
                                      id,
                                      label_item,
                                      label_name,
                                      label_code,
                                      stock_code,
                                      stock_name,
                                      trade_date,
                                      report_date,
                                      title,
                                      is_valid,
                                      entrytime,
                                      updatetime,
                                      tmstamp,
                                      to_char(sysdate - 1, 'yyyymmdd') as bath_dt,
                                      cast(sysdate as timestamp) as data_ins_time,
                                      'zyyx_fin_stk_risk_dflt.json' as task_rs_id
                                from ${srcoradbname}.fin_stk_risk_dflt"],
                                "jdbcUrl": ["jdbc:oracle:thin:@${srcoraurl}"]
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://${tgrhdfsurl}",
                        "fileType": "orc",
                        "haveKerberos": "${is_kbs}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}",
                        "path": "${tgrhivedbpath}/zyyx_fin_stk_risk_dflt",
                        "fileName": "zyyx_fin_stk_risk_dflt",
                        "column": [
                                      {"name":"id","type":"bigint"},
                                      {"name":"label_item","type":"string"},
                                      {"name":"label_name","type":"string"},
                                      {"name":"label_code","type":"string"},
                                      {"name":"stock_code","type":"string"},
                                      {"name":"stock_name","type":"string"},
                                      {"name":"trade_date","type":"timestamp"},
                                      {"name":"report_date","type":"timestamp"},
                                      {"name":"title","type":"string"},
                                      {"name":"is_valid","type":"bigint"},
                                      {"name":"entrytime","type":"timestamp"},
                                      {"name":"updatetime","type":"timestamp"},
                                      {"name":"tmstamp","type":"bigint"},
                                      {"name":"bath_dt","type":"string"},
                                      {"name":"data_ins_time","type":"timestamp"},
                                      {"name":"task_rs_id","type":"string"}
                        ],
                        "writeMode": "append",
                        "fieldDelimiter": "\t",
                        "encoding":"utf-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
            }
    }
}