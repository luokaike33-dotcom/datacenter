table:pty_ins_oneid_rela_info_log  机构oneidlog表
cols:
    ins_id              varchar2(100)    机构内码
    com_code            varchar2(100)     公司编号
    src_com_id          varchar2(50)    来源机构编号
    reg_num_biz         varchar2(100)   统一社会信用代码
    busi_date           bigint         业务日期
    task_rs_id          varchar2(100)  任务来源标识
    dm_created_time     timestamp      数据中台创建时间
    sys_rs_id           varchar2(20)   系统来源标识
    log_update_by varchar2(256)
    log_update_at timestamp
    log_state     varchar2(1)
partition:
    [cdh,tdh]sys_rs_id
cluster:

index：
