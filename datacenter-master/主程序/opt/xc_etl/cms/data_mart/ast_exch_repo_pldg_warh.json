{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									prd_code,
									ast_unit_code,
									pfl_code,
									sh_code,
									seat_code,
									occu_dt,
									inv_typ,
									pldg_secu_id,
									pldg_src_secu_id,
									pldg_vol,
									curr_pldg_vol,
									curr_tubk_vol,
									curr_parv,
									covt_rate,
									covt_std_secu_vol,
									busi_date,
									task_rs_id,
									dm_created_time,
									p_dt,
									sys_rs_id
							FROM ${srcdbname}.ast_exch_repo_pldg_warh where p_dt between ${beg_date} and ${end_date} "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"prd_code",
									"ast_unit_code",
									"pfl_code",
									"sh_code",
									"seat_code",
									"occu_dt",
									"inv_typ",
									"pldg_secu_id",
									"pldg_src_secu_id",
									"pldg_vol",
									"curr_pldg_vol",
									"curr_tubk_vol",
									"curr_parv",
									"covt_rate",
									"covt_std_secu_vol",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"p_dt",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["ast_exch_repo_pldg_warh"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from ast_exch_repo_pldg_warh where p_dt between ${beg_date} and ${end_date}"]
                    }
                }
            }
        ] 
    }
}


