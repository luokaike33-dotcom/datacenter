{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd":"beeline",
                        "hiveSql":["SELECT prd_code, secu_id, typ_code, inv_typ, pos_id, income, weight, yield, total_yield, yield_contrib, total_yield_contrib, lastwkd_port_nav_assets, day_buy_amount, ast_stat, busi_date, task_rs_id, dm_created_time, dm_src_info, p_dt, sys_rs_id
                        FROM ${srcdbname}.dw_prd_hld_income where p_dt = ${p_dt}"],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath":"${srchivedbpath}",
                        "tmpDatabase":"${srcdbname}",
                        "hive_jdbc_url":"jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name":"${srcusername}",
                        "hive_ldap_password":"${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"prd_code",
									"secu_id",
									"typ_code",
									"inv_typ",
									"pos_id",
									"income",
									"weight",
									"yield",
									"total_yield",
									"yield_contrib",
									"total_yield_contrib",
									"lastwkd_port_nav_assets",
									"day_buy_amount",
									"ast_stat",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"dm_src_info",
                                    "p_dt",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["dw_prd_hld_income"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from dw_prd_hld_income where p_dt< to_number(to_char(to_date(to_char(${p_dt}),'yyyyMMdd') -730 ,'yyyyMMdd')) or p_dt =${p_dt}"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


