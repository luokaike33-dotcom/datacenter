{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":1}
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									id,
									tradedate,
									secode,
									symbol,
									indexname,
									constskcode,
									constskname,
									weight,
									cirweight,
									isvalid,
									tmstamp,
									entrydate,
									entrytime,
									batchno,
									inserttime,
									updatetime,
									task_rs_id,
									p_dt
							FROM ${srcdbname}.fc_tq_ix_impixweight where p_dt between ${beg_date} and ${end_date} "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"id",
									"tradedate",
									"secode",
									"symbol",
									"indexname",
									"constskcode",
									"constskname",
									"weight",
									"cirweight",
									"isvalid",
									"tmstamp",
									"entrydate",
									"entrytime",
									"batchno",
									"inserttime",
									"updatetime",
									"task_rs_id",
									"p_dt"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["fc_tq_ix_impixweight"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from fc_tq_ix_impixweight where p_dt between ${beg_date} and ${end_date}"]
                    }
                }
            }
        ] 
    }
}


