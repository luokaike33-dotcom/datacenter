{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
						"hive_cmd":"beeline",
						"hiveSql":["SELECT id, tradedate, secode, `exchange`, bondname, bondtype, netprice, dirtyprice, accruedinterest, termtomaturity, yield, duration, modduration, convexity, spread, spreadduration, interestconvexity, spreadconvexity, basispointval, tradableamount, interestduration, dirtypriceday, dayaccrinte, surplusprin, datasource, valuationtype, tmstamp, isvalid, entrydate, entrytime, yccode, ycname, ecrate, spreadyield, bath_dt, data_ins_time, task_rs_id, busi_month
						FROM ty_ods.fc_tq_qt_cbestimate where busi_month between substr(cast(${beg_date} as string),1,6) and substr(cast(${end_date} as string),1,6)
						"],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath":"${srchivedbpath}",
                        "tmpDatabase":"${srcdbname}",
                        "hive_jdbc_url":"jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name":"${srcusername}",
                        "hive_ldap_password":"${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"id",
									"tradedate",
									"secode",
									"exchange",
									"bondname",
									"bondtype",
									"netprice",
									"dirtyprice",
									"accruedinterest",
									"termtomaturity",
									"yield",
									"duration",
									"modduration",
									"convexity",
									"spread",
									"spreadduration",
									"interestconvexity",
									"spreadconvexity",
									"basispointval",
									"tradableamount",
									"interestduration",
									"dirtypriceday",
									"dayaccrinte",
									"surplusprin",
									"datasource",
									"valuationtype",
                  "tmstamp",
									"isvalid",
									"entrydate",
									"entrytime",
									"yccode",
									"ycname",
									"ecrate",
									"spreadyield",
									"bath_dt", 
                  "data_ins_time", 
                  "task_rs_id",
									"busi_month"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["fc_tq_qt_cbestimate"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from  fc_tq_qt_cbestimate where busi_month between substr(to_char(${beg_date}),1,6) and substr(to_char(${end_date}),1,6) "]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


