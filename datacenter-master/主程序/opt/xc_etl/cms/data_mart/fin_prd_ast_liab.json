{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":1}
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									prd_code,
									acc_year,
									acc_mth,
									proj_no,
									proj_name,
									bgng_bal,
									end_bal,
									t_date,
									proj_idx_id,
									busi_date,
									upd_time,
									sys_rs_id,
									task_rs_id,
									dm_src_info,
									dm_created_time,
									dm_created_by,
									dm_updated_time,
									dm_updated_by,
									p_dt
							FROM ${srcdbname}.fin_prd_ast_liab where p_dt between ${beg_date} and ${end_date}"],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"prd_code",
									"acc_year",
									"acc_mth",
									"proj_no",
									"proj_name",
									"bgng_bal",
									"end_bal",
									"t_date",
									"proj_idx_id",
									"busi_date",
									"upd_time",
									"sys_rs_id",
									"task_rs_id",
									"dm_src_info",
									"dm_created_time",
									"dm_created_by",
									"dm_updated_time",
									"dm_updated_by",
									"p_dt"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["fin_prd_ast_liab"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from fin_prd_ast_liab where (p_dt < to_number(to_char(to_date(to_char(${end_date}), 'yyyyMMdd') -180, 'yyyyMMdd'))) or (p_dt between ${beg_date} and ${end_date})"]
                    }
                }
            }
        ] 
    }
}


