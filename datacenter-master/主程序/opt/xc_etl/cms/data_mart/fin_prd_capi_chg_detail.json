{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":1}
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									prd_code,
									chg_dt,
									capi_chg_typ,
									shr_add,
									capi_add,
									capi_add_fee,
									shr_reduce,
									capi_reduce,
									capi_reduce_fee,
									busi_date,
									task_rs_id,
									dm_created_time,
									dm_src_info,
									p_dt,
									sys_rs_id
							FROM ${srcdbname}.fin_prd_capi_chg_detail where p_dt between ${beg_date} and ${end_date} "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"prd_code",
									"chg_dt",
									"capi_chg_typ",
									"shr_add",
									"capi_add",
									"capi_add_fee",
									"shr_reduce",
									"capi_reduce",
									"capi_reduce_fee",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"dm_src_info",
									"p_dt",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["fin_prd_capi_chg_detail"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from fin_prd_capi_chg_detail where p_dt between ${beg_date} and ${end_date}"]
                    }
                }
            }
        ] 
    }
}


