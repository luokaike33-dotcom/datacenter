{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {

                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
						    SELECT prd_code, vou_dt, acc_year, acc_mth, vou_typ, vou_typ_name, vou_clafy, vou_no, vou_etnb, vou_abs, crse_code, crse_dir, crse_dim, crse_dim_code, crse_type, crse_typ, inv_typ, cir_id, secu_code, secu_name, secu_typ, secu_typi, secu_typii, mkt_typ, ast_stat, curr_code, pos_dir, trd_typ, lcrrc_deb_val, lcrrc_cs_val, frc_val, sett_crrc, vol, excr, is_true, is_add_manu, busi_date, task_rs_id, dm_created_time, dm_src_info, p_dt, sys_rs_id
						FROM ${srcdbname}.fin_prd_vou_min WHERE p_dt between ${beg_date} and ${end_date} "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"prd_code",
									"vou_dt",
									"acc_year",
									"acc_mth",
									"vou_typ",
									"vou_typ_name",
									"vou_clafy",
									"vou_no",
									"vou_etnb",
									"vou_abs",
									"crse_code",
									"crse_dir",
									"crse_dim",
									"crse_dim_code",
									"crse_type",
									"crse_typ",
									"inv_typ",
									"cir_id",
									"secu_code",
									"secu_name",
									"secu_typ",
									"secu_typi",
									"secu_typii",
									"mkt_typ",
									"ast_stat",
									"curr_code",
									"pos_dir",
									"trd_typ",
									"lcrrc_deb_val",
									"lcrrc_cs_val",
									"frc_val",
									"sett_crrc",
									"vol",
									"excr",
									"is_true",
									"is_add_manu",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"dm_src_info",
									"p_dt",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["fin_prd_vou_min"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from fin_prd_vou_min where p_dt between ${beg_date} and ${end_date} "]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


