{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":1}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/fin_trade_lock",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"long"},
									{"index":8,"type":"double"},
									{"index":9,"type":"double"},
									{"index":10,"type":"double"},
									{"index":11,"type":"double"},
									{"index":12,"type":"long"},
									{"index":13,"type":"long"},
									{"index":14,"type":"long"},
									{"index":15,"type":"long"},
									{"index":16,"type":"long"},
									{"index":17,"type":"string"},
									{"index":18,"type":"date"},
									{"value":"","type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"jour_no",
									"prd_code",
									"secu_id",
									"curr_code",
									"inv_typ",
									"iss_mode",
									"cir_stat",
									"lock_matu",
									"lock_vol",
									"lock_prc",
									"lock_cost",
									"lock_days_adj",
									"lock_bgn_dt",
									"lock_end_dt",
									"bgn_dt",
									"end_dt",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["fin_trade_lock"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table fin_trade_lock"]
                    }
                }
            }
        ] 
    }
}


