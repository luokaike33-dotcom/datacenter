{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/ims_t_ims_advice_order",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"long"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"string"},
									{"index":8,"type":"double"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"date"},
									{"index":12,"type":"date"},
									{"index":13,"type":"date"},
									{"index":14,"type":"long"},
									{"index":15,"type":"long"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"string"},
									{"index":19,"type":"date"},
									{"index":20,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"trading_day",
									"fund_id",
									"fund_name",
									"market_no",
									"stock_code",
									"stock_name",
									"direction",
									"order_type",
									"order_amount",
									"order_status",
									"comments",
									"commit_date",
									"order_date",
									"cancel_date",
									"hs_instruction_no",
									"qt_instruction_no",
									"instruction_status",
									"order_user_id",
									"bath_dt",
									"data_ins_time",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["ims_t_ims_advice_order"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table ims_t_ims_advice_order"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":0}
        }
    }
}


