{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/o3_tetm_monitor",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"long"},
									{"index":2,"type":"long"},
									{"index":3,"type":"long"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"string"},
									{"index":12,"type":"long"},
									{"index":13,"type":"long"},
									{"index":14,"type":"long"},
									{"index":15,"type":"long"},
									{"index":16,"type":"string"},
									{"index":17,"type":"long"},
									{"index":18,"type":"string"},
									{"index":19,"type":"string"},
									{"index":20,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"serial_no",
									"create_date",
									"create_time",
									"control_id",
									"monitor_summary",
									"inter_code_o32",
									"stock_name",
									"fund_id_list",
									"fund_name_list",
									"operator_list",
									"process_status",
									"etm_control_range",
									"entrust_serial_no",
									"warn_operation",
									"exempt_times",
									"cancel_serial_no",
									"search_flag",
									"batchno",
									"inserttime",
									"updatetime",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["o3_tetm_monitor"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table o3_tetm_monitor"]
                    }
                }
            }
        ] 
    }
}


