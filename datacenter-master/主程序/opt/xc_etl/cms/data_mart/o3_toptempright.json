{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/o3_toptempright",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"long"},
									{"index":5,"type":"long"},
									{"index":6,"type":"string"},
									{"index":7,"type":"long"},
									{"index":8,"type":"long"},
									{"index":9,"type":"long"},
									{"index":10,"type":"long"},
									{"index":11,"type":"long"},
									{"index":12,"type":"string"},
									{"index":13,"type":"long"},
									{"index":14,"type":"long"},
									{"index":15,"type":"string"},
									{"index":16,"type":"long"},
									{"index":17,"type":"long"},
									{"index":18,"type":"long"},
									{"index":19,"type":"long"},
									{"index":20,"type":"string"},
									{"index":21,"type":"string"},
									{"index":22,"type":"long"},
									{"index":23,"type":"long"},
									{"index":24,"type":"string"},
									{"index":25,"type":"string"},
									{"index":26,"type":"string"},
									{"index":27,"type":"date"},
									{"index":28,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"l_operator_no",
									"c_right_type",
									"c_right_operator",
									"vc_right",
									"l_asset_id",
									"l_basecombi_id",
									"vc_rights_id",
									"l_begin_date",
									"l_end_date",
									"l_grant_operator",
									"l_grant_date",
									"l_grant_time",
									"c_status",
									"l_input_operator",
									"l_date",
									"c_freeze_right",
									"l_serial_no",
									"l_begin_time",
									"l_end_time",
									"l_grant_order",
									"vc_ori_rights",
									"vc_new_rights",
									"l_begin_datetime",
									"l_end_datetime",
									"vc_timestamp",
									"c_deal_flag",
									"bath_dt",
									"data_ins_time",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["o3_toptempright"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table o3_toptempright"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


