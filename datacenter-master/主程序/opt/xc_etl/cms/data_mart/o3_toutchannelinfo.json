									"c_support_superchange",
									"en_change_ratio",
									"en_monetary_change_ratio",
									"vc_channel_flag",
									"c_channel_type",
									"batchno",
									"inserttime",
									"updatetime",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
