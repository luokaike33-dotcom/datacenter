{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/oa_uf_otc_derivates",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"long"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"long"},
									{"index":5,"type":"long"},
									{"index":6,"type":"double"},
									{"index":7,"type":"double"},
									{"index":8,"type":"double"},
									{"index":9,"type":"long"},
									{"index":10,"type":"double"},
									{"index":11,"type":"double"},
									{"index":12,"type":"double"},
									{"index":13,"type":"string"},
									{"index":14,"type":"string"},
									{"index":15,"type":"long"},
									{"index":16,"type":"long"},
									{"index":17,"type":"long"},
									{"index":18,"type":"string"},
									{"index":19,"type":"string"},
									{"index":20,"type":"long"},
									{"index":21,"type":"string"},
									{"index":22,"type":"string"},
									{"index":23,"type":"long"},
									{"index":24,"type":"string"},
									{"index":25,"type":"long"},
									{"index":26,"type":"long"},
									{"index":27,"type":"long"},
									{"index":28,"type":"long"},
									{"index":29,"type":"long"},
									{"index":30,"type":"long"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"id",
									"requestid",
									"bk_fundcode",
									"target",
									"start_date",
									"end_date",
									"notional_principal",
									"notional_count",
									"open_price",
									"real_date",
									"fix_income_rate",
									"trade_rate_start",
									"trade_rate_end",
									"trade_code",
									"target_name",
									"formmodeid",
									"modedatacreater",
									"modedatacreatertype",
									"modedatacreatedate",
									"modedatacreatetime",
									"derivative_name",
									"counterparty",
									"counterparty_name",
									"trade_flag",
									"derivative_name_yw",
									"is_element_rational",
									"is_relate_party",
									"is_white_list",
									"is_in_quota_range",
									"is_rate_compliance",
									"is_meet_require"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["oa_uf_otc_derivates"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table oa_uf_otc_derivates"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":0}
        }
    }
}


