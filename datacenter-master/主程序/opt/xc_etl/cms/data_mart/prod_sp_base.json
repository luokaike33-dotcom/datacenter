{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/prod_sp_base",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"long"},
									{"index":4,"type":"long"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"long"},
									{"index":11,"type":"string"},
									{"index":12,"type":"string"},
									{"index":13,"type":"long"},
									{"index":14,"type":"string"},
									{"index":15,"type":"string"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"string"},
									{"index":19,"type":"long"},
									{"index":20,"type":"string"},
									{"index":21,"type":"long"},
									{"index":22,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"mprd_code",
									"sprd_code",
									"sprd_short_name",
									"issue_start_date",
									"issue_end_date",
									"currency_code",
									"risk_level_code",
									"bef_bend_chag_clas",
									"life_prd_status",
									"lstg_type",
									"listing_date",
									"dk_listed_trd_place",
									"dk_share_type",
									"shares_add_date",
									"prd_inr_code",
									"inserttime",
									"updatetime",
									"delete_flag",
									"src_system",
									"last_update_request",
									"sprd_short_inr_name",
									"batchno",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["prod_sp_base"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table prod_sp_base"]
                    }
                }
            }
        ] 
    }
}


