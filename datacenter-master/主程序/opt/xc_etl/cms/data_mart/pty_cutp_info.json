{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/pty_cutp_info",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"long"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"string"},
									{"index":12,"type":"long"},
									{"index":13,"type":"string"},
									{"index":14,"type":"date"},
									{"value":"","type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"cutp_id",
									"cutp_no",
									"cntp_sht",
									"cntp_name",
									"cntp_typ",
									"conp",
									"tel",
									"eml",
									"ins_rela_typ",
									"main_ins_id",
									"main_ins_no",
									"main_ins_sht",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["pty_cutp_info"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from data_mart.pty_cutp_info"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


