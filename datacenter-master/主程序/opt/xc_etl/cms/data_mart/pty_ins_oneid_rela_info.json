{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/pty_ins_oneid_rela_info/sys_rs_id=${sys_rs_id}",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"long"},
									{"index":5,"type":"string"},
									{"index":6,"type":"date"},
									{"value":"${sys_rs_id}","type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"ins_id",
									"com_code",
									"src_com_id",
									"reg_num_biz",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["pty_ins_oneid_rela_info"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from data_mart.pty_ins_oneid_rela_info where sys_rs_id='${sys_rs_id}'"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


