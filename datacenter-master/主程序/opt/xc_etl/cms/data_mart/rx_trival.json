{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/rx_trival",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"long"},
									{"index":5,"type":"long"},
									{"index":6,"type":"string"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"long"},
									{"index":10,"type":"string"},
									{"index":11,"type":"string"},
									{"index":12,"type":"string"},
									{"index":13,"type":"string"},
									{"index":14,"type":"long"},
									{"index":15,"type":"long"},
									{"index":16,"type":"long"},
									{"index":17,"type":"long"},
									{"index":18,"type":"long"},
									{"index":19,"type":"string"},
									{"index":20,"type":"long"},
									{"index":21,"type":"string"},
									{"index":22,"type":"string"},
									{"index":23,"type":"long"},
									{"index":24,"type":"string"},
									{"index":25,"type":"string"},
									{"index":26,"type":"long"},
									{"index":27,"type":"string"},
									{"index":28,"type":"date"},
									{"index":29,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"rival_id",
									"rival_code",
									"traderival_name",
									"rival_fullname",
									"rival_type",
									"interbank_id",
									"bank_trusteeship_account",
									"shclearing_account",
									"interbank_organ_code",
									"rival_status",
									"remark",
									"address",
									"phone_code",
									"contact_name",
									"inner_credit",
									"outer_credit",
									"update_time",
									"issuer_id",
									"market_maker_flag",
									"trader_code",
									"master_rival_id",
									"mortgage_require",
									"sz_trader_code",
									"sz_investor_type",
									"sz_investor_code",
									"rival_mkt_type_list",
									"trader_flag",
									"bath_dt",
									"data_ins_time",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["rx_trival"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table rx_trival"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":0}
        }
    }
}


