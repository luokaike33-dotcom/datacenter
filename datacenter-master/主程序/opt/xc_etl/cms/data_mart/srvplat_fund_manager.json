{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/srvplat_fund_manager",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"long"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"string"},
									{"index":12,"type":"date"},
									{"index":13,"type":"double"},
									{"index":14,"type":"string"},
									{"index":15,"type":"date"},
									{"index":16,"type":"date"},
									{"index":17,"type":"string"},
									{"index":18,"type":"date"},
									{"index":19,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"vc_fundcode",
									"vc_fundname",
									"l_o32_fund_id",
									"vc_oa_id",
									"vc_oa_name",
									"vc_oa_username",
									"vc_oa_head_id",
									"vc_oa_head_name",
									"vc_oa_head_username",
									"vc_startdate",
									"vc_enddate",
									"vc_cleardate",
									"update_time",
									"batchno",
									"srcsys",
									"inserttime",
									"updatetime",
									"bath_dt",
									"data_ins_time",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["srvplat_fund_manager"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table srvplat_fund_manager"]
                    }
                }
            }
        ] 
    }
}


