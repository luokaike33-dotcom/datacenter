{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/t_qd_bond_info",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"long"},
									{"index":2,"type":"string"},
									{"index":3,"type":"long"},
									{"index":4,"type":"double"},
									{"index":5,"type":"double"},
									{"index":6,"type":"string"},
									{"index":7,"type":"double"},
									{"index":8,"type":"long"},
									{"index":9,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"id",
									"process_id",
									"isin_code",
									"quantity",
									"value",
									"earning_rate",
									"currency",
									"valuation_price",
									"bond_level",
									"counter_party"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["t_qd_bond_info"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table t_qd_bond_info"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


