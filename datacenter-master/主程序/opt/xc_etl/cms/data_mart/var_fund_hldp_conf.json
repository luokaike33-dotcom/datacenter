{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_fund_hldp_conf",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"long"},
									{"index":3,"type":"string"},
									{"index":4,"type":"double"},
									{"index":5,"type":"double"},
									{"index":6,"type":"double"},
									{"index":7,"type":"long"},
									{"index":8,"type":"string"},
									{"index":9,"type":"date"},
									{"index":10,"type":"double"},
									{"value":"","type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"main_secu_id",
									"subj_typ",
									"pub_dt",
									"supr_typ",
									"hld_val",
									"hld_nav_rat",
									"tot_ast_pct",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"stk_nav_rat",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["var_fund_hldp_conf"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table var_fund_hldp_conf"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


