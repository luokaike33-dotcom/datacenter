{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd":"beeline",
                        "hiveSql":["SELECT secu_id, trd_dt, shr_nval, tot_nval, shr_aggr_nval, unit_yld, ann_yld_rat, curr_code, aft_chk_unit_nval, chk_ftor, busi_date, task_rs_id, dm_created_time, p_dt, sys_rs_id
                        FROM ${srcdbname}.var_fund_nval_info where p_dt between ${beg_date} and ${end_date}"],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath":"${srchivedbpath}",
                        "tmpDatabase":"${srcdbname}",
                        "hive_jdbc_url":"jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name":"${srcusername}",
                        "hive_ldap_password":"${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"secu_id",
									"trd_dt",
									"shr_nval",
									"tot_nval",
									"shr_aggr_nval",
									"unit_yld",
									"ann_yld_rat",
									"curr_code",
									"aft_chk_unit_nval",
									"chk_ftor",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
                                    "p_dt",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["var_fund_nval_info"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":[""]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


