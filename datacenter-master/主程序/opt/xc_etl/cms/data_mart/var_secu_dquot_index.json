{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": [" select
               secu_id, trd_dt, trd_sts, prev_cls_prc, open_prc, high_prc, low_prc, avg_price, cls_prc, accr_intr, tnv_vol, tnv_val, tnv_deal, day_chg, day_chg_rat, day_amp, chk_ftor, aft_chk_open_prc, aft_chk_high_prc, aft_chk_low_prc, aft_chk_cls_prc, pb, pe_lyr, pe_ttm, pe_mrq, tnv_rat, curr_code, ttl_val, circ_val, divd_rate_lyr, pcf_lyr, peg, busi_date, dm_src_info, task_rs_id, dm_created_time, p_dt, sys_rs_id from ${srcdbname}.var_secu_dquot_index where p_dt  between ${beg_date} and ${end_date}  "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"secu_id",
									"trd_dt",
									"trd_sts",
									"prev_cls_prc",
									"open_prc",
									"high_prc",
									"low_prc",
									"avg_price",
									"cls_prc",
									"accr_intr",
									"tnv_vol",
									"tnv_val",
									"tnv_deal",
									"day_chg",
									"day_chg_rat",
									"day_amp",
									"chk_ftor",
									"aft_chk_open_prc",
									"aft_chk_high_prc",
									"aft_chk_low_prc",
									"aft_chk_cls_prc",
									"pb",
									"pe_lyr",
									"pe_ttm",
									"pe_mrq",
									"tnv_rat",
									"curr_code",
									"ttl_val",
									"circ_val",
									"divd_rate_lyr",
									"pcf_lyr",
									"peg",
									"busi_date",
									"dm_src_info",
									"task_rs_id",
									"dm_created_time",
                  "p_dt",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["var_secu_dquot_index"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from var_secu_dquot_index where p_dt  between ${beg_date} and ${end_date}   "]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


