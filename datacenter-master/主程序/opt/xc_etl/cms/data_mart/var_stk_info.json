{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/var_stk_info",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        
                        "column": [
                                    {"index":0,"type":"string"},
                                    {"index":1,"type":"string"},
                                    {"index":2,"type":"string"},
                                    {"index":3,"type":"string"},
                                    {"index":4,"type":"string"},
                                    {"index":5,"type":"string"},
                                    {"index":6,"type":"string"},
                                    {"index":7,"type":"string"},
                                    {"index":8,"type":"string"},
                                    {"index":9,"type":"string"},
                                    {"index":10,"type":"double"},
                                    {"index":11,"type":"string"},
                                    {"index":12,"type":"double"},
                                    {"index":13,"type":"string"},
                                    {"index":14,"type":"string"},
                                    {"index":15,"type":"string"},
                                    {"index":16,"type":"string"},
                                    {"index":17,"type":"long"},
                                    {"index":18,"type":"long"},
                                    {"index":19,"type":"string"},
                                    {"index":20,"type":"date"},
                                    
                                   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kerberosKeytabFilePath}",
                        "kerberosPrincipal": "${kerberosPrincipal}",
                        "kerberosConfFilePath": "${kerberosConfFilePath}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
                                    "secu_id",
                                    "com_id",
                                    "trd_code",
                                    "secu_sht",
                                    "chi_name",
                                    "lst_sect_code",
                                    "lst_sect_name",
                                    "exch_code",
                                    "exch_name",
                                    "curr_code",
                                    "par_val",
                                    "par_curr_code",
                                    "trd_unit",
                                    "stk_typ_code",
                                    "scal_dist",
                                    "secu_sht_long",
                                    "accty_typ",
                                    "hirc_code",
                                    "busi_date",
                                    "task_rs_id",
                                    "dm_created_time"
                                    
                        ],
                        "connection": [
                         {
                              "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                              "table": ["var_stk_info"]
                          }
                        ], 
                        "password": "${tgrpassword}",
                        "username": "${tgrusername}",
                        "preSql":["truncate table var_stk_info"]
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": "1"
            }
        }
    }
}
