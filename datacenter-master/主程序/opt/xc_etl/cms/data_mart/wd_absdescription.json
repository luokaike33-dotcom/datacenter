{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/w_absdescription",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"double"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"long"},
									{"index":12,"type":"string"},
									{"index":13,"type":"string"},
									{"index":14,"type":"string"},
									{"index":15,"type":"string"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"long"},
									{"index":19,"type":"long"},
									{"index":20,"type":"long"},
									{"index":21,"type":"long"},
									{"index":22,"type":"string"},
									{"index":23,"type":"string"},
									{"index":24,"type":"string"},
									{"index":25,"type":"string"},
									{"index":26,"type":"long"},
									{"index":27,"type":"date"},
									{"index":28,"type":"string"},
									{"index":29,"type":"string"},
									{"index":30,"type":"date"},
									{"index":31,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"abs_name",
									"abs_shortname",
									"sponor",
									"sponorid",
									"issuer",
									"issuerid",
									"issueamount",
									"crncy_code",
									"pool_name",
									"start_dt",
									"asset_type",
									"delivery_dt",
									"setup_dt",
									"first_pay_dt",
									"maturity_dt",
									"ann_dt",
									"abs_asset",
									"abs_block_code",
									"is_internal_credit",
									"is_external_credit",
									"assets_is_table",
									"abs_id",
									"act_maturity_dt",
									"start_date",
									"end_date",
									"assetout_status",
									"opdate",
									"opmode",
									"bath_dt",
									"data_ins_time",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_absdescription"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table wd_absdescription"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


