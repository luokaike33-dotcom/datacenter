{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":1}
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									object_id,
									trade_dt,
									s_info_windcode,
									indexname,
									indexname_eng,
									s_con_windcode,
									`exchange`,
									tot_shr,
									free_shr_ratio,
									shr_calculation,
									weightfactor,
									closevalue,
									open_adjusted,
									tot_mv,
									mv_calculation,
									weight,
									opdate,
									opmode,
									busi_month
							FROM ${srcdbname}.w_aindexcsi500weight WHERE busi_month=${busi_month} "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"trade_dt",
									"s_info_windcode",
									"indexname",
									"indexname_eng",
									"s_con_windcode",
									"exchange",
									"tot_shr",
									"free_shr_ratio",
									"shr_calculation",
									"weightfactor",
									"closevalue",
									"open_adjusted",
									"tot_mv",
									"mv_calculation",
									"weight",
									"opdate",
									"opmode",
									"busi_month"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_aindexcsi500weight"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["DELETE FROM wd_aindexcsi500weight WHERE busi_month=${busi_month}"]
                    }
                }
            }
        ]
    }
}


