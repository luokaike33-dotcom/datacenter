{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									object_id,
									s_info_windcode,
									trade_dt,
									b_info_type,
									b_info_listingmarketnumbers,
									b_anal_dirty_csi,
									b_anal_yield_csi,
									b_anal_modidura_csi,
									b_anal_cnvxty_csi,
									b_anal_net_csi,
									b_anal_accrint_csi,
									b_anal_full_ifexe,
									b_anal_net_ifexe,
									b_anal_ytm_ifexe,
									b_anal_modidura_ifexe,
									b_anal_cnvxty_ifexe,
									recommended,
									b_anal_est_couponrate,
									busi_month
							FROM ${srcdbname}.w_cbondanalysiscsi WHERE cast(busi_month as string) between substr(cast(${beg_date} as string),1,6) and substr(cast(${end_date} as string),1,6)"],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"s_info_windcode",
									"trade_dt",
									"b_info_type",
									"b_info_listingmarketnumbers",
									"b_anal_dirty_csi",
									"b_anal_yield_csi",
									"b_anal_modidura_csi",
									"b_anal_cnvxty_csi",
									"b_anal_net_csi",
									"b_anal_accrint_csi",
									"b_anal_full_ifexe",
									"b_anal_net_ifexe",
									"b_anal_ytm_ifexe",
									"b_anal_modidura_ifexe",
									"b_anal_cnvxty_ifexe",
									"recommended",
									"b_anal_est_couponrate",
									"busi_month"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_cbondanalysiscsi"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["DELETE FROM wd_cbondanalysiscsi WHERE cast(busi_month as varchar2(50)) between substr(cast(${beg_date} as varchar2(50)),1,6) and substr(cast(${end_date} as varchar2(50)),1,6)"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


