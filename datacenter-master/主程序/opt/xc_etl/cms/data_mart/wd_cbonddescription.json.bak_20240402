{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
						select 
						object_id,
						s_info_windcode,
						b_info_fullname,
						b_info_issuer,
						b_issue_announcement,
						b_issue_firstissue,
						b_issue_lastissue,
						b_issue_amountplan,
						b_issue_amountact,
						b_info_issueprice,
						b_info_par,
						b_info_couponrate,
						b_info_spread,
						b_info_carrydate,
						b_info_enddate,
						b_info_maturitydate,
						b_info_term_year_,
						b_info_term_day_,
						b_info_paymentdate,
						b_info_paymenttype,
						b_info_interestfrequency,
						b_info_form,
						b_info_coupon,
						b_info_interesttype,
						b_info_act,
						b_issue_fee,
						b_redemption_feeration,
						b_info_taxrate,
						crncy_code,
						s_info_name,
						s_info_exchmarket,
						b_info_guarantor,
						b_info_guartype,
						b_info_listdate,
						b_info_yearsnumber,
						s_div_recorddate,
						b_info_codebyplacing,
						b_info_delistdate,
						b_info_issuetype,
						b_info_guarintroduction,
						b_info_bgndbyplacing,
						b_info_enddbyplacing,
						b_info_amountbyplacing,
						b_info_underwritingcode,
						b_info_issuercode,
						b_info_formercode,
						b_info_coupontxt,
						is_failure,
						is_crossmarket,
						b_info_coupondatetxt,
						b_info_subordinateornot,
						b_tendrst_referyield,
						b_info_curpar,
						s_info_formerwindcode,
						is_corporate_bond,
						b_info_issuertype,
						b_info_specialbondtype,
						is_payadvanced,
						is_callable,
						is_chooseright,
						is_netprice,
						is_act_days,
						is_incbonds,
						issue_object,
						b_info_actualbenchmark,
						register_file_type_code,
						register_file_number,
						list_ann_date,
						reimbursement,
						bond_rating,
						ann_date,
						b_issue_amount_max,
						b_info_guarantee_id,
						b_info_pinyin,
						trade_type_code,
						is_taxfree,
						opdate,
						opmode,
						is_inright,
						accounttreatment_type
				  from ${srcdbname}.w_cbonddescription "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"s_info_windcode",
									"b_info_fullname",
									"b_info_issuer",
									"b_issue_announcement",
									"b_issue_firstissue",
									"b_issue_lastissue",
									"b_issue_amountplan",
									"b_issue_amountact",
									"b_info_issueprice",
									"b_info_par",
									"b_info_couponrate",
									"b_info_spread",
									"b_info_carrydate",
									"b_info_enddate",
									"b_info_maturitydate",
									"b_info_term_year_",
									"b_info_term_day_",
									"b_info_paymentdate",
									"b_info_paymenttype",
									"b_info_interestfrequency",
									"b_info_form",
									"b_info_coupon",
									"b_info_interesttype",
									"b_info_act",
									"b_issue_fee",
									"b_redemption_feeration",
									"b_info_taxrate",
									"crncy_code",
									"s_info_name",
									"s_info_exchmarket",
									"b_info_guarantor",
									"b_info_guartype",
									"b_info_listdate",
									"b_info_yearsnumber",
									"s_div_recorddate",
									"b_info_codebyplacing",
									"b_info_delistdate",
									"b_info_issuetype",
									"b_info_guarintroduction",
									"b_info_bgndbyplacing",
									"b_info_enddbyplacing",
									"b_info_amountbyplacing",
									"b_info_underwritingcode",
									"b_info_issuercode",
									"b_info_formercode",
									"b_info_coupontxt",
									"is_failure",
									"is_crossmarket",
									"b_info_coupondatetxt",
									"b_info_subordinateornot",
									"b_tendrst_referyield",
									"b_info_curpar",
									"s_info_formerwindcode",
									"is_corporate_bond",
									"b_info_issuertype",
									"b_info_specialbondtype",
									"is_payadvanced",
									"is_callable",
									"is_chooseright",
									"is_netprice",
									"is_act_days",
									"is_incbonds",
									"issue_object",
									"b_info_actualbenchmark",
									"register_file_type_code",
									"register_file_number",
									"list_ann_date",
									"reimbursement",
									"bond_rating",
									"ann_date",
									"b_issue_amount_max",
									"b_info_guarantee_id",
									"b_info_pinyin",
									"trade_type_code",
									"is_taxfree",
									"opdate",
									"opmode",
									"is_inright",
									"accounttreatment_type"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_cbonddescription"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table wd_cbonddescription"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


