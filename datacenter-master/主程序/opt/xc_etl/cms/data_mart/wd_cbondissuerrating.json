{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/w_cbondissuerrating",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"long"},
									{"index":6,"type":"string"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"long"},
									{"index":12,"type":"string"},
									{"index":13,"type":"date"},
									{"index":14,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"s_info_compname",
									"ann_dt",
									"b_rate_style",
									"b_info_creditrating",
									"b_rate_ratingoutlook",
									"b_info_creditratingagency",
									"s_info_compcode",
									"b_info_creditratingexplain",
									"b_info_precreditrating",
									"b_creditrating_change",
									"b_info_issuerratetype",
									"ann_dt2",
									"opdate",
									"opmode"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_cbondissuerrating"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table wd_cbondissuerrating"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


