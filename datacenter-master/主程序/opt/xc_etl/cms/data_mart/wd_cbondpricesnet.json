{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									object_id,
									s_info_windcode,
									trade_dt,
									b_dq_open,
									b_dq_high,
									b_dq_low,
									b_dq_originclose,
									b_dq_volume,
									b_dq_amount,
									opdate,
									opmode,
									busi_month
							FROM ${srcdbname}.w_cbondpricesnet WHERE busi_month  between cast(substr(cast(${beg_date} as string),1,6) as decimal(8,0)) 
                            and cast(substr(cast(${end_date} as string),1,6) as decimal(8,0)) "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"s_info_windcode",
									"trade_dt",
									"b_dq_open",
									"b_dq_high",
									"b_dq_low",
									"b_dq_originclose",
									"b_dq_volume",
									"b_dq_amount",
									"opdate",
									"opmode",
									"busi_month"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_cbondpricesnet"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["DELETE FROM wd_cbondpricesnet WHERE busi_month between cast(substr(cast(${beg_date} as varchar2(10)),1,6) as number(8,0)) 
						and cast(substr(cast(${end_date} as varchar2(10)),1,6) as number(8,0))"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


