{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
					    "hive_cmd":"beeline",
                        "hiveSql":["SELECT object_id, s_info_windcode, trade_dt, b_anal_duration, b_anal_modifiedduration, b_anal_bduration, b_anal_sduration, b_anal_convexity, b_anal_accrueddays, b_anal_accruedinterest, b_anal_ytc, b_anal_ytp, b_anal_ptmyear, b_anal_ytm, b_info_weightedrt, b_anal_ytm_interest, b_anal_ytm_compound, b_anal_ytm_compound_be, b_anal_ytm_open, b_anal_ytm_high, b_anal_ytm_low, busi_month
                         FROM ${srcdbname}.w_cbondvaluation where busi_month between substr(cast(${beg_date} as string),1,6)  and substr(cast(${end_date} as string),1,6)
						"],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath":"${srchivedbpath}",
                        "tmpDatabase":"${srcdbname}",
                        "hive_jdbc_url":"jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name":"${srcusername}",
                        "hive_ldap_password":"${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"s_info_windcode",
									"trade_dt",
									"b_anal_duration",
									"b_anal_modifiedduration",
									"b_anal_bduration",
									"b_anal_sduration",
									"b_anal_convexity",
									"b_anal_accrueddays",
									"b_anal_accruedinterest",
									"b_anal_ytc",
									"b_anal_ytp",
									"b_anal_ptmyear",
									"b_anal_ytm",
									"b_info_weightedrt",
									"b_anal_ytm_interest",
									"b_anal_ytm_compound",
									"b_anal_ytm_compound_be",
									"b_anal_ytm_open",
									"b_anal_ytm_high",
									"b_anal_ytm_low",
                                    "busi_month"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_cbondvaluation"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from wd_cbondvaluation where busi_month between substr(cast(${beg_date} as varchar2(50)),1,6)  and substr(cast(${end_date} as varchar2(50)),1,6) "]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


