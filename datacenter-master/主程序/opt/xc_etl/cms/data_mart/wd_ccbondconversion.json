{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/w_ccbondconversion",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"double"},
									{"index":6,"type":"string"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"double"},
									{"index":12,"type":"double"},
									{"index":13,"type":"long"},
									{"index":14,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"s_info_windcode",
									"ann_dt",
									"conv_code",
									"conv_name",
									"conv_price",
									"crncy_code",
									"conv_startdate",
									"conv_enddate",
									"trade_dt_last",
									"forced_conv_date",
									"forced_conv_price",
									"rel_conv_month",
									"isforced",
									"forced_conv_reason"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_ccbondconversion"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table wd_ccbondconversion"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


