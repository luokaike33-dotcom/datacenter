{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									object_id,
									s_info_windcode,
									trade_dt,
									crncy_code,
									s_dq_preclose,
									s_dq_open,
									s_dq_high,
									s_dq_low,
									s_dq_close,
									s_dq_change,
									s_dq_pctchange,
									s_dq_volume,
									s_dq_amount,
									s_dq_adjpreclose,
									s_dq_adjopen,
									s_dq_adjhigh,
									s_dq_adjlow,
									s_dq_adjclose,
									s_dq_adjfactor,
									trades_count,
									discount_rate,
									s_dq_avgprice,
									opdate,
									opmode,
									busi_month
							FROM ${srcdbname}.w_chinaclosedfundeodprice "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"s_info_windcode",
									"trade_dt",
									"crncy_code",
									"s_dq_preclose",
									"s_dq_open",
									"s_dq_high",
									"s_dq_low",
									"s_dq_close",
									"s_dq_change",
									"s_dq_pctchange",
									"s_dq_volume",
									"s_dq_amount",
									"s_dq_adjpreclose",
									"s_dq_adjopen",
									"s_dq_adjhigh",
									"s_dq_adjlow",
									"s_dq_adjclose",
									"s_dq_adjfactor",
									"trades_count",
									"discount_rate",
									"s_dq_avgprice",
									"opdate",
									"opmode",
									"busi_month"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_chinaclosedfundeodprice"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table wd_chinaclosedfundeodprice "]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


