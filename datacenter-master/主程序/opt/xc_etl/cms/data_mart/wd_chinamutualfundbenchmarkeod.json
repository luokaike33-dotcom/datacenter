{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									object_id, 
                                    s_info_windcode, 
                                    trade_dt, 
                                    s_dq_close, 
                                    s_dq_pctchange, 
                                    opdate, 
                                    opmode
							FROM ${srcdbname}.w_chinamutualfundbenchmarkeod where trade_dt between ${beg_date} and ${end_date}"],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id", 
                                    "s_info_windcode", 
                                    "trade_dt", 
                                    "s_dq_close", 
                                    "s_dq_pctchange", 
                                    "opdate", 
                                    "opmode"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_chinamutualfundbenchmarkeod"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from wd_chinamutualfundbenchmarkeod where trade_dt between ${beg_date} and ${end_date}"]
                    }
                }
            }
        ] 
    }
}


