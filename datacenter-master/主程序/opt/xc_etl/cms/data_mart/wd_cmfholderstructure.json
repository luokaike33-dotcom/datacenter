									"holder_feeder_holding",
									"holder_feeder_holdingpct",
									"pur_cost",
									"sell_income",
									"is_merge_data",
									"opdate",
									"opmode",
									"bath_dt",
									"data_ins_time",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
