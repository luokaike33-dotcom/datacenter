{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/w_cmfindexeod",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"double"},
									{"index":6,"type":"double"},
									{"index":7,"type":"double"},
									{"index":8,"type":"double"},
									{"index":9,"type":"double"},
									{"index":10,"type":"double"},
									{"index":11,"type":"double"},
									{"index":12,"type":"string"},
									{"index":13,"type":"double"},
									{"index":14,"type":"double"},
									{"index":15,"type":"date"},
									{"index":16,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"s_info_windcode",
									"s_info_name",
									"trade_dt",
									"crncy_code",
									"s_dq_preclose",
									"s_dq_open",
									"s_dq_high",
									"s_dq_low",
									"s_dq_close",
									"s_dq_volume",
									"s_dq_amount",
									"sec_id",
									"s_dq_change",
									"s_dq_pctchange",
									"opdate",
									"opmode"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_cmfindexeod"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table wd_cmfindexeod"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


