{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/w_hkindexdescription",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"double"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"string"},
									{"index":12,"type":"string"},
									{"index":13,"type":"string"},
									{"index":14,"type":"long"},
									{"index":15,"type":"long"},
									{"index":16,"type":"long"},
									{"index":17,"type":"long"},
									{"index":18,"type":"long"},
									{"index":19,"type":"long"},
									{"index":20,"type":"long"},
									{"index":21,"type":"string"},
									{"index":22,"type":"string"},
									{"index":23,"type":"date"},
									{"index":24,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"s_info_windcode",
									"s_info_code",
									"s_info_name",
									"s_info_compname",
									"s_info_exchmarket",
									"s_info_index_baseper",
									"s_info_index_basept",
									"s_info_listdate",
									"s_info_index_style",
									"s_info_index_ename",
									"weight_type",
									"weighting_method_start_date",
									"weighting_method_end_date",
									"component_stocks_num",
									"index_region_code",
									"index_category_code",
									"exponential_scale_code",
									"weight_type_code",
									"market_own_code",
									"income_processing_method",
									"expire_date",
									"index_category_type",
									"opdate",
									"opmode"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_hkindexdescription"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table wd_hkindexdescription"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


