{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									object_id,
									seqid,
									caseid,
									caseno,
									casetitle,
									casereasoncode,
									casereasonname,
									judgetime,
									publishtime,
									caseamount,
									doctypename,
									doctypecode,
									casetypename,
									casetypecode,
									judgeprogramname,
									judgeprogramcode,
									courtname,
									judgecontent,
									acceptfee,
									applyfee,
									securityfee,
									announcefee,
									caseclosed,
									courtlevel,
									courtlevelcode,
									opdate,
									opmode,
									bath_dt,
									data_ins_time,
									task_rs_id,
									busi_month
							FROM ${srcdbname}.w_riskbondjudgementinfo WHERE busi_month=${busi_month} "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"seqid",
									"caseid",
									"caseno",
									"casetitle",
									"casereasoncode",
									"casereasonname",
									"judgetime",
									"publishtime",
									"caseamount",
									"doctypename",
									"doctypecode",
									"casetypename",
									"casetypecode",
									"judgeprogramname",
									"judgeprogramcode",
									"courtname",
									"judgecontent",
									"acceptfee",
									"applyfee",
									"securityfee",
									"announcefee",
									"caseclosed",
									"courtlevel",
									"courtlevelcode",
									"opdate",
									"opmode",
									"bath_dt",
									"data_ins_time",
									"task_rs_id",
									"busi_month"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_riskbondjudgementinfo"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["DELETE FROM wd_riskbondjudgementinfo WHERE busi_month=${busi_month}"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


