{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/w_windcustomcode",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"string"},
									{"index":12,"type":"string"},
									{"index":13,"type":"string"},
									{"index":14,"type":"string"},
									{"index":15,"type":"string"},
									{"index":16,"type":"long"},
									{"index":17,"type":"string"},
									{"index":18,"type":"long"},
									{"index":19,"type":"double"},
									{"index":20,"type":"double"},
									{"index":21,"type":"string"},
									{"index":22,"type":"string"},
									{"index":23,"type":"long"},
									{"index":24,"type":"long"},
									{"index":25,"type":"string"},
									{"index":26,"type":"date"},
									{"index":27,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"s_info_windcode",
									"s_info_asharecode",
									"s_info_compcode",
									"s_info_securitiestypes",
									"s_info_sectypename",
									"s_info_countryname",
									"s_info_countrycode",
									"s_info_exchmarketname",
									"s_info_exchmarket",
									"crncy_name",
									"crncy_code",
									"s_info_isincode",
									"s_info_code",
									"s_info_name",
									"exchmarket",
									"security_status",
									"s_info_org_code",
									"s_info_typecode",
									"s_info_min_price_chg_unit",
									"s_info_lot_size",
									"s_info_ename",
									"trading_hours_code",
									"s_info_sectypebcode",
									"s_info_sectypescode",
									"s_info_pinyin",
									"opdate",
									"opmode"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_windcustomcode"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table wd_windcustomcode"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


