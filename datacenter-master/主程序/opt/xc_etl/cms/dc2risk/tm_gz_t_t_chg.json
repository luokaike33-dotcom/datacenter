{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/tm_gz_t_t_chg",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"long"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"long"},
									{"index":8,"type":"double"},
									{"index":9,"type":"double"},
									{"index":10,"type":"double"},
									{"index":11,"type":"double"},
									{"index":12,"type":"double"},
									{"index":13,"type":"double"},
									{"index":14,"type":"double"},
									{"index":15,"type":"double"},
									{"index":16,"type":"double"},
									{"index":17,"type":"double"},
									{"index":18,"type":"double"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"fdate",
									"posting_date",
									"fund_code",
									"market_no",
									"stock_code",
									"t_type",
									"currency",
									"oricurr",
									"t_amount",
									"t_balance",
									"t_balance_org",
									"t_net_balance",
									"t_net_balance_org",
									"t_net_price",
									"t_net_price_org",
									"t_price",
									"t_price_org",
									"t_fee",
									"t_fee_org"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["yhfinrisk.tm_gz_t_t_chg"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from yhfinrisk.tm_gz_t_t_chg where fdate  between ${beg_date}  and ${end_date}"]
                    }
                }
            }
        ] 
    }
}


