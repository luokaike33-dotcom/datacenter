{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/fa45_t_s_ie_item",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"long"},
									{"index":7,"type":"double"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"long"},
									{"index":11,"type":"string"},
									{"index":12,"type":"string"},
									{"index":13,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"c_ie_code",
									"c_ie_name",
									"c_dai_code_rec",
									"c_dai_code_cop",
									"c_dai_code_inc",
									"c_dai_code_fee",
									"n_order",
									"n_state",
									"c_ie_type",
									"c_sz_type",
									"batchno",
									"inserttime",
									"updatetime",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["fa45_t_s_ie_item"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table fa45_t_s_ie_item"]
                    }
                }
            }
        ] 
    }
}


