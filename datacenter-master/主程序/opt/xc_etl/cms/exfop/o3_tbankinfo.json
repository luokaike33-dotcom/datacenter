{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":1}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/o3_tbankinfo",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"long"},
									{"index":5,"type":"double"},
									{"index":6,"type":"string"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"double"},
									{"index":12,"type":"long"},
									{"index":13,"type":"long"},
									{"index":14,"type":"string"},
									{"index":15,"type":"string"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"string"},
									{"index":19,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"l_bank_no",
									"vc_bank_name",
									"vc_country_no",
									"c_custodian",
									"en_lastyear_capital",
									"en_capital_ratio",
									"vc_balance_setting",
									"vc_export_name",
									"vc_holding_setting",
									"vc_bic_code",
									"vc_bank_no",
									"en_core_capital_ratio",
									"l_issuer_id",
									"en_lastyear_asset",
									"c_bank_type",
									"c_outer_appraise",
									"c_inside_appraise",
									"vc_timestamp",
									"vc_fisp_bank_no",
									"c_status"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["o3_tbankinfo"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table o3_tbankinfo"]
                    }
                }
            }
        ] 
    }
}


