                    "parameter": {
                        "path": "${srchivedbpath}/o3_tentrustdirection",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
