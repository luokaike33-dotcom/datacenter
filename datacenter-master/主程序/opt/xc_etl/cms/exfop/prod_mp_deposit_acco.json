{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/prod_mp_deposit_acco",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"long"},
									{"index":12,"type":"string"},
									{"index":13,"type":"string"},
									{"index":14,"type":"string"},
									{"index":15,"type":"string"},
									{"index":16,"type":"long"},
									{"index":17,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"mprd_code",
									"prd_name",
									"oact_name",
									"oact_acct",
									"bank_name",
									"larg_lmt_pay_num",
									"interest_rate",
									"specialremark",
									"inserttime",
									"delete_flag",
									"prd_inr_code",
									"last_update_request",
									"dk_account_type",
									"src_system",
									"updatetime",
									"id",
									"batchno",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["prod_mp_deposit_acco"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table prod_mp_deposit_acco"]
                    }
                }
            }
        ] 
    }
}


