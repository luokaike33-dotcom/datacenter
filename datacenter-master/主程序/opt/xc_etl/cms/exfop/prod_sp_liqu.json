{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/prod_sp_liqu",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"long"},
									{"index":3,"type":"long"},
									{"index":4,"type":"long"},
									{"index":5,"type":"long"},
									{"index":6,"type":"double"},
									{"index":7,"type":"double"},
									{"index":8,"type":"double"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"long"},
									{"index":12,"type":"double"},
									{"index":13,"type":"string"},
									{"index":14,"type":"string"},
									{"index":15,"type":"long"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"string"},
									{"index":19,"type":"string"},
									{"index":20,"type":"string"},
									{"index":21,"type":"string"},
									{"index":22,"type":"string"},
									{"index":23,"type":"long"},
									{"index":24,"type":"string"},
									{"index":25,"type":"string"},
									{"index":26,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"sprd_code",
									"liqu_mode",
									"liqu_data_date",
									"liquidation_date",
									"liqu_enddate",
									"liqu_drmy_date",
									"net_value",
									"liqu_shares",
									"liqu_balance",
									"incl_perf_pay_flag",
									"liqu_code",
									"contract_enddate",
									"perf_pay_total_bal",
									"inserttime",
									"delete_flag",
									"last_update_request",
									"sub_prd_inr_code",
									"src_system",
									"host_acc_id",
									"host_acc_name",
									"check_acc_id",
									"check_acc_name",
									"id",
									"batchno",
									"updatetime",
									"task_rs_id",
									"mprd_code"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["prod_sp_liqu"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table prod_sp_liqu"]
                    }
                }
            }
        ] 
    }
}


