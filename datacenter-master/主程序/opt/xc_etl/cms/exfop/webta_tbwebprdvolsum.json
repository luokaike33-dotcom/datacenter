{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":1}
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
                                    prd_code,
                                    seller_code,
                                    area_id,
                                    tot_vol,
                                    tot_income,
                                    nature_date,
                                    cfm_date,
                                    client_type,
                                    frozen_vol,
                                    partner_code,
                                    tano,
                                    inserttime,
                                    updatetime,
                                    batchno,
                                    srcsys
							FROM ${srcdbname}.webta_tbwebprdvolsum "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"prd_code",
									"seller_code",
									"area_id",
									"tot_vol",
									"tot_income",
									"nature_date",
									"cfm_date",
									"client_type",
									"frozen_vol",
									"partner_code",
									"tano",
									"inserttime",
									"updatetime",
									"batchno",
									"srcsys"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["webta_tbwebprdvolsum"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table webta_tbwebprdvolsum"]
                    }
                }
            }
        ] 
    }
}


