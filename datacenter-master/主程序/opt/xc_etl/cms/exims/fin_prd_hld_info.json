{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
						"hive_cmd":"beeline",
                        "hiveSql":["SELECT prd_code, hld_dt, prd_typ, secu_id, typ_code, typ_codei, typ_codeii, exch_code, chi_name, crse_code, crse_type, crse_dim, inv_typ, cir_id, ast_stat, pos_id, lf_curr_id, curr_code, olcy_curr_code, crse_name, hld_vol, hld_cost, quot_prc, hld_val, olcy_hld_cost, olcy_hld_val, accr_intr, recv_divd, valu_add, intr_adj, ipmt_pvsn, ipmt_pvsn_i, ipmt_pvsn_ii, ipmt_pvsn_iii, pl_adj, oth_equi_chg, excr, is_value_cnfm, secu_quot_dt, iss_typ, acg_proj, busi_date, task_rs_id, dm_created_time, valu_aprc, ipmt_intr, aggr_fixa, dm_src_info, p_dt, sys_rs_id
						FROM ${srcdbname}.fin_prd_hld_info where p_dt between ${beg_date} and ${end_date} 
						"],
                        "defaultFS": "hdfs://${srchdfsurl}",
						"tmpDatabasePath":"${srchivedbpath}",
                        "tmpDatabase":"${srcdbname}",
                        "hive_jdbc_url":"jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name":"${srcusername}",
                        "hive_ldap_password":"${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"prd_code",
									"hld_dt",
									"prd_typ",
									"secu_id",
									"typ_code",
									"typ_codei",
									"typ_codeii",
									"exch_code",
									"chi_name",
									"crse_code",
									"crse_type",
									"crse_dim",
									"inv_typ",
									"cir_id",
									"ast_stat",
									"pos_id",
									"lf_curr_id",
									"curr_code",
									"olcy_curr_code",
									"crse_name",
									"hld_vol",
									"hld_cost",
									"quot_prc",
									"hld_val",
									"olcy_hld_cost",
									"olcy_hld_val",
									"accr_intr",
									"recv_divd",
									"valu_add",
									"intr_adj",
									"ipmt_pvsn",
									"ipmt_pvsn_i",
									"ipmt_pvsn_ii",
									"ipmt_pvsn_iii",
									"pl_adj",
									"oth_equi_chg",
									"excr",
									"is_value_cnfm",
									"secu_quot_dt",
									"iss_typ",
									"acg_proj",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"valu_aprc",
									"ipmt_intr",
									"aggr_fixa",
									"dm_src_info",
									"p_dt",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["fin_prd_hld_info"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from fin_prd_hld_info where (p_dt< to_number(to_char(to_date(to_char(${end_date}),'yyyyMMdd') -365 ,'yyyyMMdd'))) or (p_dt between ${beg_date} and ${end_date} )"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


