{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/oa_hrmdepartment",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"long"},
									{"index":4,"type":"long"},
									{"index":5,"type":"string"},
									{"index":6,"type":"long"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"long"},
									{"index":10,"type":"string"},
									{"index":11,"type":"string"},
									{"index":12,"type":"string"},
									{"index":13,"type":"string"},
									{"index":14,"type":"string"},
									{"index":15,"type":"string"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"string"},
									{"index":19,"type":"long"},
									{"index":20,"type":"string"},
									{"index":21,"type":"long"},
									{"index":22,"type":"date"},
									{"index":23,"type":"long"},
									{"index":24,"type":"date"},
									{"index":25,"type":"long"},
									{"index":26,"type":"string"},
									{"index":27,"type":"date"},
									{"index":28,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"id",
									"departmentmark",
									"departmentname",
									"subcompanyid1",
									"supdepid",
									"allsupdepid",
									"showorder",
									"canceled",
									"departmentcode",
									"coadjutant",
									"zzjgbmfzr",
									"zzjgbmfgld",
									"jzglbmfzr",
									"jzglbmfgld",
									"kingcode",
									"kingname",
									"bmfzr",
									"bmfgld",
									"outkey",
									"budgetatuomoveorder",
									"ecology_pinyin_search",
									"tlevel",
									"created",
									"creater",
									"modified",
									"modifier",
									"bath_dt",
									"data_ins_time",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["oa_hrmdepartment"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table oa_hrmdepartment"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


