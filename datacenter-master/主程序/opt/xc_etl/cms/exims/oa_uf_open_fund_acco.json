                    "parameter": {
                        "path": "${srchivedbpath}/oa_uf_open_fund_acco",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"long"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"long"},
