{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/oa_workflow_requestlog",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"long"},
									{"index":2,"type":"long"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"long"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"long"},
									{"index":10,"type":"long"},
									{"index":11,"type":"string"},
									{"index":12,"type":"long"},
									{"index":13,"type":"long"},
									{"index":14,"type":"string"},
									{"index":15,"type":"long"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"long"},
									{"index":19,"type":"long"},
									{"index":20,"type":"string"},
									{"index":21,"type":"string"},
									{"index":22,"type":"string"},
									{"index":23,"type":"string"},
									{"index":24,"type":"long"},
									{"index":25,"type":"long"},
									{"index":26,"type":"string"},
									{"index":27,"type":"string"},
									{"index":28,"type":"string"},
									{"index":29,"type":"string"},
									{"index":30,"type":"date"},
									{"index":31,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"requestid",
									"workflowid",
									"nodeid",
									"logtype",
									"operatedate",
									"operatetime",
									"operator",
									"remark1",
									"clientip",
									"operatortype",
									"destnodeid",
									"receivedpersons_1",
									"showorder",
									"agentorbyagentid",
									"agenttype",
									"logid",
									"remark",
									"annexdocids",
									"requestlogid",
									"operatordept",
									"signdocids",
									"signworkflowids",
									"receivedpersons",
									"ismobile",
									"handwrittensign",
									"speechattachment",
									"receivedpersonids",
									"remarklocation",
									"issubmitdirect",
									"bath_dt",
									"data_ins_time",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["oa_workflow_requestlog"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table oa_workflow_requestlog"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


