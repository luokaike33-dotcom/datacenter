{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/prod_mp_seat_info",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"string"},
									{"index":6,"type":"string"},
									{"index":7,"type":"string"},
									{"index":8,"type":"long"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"long"},
									{"index":12,"type":"string"},
									{"index":13,"type":"string"},
									{"index":14,"type":"string"},
									{"index":15,"type":"string"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"long"},
									{"index":19,"type":"string"},
									{"index":20,"type":"long"},
									{"index":21,"type":"string"},
									{"index":22,"type":"string"},
									{"index":23,"type":"string"},
									{"index":24,"type":"long"},
									{"index":25,"type":"long"},
									{"index":26,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"seat_code",
									"main_seat_no",
									"main_seat_flag",
									"trd_unit_type",
									"dk_mkt_type",
									"agency_no",
									"inserttime",
									"delete_flag",
									"last_update_request",
									"seat_status",
									"sct_settle_flag",
									"cancel_date",
									"updatetime",
									"seat_class",
									"is_first_agency",
									"is_new",
									"trade_unit_name",
									"is_use_hkstk_pool",
									"hkstk_open_date",
									"is_open_refin",
									"open_refin_date",
									"attachment_file",
									"src_system",
									"id",
									"open_date",
									"batchno",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["prod_mp_seat_info"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table prod_mp_seat_info"]
                    }
                }
            }
        ] 
    }
}


