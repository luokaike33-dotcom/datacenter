{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/prod_sp_bons",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"double"},
									{"index":2,"type":"double"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"long"},
									{"index":6,"type":"long"},
									{"index":7,"type":"long"},
									{"index":8,"type":"long"},
									{"index":9,"type":"long"},
									{"index":10,"type":"double"},
									{"index":11,"type":"double"},
									{"index":12,"type":"double"},
									{"index":13,"type":"string"},
									{"index":14,"type":"string"},
									{"index":15,"type":"long"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"string"},
									{"index":19,"type":"string"},
									{"index":20,"type":"string"},
									{"index":21,"type":"string"},
									{"index":22,"type":"string"},
									{"index":23,"type":"long"},
									{"index":24,"type":"string"},
									{"index":25,"type":"string"},
									{"index":26,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"sprd_code",
									"per_10_un_divid",
									"income_tax_rate",
									"divid_type_code",
									"divid_type",
									"divid_basi_date",
									"divid_equi_reg_date",
									"divid_xd_date",
									"divid_gant_date",
									"divid_reinvest_date",
									"split_covt_ratio",
									"divid_shares",
									"divid_bal",
									"inserttime",
									"delete_flag",
									"last_update_request",
									"sub_prd_inr_code",
									"src_system",
									"host_acc_id",
									"host_acc_name",
									"check_acc_id",
									"check_acc_name",
									"id",
									"batchno",
									"updatetime",
									"task_rs_id",
									"mprd_code"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["prod_sp_bons"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table prod_sp_bons"]
                    }
                }
            }
        ] 
    }
}


