{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/prod_sp_tail",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"long"},
									{"index":5,"type":"long"},
									{"index":6,"type":"long"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"double"},
									{"index":10,"type":"double"},
									{"index":11,"type":"double"},
									{"index":12,"type":"string"},
									{"index":13,"type":"long"},
									{"index":14,"type":"long"},
									{"index":15,"type":"string"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"string"},
									{"index":19,"type":"string"},
									{"index":20,"type":"long"},
									{"index":21,"type":"string"},
									{"index":22,"type":"string"},
									{"index":23,"type":"string"},
									{"index":24,"type":"long"},
									{"index":25,"type":"string"},
									{"index":26,"type":"string"},
									{"index":27,"type":"string"},
									{"index":28,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"sprd_code",
									"agency_no",
									"bach_code",
									"custgrp_desc",
									"start_date",
									"end_date",
									"ta_start_date",
									"dk_cust_type",
									"bilg_type",
									"trail_feer",
									"feer_min_val",
									"feer_max_val",
									"feer_val_type",
									"yr_days",
									"pay_freq",
									"prgrs_cal_flag",
									"hold_cal_mode",
									"id",
									"inserttime",
									"updatetime",
									"last_update_request",
									"delete_flag",
									"sub_prd_inr_code",
									"src_system",
									"batchno",
									"datacenter_inserttime",
									"datacenter_updatetime",
									"task_rs_id",
									"mprd_code"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["prod_sp_tail"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table prod_sp_tail"]
                    }
                }
            }
        ] 
    }
}


