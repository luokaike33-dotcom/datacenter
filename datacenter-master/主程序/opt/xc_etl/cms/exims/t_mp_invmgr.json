{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/t_mp_invmgr",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"string"},
									{"index":2,"type":"long"},
									{"index":3,"type":"string"},
									{"index":4,"type":"long"},
									{"index":5,"type":"long"},
									{"index":6,"type":"long"},
									{"index":7,"type":"long"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"long"},
									{"index":11,"type":"string"},
									{"index":12,"type":"long"},
									{"index":13,"type":"string"},
									{"index":14,"type":"string"},
									{"index":15,"type":"string"},
									{"index":16,"type":"string"},
									{"index":17,"type":"string"},
									{"index":18,"type":"string"},
									{"index":19,"type":"long"},
									{"index":20,"type":"long"},
									{"index":21,"type":"long"},
									{"index":22,"type":"string"},
									{"index":23,"type":"string"},
									{"value":"","type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"invmgr_code",
									"invmgr_name",
									"id_type",
									"id_no",
									"aoff_date",
									"aoff_status",
									"leav_date",
									"anno_date",
									"brtd",
									"cert_no",
									"gender",
									"edu",
									"nati",
									"bont",
									"duty",
									"intr",
									"dept",
									"awd_rec",
									"memo",
									"secu_qlfy_start_date",
									"secu_ivsm_start_date",
									"busi_date",
									"task_rs_id",
									"dm_created_time",
									"sys_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["t_mp_invmgr"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table t_mp_invmgr"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


