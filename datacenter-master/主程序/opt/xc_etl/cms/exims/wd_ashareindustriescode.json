{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/w_ashareindustriescode",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"long"},
									{"index":4,"type":"long"},
									{"index":5,"type":"string"},
									{"index":6,"type":"long"},
									{"index":7,"type":"string"},
									{"index":8,"type":"string"},
									{"index":9,"type":"string"},
									{"index":10,"type":"string"},
									{"index":11,"type":"string"},
									{"index":12,"type":"date"},
									{"index":13,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"industriescode",
									"industriesname",
									"levelnum",
									"used",
									"industriesalias",
									"sequence",
									"memo",
									"chinesedefinition",
									"wind_name_eng",
									"industriescode_old",
									"region_code",
									"opdate",
									"opmode"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_ashareindustriescode"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table wd_ashareindustriescode"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


