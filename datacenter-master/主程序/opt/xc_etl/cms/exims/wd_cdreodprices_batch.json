{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd":"beeline",
                        "hiveSql":["SELECT object_id, s_info_windcode, 
                        trade_dt, crncy_code, s_dq_preclose, s_dq_open,
                         s_dq_high, s_dq_low,s_dq_close, s_dq_volume,
                          s_dq_amount, opdate, opmode, bath_dt, data_ins_time, 
                          task_rs_id, busi_month from ${srcdbname}.w_cdreodprices where busi_month=${busi_month} "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath":"${srchivedbpath}",
                        "tmpDatabase":"${srcdbname}",
                        "hive_jdbc_url":"jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name":"${srcusername}",
                        "hive_ldap_password":"${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"object_id",
									"s_info_windcode",
									"trade_dt",
									"crncy_code",
									"s_dq_preclose",
									"s_dq_open",
									"s_dq_high",
									"s_dq_low",
									"s_dq_close",
									"s_dq_volume",
									"s_dq_amount",
									"opdate",
									"opmode",
									"bath_dt",
									"data_ins_time",
									"task_rs_id",
                                    "busi_month"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["wd_cdreodprices"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from wd_cdreodprices where busi_month=${busi_month} "]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


