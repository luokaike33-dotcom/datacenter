{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/xnnp_inr_industryassign",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"long"},
									{"index":1,"type":"long"},
									{"index":2,"type":"long"},
									{"index":3,"type":"string"},
									{"index":4,"type":"date"},
									{"index":5,"type":"long"},
									{"index":6,"type":"long"},
									{"index":7,"type":"long"},
									{"index":8,"type":"date"},
									{"index":9,"type":"long"},
									{"index":10,"type":"date"},
									{"index":11,"type":"date"},
									{"index":12,"type":"long"},
									{"index":13,"type":"string"},
									{"index":14,"type":"string"},
									{"index":15,"type":"date"},
									{"index":16,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"objid",
									"empid",
									"indmode",
									"indcode",
									"assigntime",
									"assignempid",
									"status",
									"assignstatus",
									"endtime",
									"lastflag",
									"createtimestamp",
									"updatetimestamp",
									"version",
									"entityname",
									"bath_dt",
									"data_ins_time",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["xn_inr_industryassign"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table xn_inr_industryassign"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


