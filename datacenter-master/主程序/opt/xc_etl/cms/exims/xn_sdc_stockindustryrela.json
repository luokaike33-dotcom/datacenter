{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            }
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/xnnp_sdc_stockindustryrela",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"double"},
									{"index":3,"type":"double"},
									{"index":4,"type":"string"},
									{"index":5,"type":"double"},
									{"index":6,"type":"date"},
									{"index":7,"type":"double"},
									{"index":8,"type":"double"},
									{"index":9,"type":"date"},
									{"index":10,"type":"string"},
									{"index":11,"type":"string"},
									{"index":12,"type":"date"},
									{"index":13,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"guid",
									"scode",
									"mktcode",
									"stype",
									"industrycode",
									"relationtype",
									"updatetime",
									"syntimestamp",
									"synbehavior",
									"createtime",
									"flag",
									"bath_dt",
									"data_ins_time",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["xn_sdc_stockindustryrela"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from xn_sdc_stockindustryrela"]
                    }
                }
            }
        ], 
        "setting": {
            "speed": {
                "channel": "1"
            },
            "errorLimit": {"record":1}
        }
    }
}


