{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "${srchivedbpath}/custdb_dataset_tpc_assetmanage",
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "column": [
									{"index":0,"type":"string"},
									{"index":1,"type":"string"},
									{"index":2,"type":"string"},
									{"index":3,"type":"string"},
									{"index":4,"type":"string"},
									{"index":5,"type":"double"},
									{"index":6,"type":"double"},
									{"index":7,"type":"string"},
									{"index":8,"type":"double"},
									{"index":9,"type":"double"},
									{"index":10,"type":"double"},
									{"index":11,"type":"double"},
									{"index":12,"type":"double"},
									{"index":13,"type":"double"},
									{"index":14,"type":"double"},
									{"index":15,"type":"double"},
									{"index":16,"type":"long"},
									{"index":17,"type":"string"},
									{"index":18,"type":"string"},
									{"index":19,"type":"string"}
								   ],
                        "fileType": "orc",
                        "encoding": "UTF-8",
                        "fieldDelimiter": "\t",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"sjrq",
									"ywrq",
									"gsmc",
									"cpdm",
									"cpmc",
									"cpdwjz",
									"cpzfe",
									"zjmjfs",
									"cyfe_xyzq",
									"cyfe_xzjj",
									"cyfe_xzqh",
									"cyfe_xzzg",
									"cyfe_xzzb",
									"cyfe_xztz",
									"cyfe_xzxg",
									"zyzjcc",
									"batchno",
									"inserttime",
									"updatetime",
									"task_rs_id"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["tpc_assetmanage"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["truncate table tpc_assetmanage"]
                    }
                }
            }
        ] 
    }
}


