{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":0}
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									prd_code,
									sjrq,
									xh,
									cpbm,
									cpmc,
									glr,
									glrlx,
									cplx,
									cpbatgrq,
									cpdqrq,
									qmzcjz,
									glfl,
									cpgzpl,
									tzzgcpsmjjzgm,
									xjlzctzgm,
									qtzcgm,
									txbtcpgm,
									btcplx,
									btcpmc,
									btcpbm,
									btcptzcl,
									btcpqmzcjzgm,
									btcpqmdwjz,
									txbtcpsj,
									btcpsyl,
									btcpglfl,
									btcpglrmc,
									txbtcpglrgm,
									cpsfsjwfdfdfx,
									bz,
									updatetime,
									data_uuid,
									p_dt
							FROM ${srcdbname}.amac_aq_fofprd_run_situ where p_dt between ${beg_date} and ${end_date} "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"prd_code",
									"sjrq",
									"xh",
									"cpbm",
									"cpmc",
									"glr",
									"glrlx",
									"cplx",
									"cpbatgrq",
									"cpdqrq",
									"qmzcjz",
									"glfl",
									"cpgzpl",
									"tzzgcpsmjjzgm",
									"xjlzctzgm",
									"qtzcgm",
									"txbtcpgm",
									"btcplx",
									"btcpmc",
									"btcpbm",
									"btcptzcl",
									"btcpqmzcjzgm",
									"btcpqmdwjz",
									"txbtcpsj",
									"btcpsyl",
									"btcpglfl",
									"btcpglrmc",
									"txbtcpglrgm",
									"cpsfsjwfdfdfx",
									"bz",
									"updatetime",
									"data_uuid",
									"p_dt"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["amac_aq_fofprd_run_situ"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from amac_aq_fofprd_run_situ where p_dt between ${beg_date} and ${end_date}"]
                    }
                }
            }
        ] 
    }
}


