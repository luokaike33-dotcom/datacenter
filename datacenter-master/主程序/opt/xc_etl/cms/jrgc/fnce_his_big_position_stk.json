{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":1}
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									sk_date,
									prd_code,
									std_secu_code,
									secu_sht,
									wind_std_secu_code,
									issue_orgno_id,
									posi_sum,
									posi_sum_rank,
									high_posi,
									curr_posi,
									sw_ind_level1,
									sw_ind_level2,
									citics_ind_level,
									hs_ind,
									ind_type,
									ind_type_2,
									p_dt
							FROM ${srcdbname}.fnce_his_big_position_stk where p_dt between ${beg_date} and ${end_date} "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"sk_date",
									"prd_code",
									"std_secu_code",
									"secu_sht",
									"wind_std_secu_code",
									"issue_orgno_id",
									"posi_sum",
									"posi_sum_rank",
									"high_posi",
									"curr_posi",
									"sw_ind_level1",
									"sw_ind_level2",
									"citics_ind_level",
									"hs_ind",
									"ind_type",
									"ind_type_2",
									"p_dt"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["fnce_his_big_position_stk"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from fnce_his_big_position_stk where p_dt between ${beg_date} and ${end_date}"]
                    }
                }
            }
        ] 
    }
}


