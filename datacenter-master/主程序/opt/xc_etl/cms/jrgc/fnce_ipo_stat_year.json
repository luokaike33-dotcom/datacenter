{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":1}
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									start_date,
									end_date,
									prd_code,
									prd_name,
									secu_id,
									s_info_windcode,
									issue_short_name,
									buy_date,
									full_sell_date,
									added_value,
									trade_added_value,
									holding_added_value,
									p_dt
							FROM ${srcdbname}.fnce_ipo_stat_year where p_dt between ${beg_date} and ${end_date} "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"start_date",
									"end_date",
									"prd_code",
									"prd_name",
									"secu_id",
									"s_info_windcode",
									"issue_short_name",
									"buy_date",
									"full_sell_date",
									"added_value",
									"trade_added_value",
									"holding_added_value",
									"p_dt"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["fnce_ipo_stat_year"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from fnce_ipo_stat_year where p_dt between ${beg_date} and ${end_date}"]
                    }
                }
            }
        ] 
    }
}


