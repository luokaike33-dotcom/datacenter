{
    "job": {
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {"record":1}
        },
        "content": [
            {
                "reader": {
                    "name": "hivereader",
                    "parameter": {
                        "hive_cmd": "beeline",
                        "hiveSql": ["
							SELECT
									secu_id,
									wind_secu_id,
									sk_date,
									com_id,
									cls_prc,
									r1y_divid,
									pd_1y,
									p_dt
							FROM ${srcdbname}.fnce_pd_1y where p_dt between ${beg_date} and ${end_date} "],
                        "defaultFS": "hdfs://${srchdfsurl}",
                        "tmpDatabasePath": "${srchivedbpath}",
                        "tmpDatabase": "${srcdbname}",
                        "hive_jdbc_url": "jdbc:hive2://${srcjdbcurl}/${srcdbname}",
                        "hive_ldap_user_name": "${srcusername}",
                        "hive_ldap_password": "${srcpassword}",
                        "haveKerberos": "${haveKerberos}",
                        "kerberosKeytabFilePath": "${kbsfilepath}",
                        "kerberosPrincipal": "${kbsprincipal}"
                    }
                },
                "writer": {
                    "name": "oraclewriter",
                    "parameter": {
                        "column": [
									"secu_id",
									"wind_secu_id",
									"sk_date",
									"com_id",
									"cls_prc",
									"r1y_divid",
									"pd_1y",
									"p_dt"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:oracle:thin:@${tgrurl}",
                                "table": ["fnce_pd_1y"]
                                    }
                        ], 
                        "password": "${tgrpassword}", 
                        "username": "${tgrusername}", 
                        "preSql":["delete from fnce_pd_1y where p_dt between ${beg_date} and ${end_date}"]
                    }
                }
            }
        ] 
    }
}


